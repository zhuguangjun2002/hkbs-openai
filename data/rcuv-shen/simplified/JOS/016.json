{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "JOS",
  "book_name": "约书亚记",
  "chapter": 16,
  "heading": "分给约瑟子孙的土地",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/JOS/16/",
  "verses": [
    {
      "verse": 1,
      "text": "约瑟的子孙抽签所得之地是从靠近耶利哥的约旦河起，以耶利哥东边的河水为边界，经过旷野，从耶利哥上去，直到伯特利的山区；",
      "notes": []
    },
    {
      "verse": 2,
      "text": "从伯特利又到路斯，经过亚基人的边界，直到亚大录；",
      "notes": []
    },
    {
      "verse": 3,
      "text": "又往西，下到押利提人的边界，到下伯．和仑的边界，到基色，直通到海为止。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "约瑟的儿子玛拿西、以法莲得了地业。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "以法莲子孙的地界，按着宗族所得的如下：他们地业的东界，是从亚大录．亚达到上伯．和仑，",
      "notes": []
    },
    {
      "verse": 6,
      "text": "这地界直通到海。在北边，这地界是从密米他，向东绕到他纳．示罗，又经过雅挪哈的东边，",
      "notes": []
    },
    {
      "verse": 7,
      "text": "从雅挪哈下到亚大录和拿拉，再到耶利哥，直到约旦河为止。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "这地界又从他普亚，顺着加拿河往西延伸，直通到海为止。这就是以法莲支派按着宗族所得的地业。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "在玛拿西人地业的一切城镇和所属的村庄中，也保留一些城镇给以法莲的子孙。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "他们却没有赶出住在基色的迦南人。迦南人就住在以法莲人中，成为服劳役的仆人，直到今日。",
      "notes": []
    }
  ]
}
