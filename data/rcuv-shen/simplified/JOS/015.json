{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "JOS",
  "book_name": "约书亚记",
  "chapter": 15,
  "heading": "分给犹大的土地",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/JOS/15/",
  "verses": [
    {
      "verse": 1,
      "text": "犹大支派按着宗族抽签所得之地是在最南端，到以东的边界，往南直到寻的旷野。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "他们南边的地界是从盐海的顶端，就是朝南的海湾开始，",
      "notes": []
    },
    {
      "verse": 3,
      "text": "通到亚克拉滨斜坡的南边，经过寻，上到加低斯．巴尼亚的南边，又经过希斯仑，上到亚达珥，转到甲加，",
      "notes": []
    },
    {
      "verse": 4,
      "text": "再经过押们，顺着埃及溪谷，这地界直通到海为止。这就是你们南边的地界。",
      "notes": [
        "“你们”：七十士译本是“他们”。"
      ]
    },
    {
      "verse": 5,
      "text": "东边的地界是从盐海到约旦河口。北边的地界是从约旦河口的海湾开始，",
      "notes": []
    },
    {
      "verse": 6,
      "text": "这地界上到伯．曷拉，经过伯．亚拉巴的北边，这地界上到吕便之子波罕的磐石。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "这地界是从亚割谷往北上到底璧，直向亚都冥斜坡对面的吉甲，就是河的南边，这地界再经过隐．示麦泉，直通到隐．罗结。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "这地界又上到欣嫩子谷，耶布斯斜坡的南方，耶布斯就是耶路撒冷，这地界又上到欣嫩谷西边对面的山顶，就是在利乏音谷的最北端。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "这地界又从山顶延伸到尼弗多亚水泉，通到以弗仑山的城镇，这地界又延伸到巴拉，巴拉就是基列．耶琳。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "这地界又从巴拉往西绕到西珥山，经过耶琳山斜坡的北边，耶琳就是基撒仑，从那里又下到伯．示麦，经过亭拿，",
      "notes": []
    },
    {
      "verse": 11,
      "text": "这地界通到以革伦斜坡的北边。这地界又延伸到施基仑，经过巴拉山到雅比聂，这地界直通到海为止。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "西边的地界就是大海和沿海一带之地。这是犹大人按着宗族所得之地四围的边界。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "约书亚照耶和华所指示的，把犹大人中的一份土地，就是基列．亚巴，分给耶孚尼的儿子迦勒。亚巴是亚衲族的祖先，基列．亚巴就是希伯仑。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "迦勒从那里赶出亚衲的三族，就是亚衲族的示筛人、亚希幔人和挞买人。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "他又从那里上去，攻击底璧的居民，这底璧从前名叫基列．西弗。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "迦勒说：“谁能攻打基列．西弗，夺取那城，我就把我女儿押撒嫁给他。”",
      "notes": []
    },
    {
      "verse": 17,
      "text": "迦勒兄弟基纳斯的儿子俄陀聂夺取了那城，迦勒就把女儿押撒嫁给他。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "押撒来的时候，催促丈夫向她父亲要一块田。押撒一下驴，迦勒就对她说：“你要什么？”",
      "notes": []
    },
    {
      "verse": 19,
      "text": "她说：“求你给我福分；你既然把我安置在尼革夫地，求你也给我水泉。”她父亲就把上泉和下泉都赐给她。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "这是犹大支派按着宗族所得的产业。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "犹大支派最南端，靠近以东边界的城镇，是甲薛、以得、雅姑珥、",
      "notes": []
    },
    {
      "verse": 22,
      "text": "基拿、底摩拿、亚大达、",
      "notes": []
    },
    {
      "verse": 23,
      "text": "基低斯、夏琐、以提楠、",
      "notes": []
    },
    {
      "verse": 24,
      "text": "西弗、提鍊、比亚绿、",
      "notes": []
    },
    {
      "verse": 25,
      "text": "夏琐．哈大他、加略．希斯仑，加略．希斯仑就是夏琐，",
      "notes": []
    },
    {
      "verse": 26,
      "text": "亚曼、示玛、摩拉大、",
      "notes": []
    },
    {
      "verse": 27,
      "text": "哈萨．迦大、黑实门、伯．帕列、",
      "notes": []
    },
    {
      "verse": 28,
      "text": "哈萨．书亚、别是巴、比斯约他、",
      "notes": []
    },
    {
      "verse": 29,
      "text": "巴拉、以因、以森、",
      "notes": []
    },
    {
      "verse": 30,
      "text": "伊勒多腊、基失、何珥玛、",
      "notes": []
    },
    {
      "verse": 31,
      "text": "洗革拉、麦玛拿、三撒拿、",
      "notes": []
    },
    {
      "verse": 32,
      "text": "利巴勿、实忻、亚因、临门，共二十九座城，还有所属的村庄。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "在低地有以实陶、琐拉、亚实拿、",
      "notes": []
    },
    {
      "verse": 34,
      "text": "撒挪亚、隐．干宁、他普亚、以楠、",
      "notes": []
    },
    {
      "verse": 35,
      "text": "耶末、亚杜兰、梭哥、亚西加、",
      "notes": []
    },
    {
      "verse": 36,
      "text": "沙拉音、亚底他音、基底拉、基底罗他音，共十四座城，还有所属的村庄。",
      "notes": []
    },
    {
      "verse": 37,
      "text": "又有洗楠、哈大沙、麦大．迦得、",
      "notes": []
    },
    {
      "verse": 38,
      "text": "底连、米斯巴、约帖、",
      "notes": []
    },
    {
      "verse": 39,
      "text": "拉吉、波斯加、伊矶伦、",
      "notes": []
    },
    {
      "verse": 40,
      "text": "迦本、拉幔、基提利、",
      "notes": []
    },
    {
      "verse": 41,
      "text": "基低罗、伯．大衮、拿玛、玛基大，共十六座城，还有所属的村庄。",
      "notes": []
    },
    {
      "verse": 42,
      "text": "又有立拿、以帖、亚珊、",
      "notes": []
    },
    {
      "verse": 43,
      "text": "益弗他、亚实拿、尼悉、",
      "notes": []
    },
    {
      "verse": 44,
      "text": "基伊拉、亚革悉、玛利沙，共九座城，还有所属的村庄。",
      "notes": []
    },
    {
      "verse": 45,
      "text": "又有以革伦和所属的乡镇与村庄，",
      "notes": [
        "“乡镇”：原文直译“女子们”；本卷书下同。"
      ]
    },
    {
      "verse": 46,
      "text": "从以革伦直到海，一切靠近亚实突之地，以及所属的村庄、",
      "notes": []
    },
    {
      "verse": 47,
      "text": "亚实突和所属的乡镇与村庄，迦萨和所属的乡镇与村庄，到埃及溪谷，直到大海以及沿海一带之地。",
      "notes": []
    },
    {
      "verse": 48,
      "text": "在山区有沙密、雅提珥、梭哥、",
      "notes": []
    },
    {
      "verse": 49,
      "text": "大拿、基列．萨拿，基列．萨拿就是底璧，",
      "notes": []
    },
    {
      "verse": 50,
      "text": "亚拿伯、以实提莫、亚念、",
      "notes": []
    },
    {
      "verse": 51,
      "text": "歌珊、何仑、基罗，共十一座城，还有所属的村庄。",
      "notes": []
    },
    {
      "verse": 52,
      "text": "又有亚拉、度玛、以珊、",
      "notes": []
    },
    {
      "verse": 53,
      "text": "雅农、伯．他普亚、亚非加、",
      "notes": []
    },
    {
      "verse": 54,
      "text": "宏他、基列．亚巴，基列．亚巴就是希伯仑，洗珥，共九座城，还有所属的村庄。",
      "notes": []
    },
    {
      "verse": 55,
      "text": "又有玛云、迦密、西弗、淤他、",
      "notes": []
    },
    {
      "verse": 56,
      "text": "耶斯列、约甸、撒挪亚、",
      "notes": []
    },
    {
      "verse": 57,
      "text": "该隐、基比亚、亭拿，共十座城，还有所属的村庄。",
      "notes": []
    },
    {
      "verse": 58,
      "text": "又有哈忽、伯．夙、基突、",
      "notes": []
    },
    {
      "verse": 59,
      "text": "玛腊、伯．亚诺、伊勒提君，共六座城，还有所属的村庄。",
      "notes": []
    },
    {
      "verse": 60,
      "text": "又有基列．巴力，基列．巴力就是基列．耶琳，拉巴，共两座城，还有所属的村庄。",
      "notes": []
    },
    {
      "verse": 61,
      "text": "在旷野有伯．亚拉巴、密丁、西迦迦、",
      "notes": []
    },
    {
      "verse": 62,
      "text": "匿珊、盐城、隐．基底，共六座城，还有所属的村庄。",
      "notes": []
    },
    {
      "verse": 63,
      "text": "至于住耶路撒冷的耶布斯人，犹大人不能把他们赶出去。于是，耶布斯人与犹大人同住在耶路撒冷，直到今日。",
      "notes": []
    }
  ]
}
