{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "1CH",
  "book_name": "历代志上",
  "chapter": 6,
  "heading": "利未的后裔",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/1CH/6/",
  "verses": [
    {
      "verse": 1,
      "text": "利未的后裔：革顺、哥辖和米拉利。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "哥辖的儿子是暗兰、以斯哈、希伯伦和乌薛。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "暗兰的儿女是亚伦、摩西和米利暗。亚伦的儿子是拿答、亚比户、以利亚撒和以他玛。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "以利亚撒生非尼哈；非尼哈生亚比书；",
      "notes": []
    },
    {
      "verse": 5,
      "text": "亚比书生布基；布基生乌西；",
      "notes": []
    },
    {
      "verse": 6,
      "text": "乌西生西拉希雅；西拉希雅生米拉约；",
      "notes": []
    },
    {
      "verse": 7,
      "text": "米拉约生亚玛利雅；亚玛利雅生亚希突；",
      "notes": []
    },
    {
      "verse": 8,
      "text": "亚希突生撒督；撒督生亚希玛斯；",
      "notes": []
    },
    {
      "verse": 9,
      "text": "亚希玛斯生亚撒利雅；亚撒利雅生约哈难；",
      "notes": []
    },
    {
      "verse": 10,
      "text": "约哈难生亚撒利雅，亚撒利雅在所罗门建造的耶路撒冷殿中担任祭司的职分；",
      "notes": []
    },
    {
      "verse": 11,
      "text": "亚撒利雅生亚玛利雅；亚玛利雅生亚希突；",
      "notes": []
    },
    {
      "verse": 12,
      "text": "亚希突生撒督；撒督生沙龙；",
      "notes": []
    },
    {
      "verse": 13,
      "text": "沙龙生希勒家；希勒家生亚撒利雅；",
      "notes": []
    },
    {
      "verse": 14,
      "text": "亚撒利雅生西莱雅；西莱雅生约萨答。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "当耶和华藉尼布甲尼撒的手掳掠犹大和耶路撒冷的时候，约萨答也被掳去。",
      "notes": []
    },
    {
      "verse": 16,
      "section_headings": [
        "利未其余的后裔"
      ],
      "text": "利未的后裔：革顺、哥辖和米拉利。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "革顺的儿子名叫立尼和示每。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "哥辖的儿子是暗兰、以斯哈、希伯伦和乌薛。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "米拉利的儿子是抹利和母示。这是按着父系所分利未人的宗族。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "属革顺的：他的儿子立尼，他的儿子雅哈，他的儿子薪玛，",
      "notes": []
    },
    {
      "verse": 21,
      "text": "他的儿子约亚，他的儿子易多，他的儿子谢拉，他的儿子耶特赖。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "哥辖的后裔：他的儿子亚米拿达，他的儿子可拉，他的儿子亚惜，",
      "notes": []
    },
    {
      "verse": 23,
      "text": "他的儿子以利加拿，他的儿子以比雅撒，他的儿子亚惜，",
      "notes": []
    },
    {
      "verse": 24,
      "text": "他的儿子他哈，他的儿子乌列，他的儿子乌西雅，他的儿子少罗。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "以利加拿的儿子是亚玛赛、亚希摩、",
      "notes": []
    },
    {
      "verse": 26,
      "text": "以利加拿。以利加拿的后裔：他的儿子琐菲，他的儿子拿哈，",
      "notes": [
        "“以利加拿。以利加拿的后裔：他的儿子琐菲”：七十士译本是“他的儿子以利加拿，他的儿子琐菲”。"
      ]
    },
    {
      "verse": 27,
      "text": "他的儿子以利押，他的儿子耶罗罕，他的儿子以利加拿，他的儿子撒母耳。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "撒母耳的儿子是长子约珥和次子亚比亚。",
      "notes": [
        "“长子约珥和次子亚比亚”是根据七十士译本和其他古译本，原文是“长子瓦希尼和亚比亚”；参本章33节，撒上8．2。"
      ]
    },
    {
      "verse": 29,
      "text": "米拉利的后裔：抹利，他的儿子立尼，他的儿子示每，他的儿子乌撒，",
      "notes": []
    },
    {
      "verse": 30,
      "text": "他的儿子示米亚，他的儿子哈基雅，他的儿子亚帅雅。",
      "notes": []
    },
    {
      "verse": 31,
      "section_headings": [
        "圣殿中的歌唱者"
      ],
      "text": "这些是约柜安设之后，大卫派在耶和华殿中管理歌唱事奉的人。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "他们在会幕前负责歌唱的事奉，及至所罗门在耶路撒冷建造了耶和华的殿，他们就按着班次供职。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "供职的人和他们的子孙如下：哥辖的子孙中有歌唱的希幔；希幔是约珥的儿子，约珥是撒母耳的儿子，",
      "notes": []
    },
    {
      "verse": 34,
      "text": "撒母耳是以利加拿的儿子，以利加拿是耶罗罕的儿子，耶罗罕是以利业的儿子，以利业是陀亚的儿子，",
      "notes": []
    },
    {
      "verse": 35,
      "text": "陀亚是苏弗的儿子，苏弗是以利加拿的儿子，以利加拿是玛哈的儿子，玛哈是亚玛赛的儿子，",
      "notes": []
    },
    {
      "verse": 36,
      "text": "亚玛赛是以利加拿的儿子，以利加拿是约珥的儿子，约珥是亚撒利雅的儿子，亚撒利雅是西番雅的儿子，",
      "notes": []
    },
    {
      "verse": 37,
      "text": "西番雅是他哈的儿子，他哈是亚惜的儿子，亚惜是以比雅撒的儿子，以比雅撒是可拉的儿子，",
      "notes": []
    },
    {
      "verse": 38,
      "text": "可拉是以斯哈的儿子，以斯哈是哥辖的儿子，哥辖是利未的儿子，利未是以色列的儿子。",
      "notes": []
    },
    {
      "verse": 39,
      "text": "希幔的弟兄亚萨在希幔的右边供职；亚萨是比利家的儿子，比利家是示米亚的儿子，",
      "notes": []
    },
    {
      "verse": 40,
      "text": "示米亚是米迦勒的儿子，米迦勒是巴西雅的儿子，巴西雅是玛基雅的儿子，",
      "notes": []
    },
    {
      "verse": 41,
      "text": "玛基雅是伊特尼的儿子，伊特尼是谢拉的儿子，谢拉是亚大雅的儿子，",
      "notes": []
    },
    {
      "verse": 42,
      "text": "亚大雅是以探的儿子，以探是薪玛的儿子，薪玛是示每的儿子，",
      "notes": []
    },
    {
      "verse": 43,
      "text": "示每是雅哈的儿子，雅哈是革顺的儿子，革顺是利未的儿子。",
      "notes": []
    },
    {
      "verse": 44,
      "text": "他们的弟兄米拉利的子孙，在他们左边供职的有以探；以探是基示的儿子，基示是亚伯底的儿子，亚伯底是玛鹿的儿子，",
      "notes": []
    },
    {
      "verse": 45,
      "text": "玛鹿是哈沙比雅的儿子，哈沙比雅是亚玛谢的儿子，亚玛谢是希勒家的儿子，",
      "notes": []
    },
    {
      "verse": 46,
      "text": "希勒家是暗西的儿子，暗西是巴尼的儿子，巴尼是沙麦的儿子，",
      "notes": []
    },
    {
      "verse": 47,
      "text": "沙麦是末力的儿子，末力是母示的儿子，母示是米拉利的儿子，米拉利是利未的儿子。",
      "notes": []
    },
    {
      "verse": 48,
      "text": "他们的弟兄利未人也被派办理神殿中帐幕的一切事务。",
      "notes": []
    },
    {
      "verse": 49,
      "section_headings": [
        "亚伦的后裔"
      ],
      "text": "亚伦和他的子孙在燔祭坛和香坛上献祭烧香，办理至圣所一切的事，为以色列赎罪，正如神仆人摩西所吩咐的一切。",
      "notes": []
    },
    {
      "verse": 50,
      "text": "亚伦的后裔如下：他的儿子以利亚撒，他的儿子非尼哈，他的儿子亚比书，",
      "notes": []
    },
    {
      "verse": 51,
      "text": "他的儿子布基，他的儿子乌西，他的儿子西拉希雅，",
      "notes": []
    },
    {
      "verse": 52,
      "text": "他的儿子米拉约，他的儿子亚玛利雅，他的儿子亚希突，",
      "notes": []
    },
    {
      "verse": 53,
      "text": "他的儿子撒督，他的儿子亚希玛斯。",
      "notes": []
    },
    {
      "verse": 54,
      "section_headings": [
        "利未支派居住地"
      ],
      "text": "他们的住处按着境内的营寨如下：亚伦的子孙哥辖族先抽签得地，",
      "notes": []
    },
    {
      "verse": 55,
      "text": "得了犹大地的希伯仑和四围的郊野；",
      "notes": []
    },
    {
      "verse": 56,
      "text": "只是这城的田地和所属的村庄都为耶孚尼的儿子迦勒所得。",
      "notes": []
    },
    {
      "verse": 57,
      "text": "亚伦的子孙所得逃城如下：希伯仑、立拿与其郊野、雅提珥、以实提莫与其郊野、",
      "notes": []
    },
    {
      "verse": 58,
      "text": "希仑与其郊野、底璧与其郊野、",
      "notes": [
        "“希仑”是根据七十士译本，原文是“希列兹”，原文另译“何仑”；参书21．15。"
      ]
    },
    {
      "verse": 59,
      "text": "亚珊与其郊野、伯．示麦与其郊野。",
      "notes": []
    },
    {
      "verse": 60,
      "text": "他们也从便雅悯支派中得了迦巴与其郊野、阿勒篾与其郊野、亚拿突与其郊野。他们宗族所得的城共十三座。",
      "notes": []
    },
    {
      "verse": 61,
      "text": "哥辖族其余的人抽签，按支派的宗族，从半个支派，就是玛拿西半支派中得了十座城。",
      "notes": []
    },
    {
      "verse": 62,
      "text": "革顺族按着宗族，从以萨迦支派、亚设支派、拿弗他利支派、巴珊内的玛拿西支派中，得了十三座城。",
      "notes": []
    },
    {
      "verse": 63,
      "text": "米拉利族按着宗族抽签，从吕便支派、迦得支派、西布伦支派中，得了十二座城。",
      "notes": []
    },
    {
      "verse": 64,
      "text": "以色列人把这些城与其郊野给了利未人。",
      "notes": []
    },
    {
      "verse": 65,
      "text": "以色列人用抽签的方式，从犹大人、西缅人、便雅悯人三支派中，把以上提到名字的城给了他们。",
      "notes": []
    },
    {
      "verse": 66,
      "text": "哥辖子孙中有几个宗族从以法莲支派中也得了城镇作为他们的区域。",
      "notes": []
    },
    {
      "verse": 67,
      "text": "他们在以法莲山区所得的逃城：示剑与其郊野、基色与其郊野、",
      "notes": []
    },
    {
      "verse": 68,
      "text": "约缅与其郊野、伯．和仑与其郊野、",
      "notes": []
    },
    {
      "verse": 69,
      "text": "亚雅仑与其郊野、迦特．临门与其郊野。",
      "notes": []
    },
    {
      "verse": 70,
      "text": "哥辖其余的子孙从玛拿西半支派中得了亚乃与其郊野、比连与其郊野。",
      "notes": []
    },
    {
      "verse": 71,
      "text": "革顺子孙从玛拿西半支派中得了巴珊的哥兰与其郊野、亚斯她录与其郊野；",
      "notes": []
    },
    {
      "verse": 72,
      "text": "从以萨迦支派中得了基低斯与其郊野、大比拉与其郊野、",
      "notes": []
    },
    {
      "verse": 73,
      "text": "拉末与其郊野、亚年与其郊野；",
      "notes": []
    },
    {
      "verse": 74,
      "text": "从亚设支派中得了玛沙与其郊野、押顿与其郊野、",
      "notes": []
    },
    {
      "verse": 75,
      "text": "户割与其郊野、利合与其郊野；",
      "notes": []
    },
    {
      "verse": 76,
      "text": "从拿弗他利支派中得了加利利的基低斯与其郊野、哈们与其郊野、基列亭与其郊野。",
      "notes": []
    },
    {
      "verse": 77,
      "text": "米拉利其余的子孙从西布伦支派中得了临摩挪与其郊野、他泊与其郊野；",
      "notes": [
        "“临摩挪”：书19．13称“临门”。"
      ]
    },
    {
      "verse": 78,
      "text": "又在耶利哥的约旦河东，从吕便支派中得了旷野的比悉与其郊野、雅杂与其郊野，",
      "notes": []
    },
    {
      "verse": 79,
      "text": "基底莫与其郊野、米法押与其郊野；",
      "notes": []
    },
    {
      "verse": 80,
      "text": "又从迦得支派中得了基列的拉末与其郊野、玛哈念与其郊野、",
      "notes": []
    },
    {
      "verse": 81,
      "text": "希实本与其郊野、雅谢与其郊野。",
      "notes": []
    }
  ]
}
