{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "1CH",
  "book_name": "历代志上",
  "chapter": 14,
  "heading": "大卫在耶路撒冷的活动",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/1CH/14/",
  "verses": [
    {
      "verse": 1,
      "text": "推罗王希兰派使者把香柏木运到大卫那里，又派石匠和木匠给大卫建造宫殿。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "大卫知道耶和华坚立他作以色列王，又为自己百姓以色列的缘故，使他的国兴盛。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "大卫在耶路撒冷又立后妃，又生儿女。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "在耶路撒冷所生的孩子名字是沙母亚、朔罢、拿单、所罗门、",
      "notes": [
        "“沙母亚”：代上3．5称“示米亚”。"
      ]
    },
    {
      "verse": 5,
      "text": "益辖、以利书亚、以法列、",
      "notes": [
        "“以利书亚”：代上3．6称“以利沙玛”。",
        "“以法列”：代上3．6称“以利法列”。"
      ]
    },
    {
      "verse": 6,
      "text": "挪迦、尼斐、雅非亚、",
      "notes": []
    },
    {
      "verse": 7,
      "text": "以利沙玛、比利雅大、以利法列。",
      "notes": [
        "“比利雅大”：撒下5．16，代上3．8称“以利雅大”。"
      ]
    },
    {
      "verse": 8,
      "text": "非利士人听见大卫受膏作全以色列的王，非利士众人就上来寻索大卫。大卫听见了，就出去迎敌。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "非利士人来了，侵犯利乏音谷。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "大卫求问神说：“我可以上去攻打非利士人吗？你将他们交在我手里吗？”耶和华对他说：“你可以上去，我必将他们交在你手里。”",
      "notes": []
    },
    {
      "verse": 11,
      "text": "非利士人上到巴力．毗拉心，大卫在那里击败他们。大卫说：“神藉我的手冲破敌人，如水冲破一样。”因此那地方称为巴力．毗拉心。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "非利士人把神像抛弃在那里，大卫吩咐人用火焚烧了。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "非利士人又侵犯利乏音谷。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "大卫再求问神。神对他说：“不要从他们后头追上去，要绕道离开他们，从桑树林对面攻打他们。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "你听见桑树梢上有脚步的声音，那时你就要出战，因为神已经出去，在你前头攻打非利士人的军队了。”",
      "notes": []
    },
    {
      "verse": 16,
      "text": "大卫就遵照神所吩咐的去做，攻打非利士人的军队，从基遍直到基色。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "于是大卫的名传扬到万邦，耶和华使万国都惧怕他。",
      "notes": []
    }
  ]
}
