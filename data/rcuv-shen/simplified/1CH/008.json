{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "1CH",
  "book_name": "历代志上",
  "chapter": 8,
  "heading": "便雅悯的后裔",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/1CH/8/",
  "verses": [
    {
      "verse": 1,
      "text": "便雅悯生长子比拉，次子亚实别，三子亚哈拉，",
      "notes": []
    },
    {
      "verse": 2,
      "text": "四子挪哈，五子拉法。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "比拉的儿子是亚大、基拉、亚比忽、",
      "notes": []
    },
    {
      "verse": 4,
      "text": "亚比书、乃幔、亚何亚、",
      "notes": []
    },
    {
      "verse": 5,
      "text": "基拉、示孚汛和户兰。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "以忽的后裔如下，他们是迦巴居民的族长，曾被掳到玛拿辖：",
      "notes": []
    },
    {
      "verse": 7,
      "text": "乃幔、亚希亚、基拉；他掳了他们，又生了乌撒和亚希忽。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "沙哈连休了两个妻子户伸和巴拉之后，在摩押地生了儿子。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他与妻子贺得生了约巴、洗比雅、米沙、玛拉干、",
      "notes": []
    },
    {
      "verse": 10,
      "text": "耶乌斯、沙迦和米玛；这些是他的儿子，都是族长。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "户伸为他生了亚比突和以利巴力。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "以利巴力的儿子是希伯、米珊和沙麦；沙麦建立阿挪、罗德和所属的乡镇。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "比利亚和示玛是亚雅仑居民的族长，他们驱逐了迦特的居民。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "亚希约、沙煞、耶利末、",
      "notes": [
        "“亚希约、沙煞”：七十士译本是“他们的弟兄是沙煞”。"
      ]
    },
    {
      "verse": 15,
      "text": "西巴第雅、亚拉得、亚得、",
      "notes": []
    },
    {
      "verse": 16,
      "text": "米迦勒、伊施巴和约哈都是比利亚的儿子。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "西巴第雅、米书兰、希西基、希伯、",
      "notes": []
    },
    {
      "verse": 18,
      "text": "伊施米莱、伊斯利亚和约巴都是以利巴力的儿子。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "雅金、细基利、撒底、",
      "notes": []
    },
    {
      "verse": 20,
      "text": "以利乃、洗勒太、以利业、",
      "notes": []
    },
    {
      "verse": 21,
      "text": "亚大雅、比拉雅和申拉都是示每的儿子。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "伊施班、希伯、以利业、",
      "notes": []
    },
    {
      "verse": 23,
      "text": "亚伯顿、细基利、哈难、",
      "notes": []
    },
    {
      "verse": 24,
      "text": "哈拿尼雅、以拦、安陀提雅、",
      "notes": []
    },
    {
      "verse": 25,
      "text": "伊弗底雅、毗努伊勒都是沙煞的儿子。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "珊示莱、示哈利、亚他利雅、",
      "notes": []
    },
    {
      "verse": 27,
      "text": "雅利西、以利亚和细基利都是耶罗罕的儿子。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "这些人按照他们的家谱都是族长，是领袖，都住在耶路撒冷。",
      "notes": []
    },
    {
      "verse": 29,
      "section_headings": [
        "扫罗王的家族"
      ],
      "text": "在基遍住的有基遍的父亲耶利，他的妻子名叫玛迦；",
      "notes": []
    },
    {
      "verse": 30,
      "text": "他的长子是亚伯顿，还有苏珥、基士、巴力、拿答、",
      "notes": [
        "“巴力”：七十士译本的一些抄本是“巴力、尼珥”；参代上9．36。"
      ]
    },
    {
      "verse": 31,
      "text": "基多、亚希约和撒迦。",
      "notes": [
        "七十士译本在此加“米基罗”；参代上9．37。"
      ]
    },
    {
      "verse": 32,
      "text": "米基罗生示米暗。这些人在他们弟兄的对面，和他们的弟兄同住在耶路撒冷。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "尼珥生基士；基士生扫罗；扫罗生约拿单、麦基．舒亚、亚比拿达和伊施巴力。",
      "notes": [
        "“伊施巴力”又名“伊施．波设”，见撒下2．8；又名“亦施韦”，见撒上14．49；代上9．39同。"
      ]
    },
    {
      "verse": 34,
      "text": "约拿单的儿子是米力．巴力；米力．巴力生米迦。",
      "notes": [
        "“米力．巴力”：撒下4．4称“米非波设”；代上9．40同。"
      ]
    },
    {
      "verse": 35,
      "text": "米迦的儿子是毗敦、米勒、他利亚和亚哈斯；",
      "notes": []
    },
    {
      "verse": 36,
      "text": "亚哈斯生耶何阿达；耶何阿达生亚拉篾、亚斯玛威和心利；心利生摩撒；",
      "notes": []
    },
    {
      "verse": 37,
      "text": "摩撒生比尼亚；比尼亚的儿子是拉法，拉法的儿子是以利亚萨，以利亚萨的儿子是亚悉。",
      "notes": []
    },
    {
      "verse": 38,
      "text": "亚悉有六个儿子，他们的名字是亚斯利干、波基路、以实玛利、示亚利雅、俄巴底雅和哈难；这些全都是亚悉的儿子。",
      "notes": [
        "“亚斯利干、波基路”：七十士译本是“他的长子亚斯利干”。"
      ]
    },
    {
      "verse": 39,
      "text": "亚悉兄弟以设的儿子：长子是乌兰，次子是耶乌施，三子是以利法列。",
      "notes": []
    },
    {
      "verse": 40,
      "text": "乌兰的儿子都是大能的勇士，是弓箭手，他们有许多的子孙，共一百五十名，都是便雅悯人。",
      "notes": []
    }
  ]
}
