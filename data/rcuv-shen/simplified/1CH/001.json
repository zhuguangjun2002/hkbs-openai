{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "1CH",
  "book_name": "历代志上",
  "chapter": 1,
  "heading": "从亚当到亚伯拉罕",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/1CH/1/",
  "verses": [
    {
      "verse": 1,
      "text": "亚当，塞特，以挪士，",
      "notes": []
    },
    {
      "verse": 2,
      "text": "该南，玛勒列，雅列，",
      "notes": []
    },
    {
      "verse": 3,
      "text": "以诺，玛土撒拉，拉麦，",
      "notes": []
    },
    {
      "verse": 4,
      "text": "挪亚，闪，含，雅弗。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "雅弗的儿子是歌篾、玛各、玛代、雅完、土巴、米设和提拉。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "歌篾的儿子是亚实基拿、低法和陀迦玛。",
      "notes": [
        "“低法”：有古卷是“利法”；参创 10．3。"
      ]
    },
    {
      "verse": 7,
      "text": "雅完的儿子是以利沙、他施、基提和罗单人。",
      "notes": [
        "“罗单人”：参创10．4。"
      ]
    },
    {
      "verse": 8,
      "text": "含的儿子是古实、麦西、弗和迦南。",
      "notes": [
        "“麦西”即“埃及”；下同。"
      ]
    },
    {
      "verse": 9,
      "text": "古实的儿子是西巴、哈腓拉、撒弗他、拉玛和撒弗提迦。拉玛的儿子是示巴和底但。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "古实又生宁录，他是地上第一个勇士。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "麦西生路低人、亚拿米人、利哈比人、拿弗土希人、",
      "notes": []
    },
    {
      "verse": 12,
      "text": "帕斯鲁细人、迦斯路希人和迦斐托人；非利士人是从迦斐托人出来的。",
      "notes": [
        "“迦斐托人”：原文是“迦斯路希人”。"
      ]
    },
    {
      "verse": 13,
      "text": "迦南生了长子西顿，又生赫",
      "notes": []
    },
    {
      "verse": 14,
      "text": "和耶布斯人、亚摩利人、革迦撒人、",
      "notes": []
    },
    {
      "verse": 15,
      "text": "希未人、亚基人、西尼人、",
      "notes": []
    },
    {
      "verse": 16,
      "text": "亚瓦底人、洗玛利人和哈马人。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "闪的儿子是以拦、亚述、亚法撒、路德、亚兰、乌斯、户勒、基帖和米设。",
      "notes": [
        "“米设”：创10．23是“玛施”。"
      ]
    },
    {
      "verse": 18,
      "text": "亚法撒生沙拉；沙拉生希伯。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "希伯生了两个儿子：一个名叫法勒，因为那时人分地居住；法勒的兄弟名叫约坍。",
      "notes": [
        "“法勒”意思是“分”。"
      ]
    },
    {
      "verse": 20,
      "text": "约坍生亚摩答、沙列、哈萨玛非、耶拉、",
      "notes": []
    },
    {
      "verse": 21,
      "text": "哈多兰、乌萨、德拉、",
      "notes": []
    },
    {
      "verse": 22,
      "text": "以巴录、亚比玛利、示巴、",
      "notes": [
        "“以巴录”：创10．28称“俄巴路”。"
      ]
    },
    {
      "verse": 23,
      "text": "阿斐、哈腓拉和约巴。这些都是约坍的儿子。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "闪，亚法撒，沙拉，",
      "notes": []
    },
    {
      "verse": 25,
      "text": "希伯，法勒，拉吴，",
      "notes": []
    },
    {
      "verse": 26,
      "text": "西鹿，拿鹤，他拉，",
      "notes": []
    },
    {
      "verse": 27,
      "text": "亚伯兰，亚伯兰就是亚伯拉罕。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "亚伯拉罕的儿子是以撒和以实玛利。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "以实玛利的后代如下：以实玛利的长子是尼拜约，又有基达、亚德别、米比衫、",
      "notes": []
    },
    {
      "verse": 30,
      "text": "米施玛、度玛、玛撒、哈大、提玛、",
      "notes": []
    },
    {
      "verse": 31,
      "text": "伊突、拿非施和基底玛。这些都是以实玛利的儿子。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "亚伯拉罕的妾基土拉所生的儿子，就是心兰、约珊、米但、米甸、伊施巴和书亚。约珊的儿子是示巴和底但。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "米甸的儿子是以法、以弗、哈诺、亚比大和以勒大。这些都是基土拉的子孙。",
      "notes": []
    },
    {
      "verse": 34,
      "text": "亚伯拉罕生以撒；以撒的儿子是以扫和以色列。",
      "notes": []
    },
    {
      "verse": 35,
      "text": "以扫的儿子是以利法、流珥、耶乌施、雅兰和可拉。",
      "notes": []
    },
    {
      "verse": 36,
      "text": "以利法的儿子是提幔、阿抹、洗玻、迦坦、基纳斯、亭纳和亚玛力。",
      "notes": []
    },
    {
      "verse": 37,
      "text": "流珥的儿子是拿哈、谢拉、沙玛和米撒。",
      "notes": []
    },
    {
      "verse": 38,
      "text": "西珥的儿子是罗坍、朔巴、祭便、亚拿、底顺、以察和底珊。",
      "notes": []
    },
    {
      "verse": 39,
      "text": "罗坍的儿子是何利和荷幔；罗坍的妹妹是亭纳。",
      "notes": [
        "“荷幔”：创36．22称“希幔”。"
      ]
    },
    {
      "verse": 40,
      "text": "朔巴的儿子是亚勒文、玛拿辖、以巴录、示非和阿南。祭便的儿子是爱亚和亚拿。",
      "notes": [
        "“示非”：创36．23称“示玻”。"
      ]
    },
    {
      "verse": 41,
      "text": "亚拿的儿子是底顺。底顺的儿子是哈默兰、伊是班、益兰和基兰。",
      "notes": [
        "“哈默兰”：创36．26称“欣但”。"
      ]
    },
    {
      "verse": 42,
      "text": "以察的儿子是辟罕、撒番和亚干。底珊的儿子是乌斯和亚兰。",
      "notes": [
        "“亚干”是根据一些古卷和七十士译本；原文是“约亚干”；参创36．27。",
        "“底珊”：原文是“底顺”。"
      ]
    },
    {
      "verse": 43,
      "text": "以色列人未有君王治理之前，这些是在以东地作王的。有比珥的儿子比拉，他的城名叫亭哈巴。",
      "notes": []
    },
    {
      "verse": 44,
      "text": "比拉死了，波斯拉人谢拉的儿子约巴接续他作王。",
      "notes": []
    },
    {
      "verse": 45,
      "text": "约巴死了，提幔人之地的户珊接续他作王。",
      "notes": []
    },
    {
      "verse": 46,
      "text": "户珊死了，比达的儿子哈达接续他作王，哈达曾在摩押地击败米甸人，他的城名叫亚未得。",
      "notes": []
    },
    {
      "verse": 47,
      "text": "哈达死了，玛士利加人桑拉接续他作王。",
      "notes": []
    },
    {
      "verse": 48,
      "text": "桑拉死了，大河边的利河伯人扫罗接续他作王。",
      "notes": []
    },
    {
      "verse": 49,
      "text": "扫罗死了，亚革波的儿子巴勒．哈南接续他作王。",
      "notes": []
    },
    {
      "verse": 50,
      "text": "巴勒．哈南死了，哈达接续他作王，他的城名叫巴伊。他的妻子名叫米希她别，是米．萨合的孙女，玛特列的女儿。",
      "notes": [
        "“巴伊”：创36．39称“巴乌”。"
      ]
    },
    {
      "verse": 51,
      "text": "哈达死了。以东的族长有：亭纳族长、亚勒瓦族长、耶帖族长、",
      "notes": []
    },
    {
      "verse": 52,
      "text": "阿何利巴玛族长、以拉族长、比嫩族长、",
      "notes": []
    },
    {
      "verse": 53,
      "text": "基纳斯族长、提幔族长、米比萨族长、",
      "notes": []
    },
    {
      "verse": 54,
      "text": "玛基叠族长、以兰族长。这些都是以东的族长。",
      "notes": []
    }
  ]
}
