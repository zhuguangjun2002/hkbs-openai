{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "1CH",
  "book_name": "历代志上",
  "chapter": 2,
  "heading": "犹大的后裔",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/1CH/2/",
  "verses": [
    {
      "verse": 1,
      "text": "以色列的儿子是吕便、西缅、利未、犹大、以萨迦、西布伦、",
      "notes": []
    },
    {
      "verse": 2,
      "text": "但、约瑟、便雅悯、拿弗他利、迦得和亚设。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "犹大的儿子是珥、俄南和示拉，这三人是迦南女子拔．书亚所生的。犹大的长子珥在耶和华眼中看为恶，耶和华就杀死了他。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "犹大的媳妇她玛为犹大生了法勒斯和谢拉。犹大共有五个儿子。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "法勒斯的儿子是希斯仑和哈母勒。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "谢拉的儿子是心利、以探、希幔、甲各和大拉，共五人。",
      "notes": [
        "“大拉”：七十士译本的一些抄本和其他古译本是“达大”；参王上4．31。"
      ]
    },
    {
      "verse": 7,
      "text": "迦米的儿子是亚迦，他在当灭的物上犯了罪，连累了以色列人。",
      "notes": [
        "“亚迦”：有古卷是“亚干”；参书7．18。"
      ]
    },
    {
      "verse": 8,
      "text": "以探的儿子是亚撒利雅。",
      "notes": []
    },
    {
      "verse": 9,
      "section_headings": [
        "大卫王的家谱"
      ],
      "text": "希斯仑所生的儿子是耶拉篾、兰和基路拜。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "兰生亚米拿达；亚米拿达生拿顺，拿顺是犹大人的领袖。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "拿顺生撒门；撒门生波阿斯；",
      "notes": []
    },
    {
      "verse": 12,
      "text": "波阿斯生俄备得；俄备得生耶西；",
      "notes": []
    },
    {
      "verse": 13,
      "text": "耶西生长子以利押，次子亚比拿达，三子示米亚，",
      "notes": [
        "“示米亚”：撒上16．9称“沙玛”。"
      ]
    },
    {
      "verse": 14,
      "text": "四子拿坦业，五子拉代，",
      "notes": []
    },
    {
      "verse": 15,
      "text": "六子阿鲜，七子大卫。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "他们的姊妹是洗鲁雅和亚比该。洗鲁雅的儿子是亚比筛、约押和亚撒黑，共三人。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "亚比该生亚玛撒；亚玛撒的父亲是以实玛利人益帖。",
      "notes": []
    },
    {
      "verse": 18,
      "section_headings": [
        "希斯仑的后裔"
      ],
      "text": "希斯仑的儿子迦勒娶阿苏巴和耶略为妻，阿苏巴的儿子是耶设、朔罢和押墩。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "阿苏巴死了，迦勒又娶以法她，生了户珥。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "户珥生乌利；乌利生比撒列。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "后来，希斯仑六十岁时娶了基列的父亲玛吉的女儿，与她同房；玛吉的女儿为他生了西割；",
      "notes": []
    },
    {
      "verse": 22,
      "text": "西割生睚珥。睚珥在基列地有二十三座城。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "后来基述和亚兰夺了哈倭特．睚珥，以及基纳和所属的乡镇，共六十个。这些城镇的人全都是基列的父亲玛吉的子孙。",
      "notes": [
        "“乡镇”：原文直译“女子们”；本卷书下同。"
      ]
    },
    {
      "verse": 24,
      "text": "希斯仑在迦勒．以法他死后，他的妻子亚比雅为他生了提哥亚的父亲亚施户。",
      "notes": [
        "本节七十士译本是“希斯仑死后，迦勒到了以法他。希斯仑的妻子是亚比雅，为他生了提哥亚的父亲亚施户。”"
      ]
    },
    {
      "verse": 25,
      "section_headings": [
        "耶拉篾的后裔"
      ],
      "text": "希斯仑的长子耶拉篾的儿子有长子兰、布拿、阿连、阿鲜和亚希雅。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "耶拉篾又娶一妻名叫亚她拉，是阿南的母亲。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "耶拉篾的长子兰的儿子有玛斯、雅悯和以结。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "阿南的儿子是沙买和雅大。沙买的儿子是拿答和亚比述。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "亚比述的妻子名叫亚比孩，为他生了亚办和摩利。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "拿答的儿子是西列和亚遍；西列死了，没有儿子。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "亚遍的儿子是以示；以示的儿子是示珊；示珊的儿子是亚来。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "沙买的兄弟雅大的儿子是益帖和约拿单；益帖死了，没有儿子。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "约拿单的儿子是比勒和撒萨。这些都是耶拉篾的子孙。",
      "notes": []
    },
    {
      "verse": 34,
      "text": "示珊没有儿子，只有女儿。示珊有一个仆人名叫耶哈，是埃及人。",
      "notes": []
    },
    {
      "verse": 35,
      "text": "示珊把女儿嫁给仆人耶哈，她为他生了亚太。",
      "notes": []
    },
    {
      "verse": 36,
      "text": "亚太生拿单；拿单生撒拔；",
      "notes": []
    },
    {
      "verse": 37,
      "text": "撒拔生以弗拉；以弗拉生俄备得；",
      "notes": []
    },
    {
      "verse": 38,
      "text": "俄备得生耶户；耶户生亚撒利雅；",
      "notes": []
    },
    {
      "verse": 39,
      "text": "亚撒利雅生希利斯；希利斯生以利亚萨；",
      "notes": []
    },
    {
      "verse": 40,
      "text": "以利亚萨生西斯买；西斯买生沙龙；",
      "notes": []
    },
    {
      "verse": 41,
      "text": "沙龙生耶加米雅；耶加米雅生以利沙玛。",
      "notes": []
    },
    {
      "verse": 42,
      "section_headings": [
        "迦勒的其余后裔"
      ],
      "text": "耶拉篾的兄弟迦勒的众儿子：长子是米沙，米沙是西弗的父亲，还有希伯伦的父亲玛利沙的众儿子。",
      "notes": []
    },
    {
      "verse": 43,
      "text": "希伯伦的儿子是可拉、他普亚、利肯和示玛。",
      "notes": []
    },
    {
      "verse": 44,
      "text": "示玛生拉含，是约干之祖。利肯生沙买。",
      "notes": [
        "“约干”：原文另译“约甸”；参书15．56。"
      ]
    },
    {
      "verse": 45,
      "text": "沙买的儿子是玛云；玛云是伯．夙的父亲。",
      "notes": []
    },
    {
      "verse": 46,
      "text": "迦勒的妾以法生哈兰、摩撒和迦谢；哈兰生迦卸。",
      "notes": []
    },
    {
      "verse": 47,
      "text": "雅代的儿子是利健、约坦、基珊、毗力、以法和沙亚弗。",
      "notes": []
    },
    {
      "verse": 48,
      "text": "迦勒的妾玛迦生示别和特哈拿，",
      "notes": []
    },
    {
      "verse": 49,
      "text": "又生麦玛拿的父亲沙亚弗，又生抹比拿和基比亚的父亲示法。迦勒的女儿是押撒。",
      "notes": []
    },
    {
      "verse": 50,
      "text": "这些都是迦勒的子孙。以法她的长子户珥的子孙：基列．耶琳之祖朔巴，",
      "notes": []
    },
    {
      "verse": 51,
      "text": "伯利恒之祖萨玛，伯．迦得之祖哈勒。",
      "notes": []
    },
    {
      "verse": 52,
      "text": "基列．耶琳之祖朔巴的子孙是哈罗以和一半的米努哈人。",
      "notes": [
        "“米努哈人”就是“玛拿哈人”；参54节。"
      ]
    },
    {
      "verse": 53,
      "text": "基列．耶琳的宗族有以帖人、布特人、舒玛人、密来人，又从这些宗族生出琐拉人和以实陶人。",
      "notes": []
    },
    {
      "verse": 54,
      "text": "萨玛的子孙有伯利恒人、尼陀法人、亚他绿．伯．约押人、一半的玛拿哈人、琐利人。",
      "notes": []
    },
    {
      "verse": 55,
      "text": "住雅比斯的文士的宗族有特拉人、示米押人和苏甲人。这些都是利甲家之祖哈末所生的基尼人。",
      "notes": []
    }
  ]
}
