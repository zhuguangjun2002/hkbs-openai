{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "LAM",
  "book_name": "耶利米哀歌",
  "chapter": 3,
  "heading": "惩罚、悔改、盼望",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/LAM/3/",
  "verses": [
    {
      "verse": 1,
      "text": "因耶和华愤怒的杖，我是遭遇困苦的人。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "他驱赶我走入黑暗，没有光明。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他反手攻击我，终日不停。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他使我皮肉枯干，折断我的骨头。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "他筑垒攻击我，以苦楚和艰难围困我；",
      "notes": []
    },
    {
      "verse": 6,
      "text": "使我住在幽暗之处，像死了许久的人一样。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他围住我，使我无法脱身；他使我的铜链沉重。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "尽管我哀号求救，他仍拦阻我的祷告。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他用凿过的石头挡住我的道路，使我的路径弯曲。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "他向我如埋伏的熊，如在隐密处的狮子。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "他使我转离正路，把我撕碎，使我凄凉。",
      "notes": [
        "“把我撕碎”：有一古译本是“使我跛脚”。"
      ]
    },
    {
      "verse": 12,
      "text": "他拉弓，命我站立，当作箭靶；",
      "notes": []
    },
    {
      "verse": 13,
      "text": "把箭袋中的箭射入我的肺腑。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "我成了全体百姓的笑柄，成了他们终日的歌曲。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "他使我受尽苦楚，饱食茵陈；",
      "notes": []
    },
    {
      "verse": 16,
      "text": "用沙石磨断我的牙，以灰尘覆盖我。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "你使我远离平安，我忘了何为福乐。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "于是我说：“我的力量衰败，在耶和华那里我毫无指望！”",
      "notes": []
    },
    {
      "verse": 19,
      "text": "求你记得我的困苦和流离，它如茵陈和苦胆一般；",
      "notes": []
    },
    {
      "verse": 20,
      "text": "我心想念这些，就在我里面忧闷。",
      "notes": [
        "“忧闷”：原文另译“沉思”。"
      ]
    },
    {
      "verse": 21,
      "text": "但我的心回转过来，因此就有指望；",
      "notes": []
    },
    {
      "verse": 22,
      "text": "因耶和华的慈爱，我们不致灭绝，因他的怜悯永不断绝，",
      "notes": [
        "“我们不致灭绝”：有古卷是“从不止息”。"
      ]
    },
    {
      "verse": 23,
      "text": "每早晨，这都是新的；你的信实极其广大！",
      "notes": []
    },
    {
      "verse": 24,
      "text": "我心里说：“耶和华是我的福分，因此，我要仰望他。”",
      "notes": []
    },
    {
      "verse": 25,
      "text": "凡等候耶和华，心里寻求他的，耶和华必施恩给他。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "人仰望耶和华，安静等候他的救恩，这是好的。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "人在年轻时负轭，这是好的。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "他当安静独坐，因为这是耶和华加在他身上的。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "让他脸伏于地吧！或者还会有指望。",
      "notes": [
        "“脸伏于地”：原文是“口贴尘土”。"
      ]
    },
    {
      "verse": 30,
      "text": "让人打他耳光，使他饱受凌辱吧！",
      "notes": []
    },
    {
      "verse": 31,
      "text": "主必不永远撇弃，",
      "notes": []
    },
    {
      "verse": 32,
      "text": "他虽使人忧愁，还要照他丰盛的慈爱施怜悯；",
      "notes": []
    },
    {
      "verse": 33,
      "text": "他并不存心要人受苦，令世人忧愁。",
      "notes": []
    },
    {
      "verse": 34,
      "text": "把世上所有的囚犯踹在脚下，",
      "notes": []
    },
    {
      "verse": 35,
      "text": "在至高者面前扭曲人的公正，",
      "notes": []
    },
    {
      "verse": 36,
      "text": "在人的诉讼上颠倒是非，这都是主看不中的。",
      "notes": []
    },
    {
      "verse": 37,
      "text": "若非主发命令，谁能说了就成呢？",
      "notes": []
    },
    {
      "verse": 38,
      "text": "是祸，是福，不都出于至高者的口吗？",
      "notes": []
    },
    {
      "verse": 39,
      "text": "人都有自己的罪，活人有什么好发怨言的呢？",
      "notes": []
    },
    {
      "verse": 40,
      "text": "让我们省察，检讨自己的行为，归向耶和华吧！",
      "notes": []
    },
    {
      "verse": 41,
      "text": "让我们献上我们的心，向天上的神举手！",
      "notes": []
    },
    {
      "verse": 42,
      "text": "我们犯罪悖逆，你并未赦免。",
      "notes": []
    },
    {
      "verse": 43,
      "text": "你浑身是怒气，追赶我们；你施行杀戮，并不顾惜。",
      "notes": []
    },
    {
      "verse": 44,
      "text": "你以密云围着自己，祷告不能穿透。",
      "notes": []
    },
    {
      "verse": 45,
      "text": "你使我们在万民中成为污物和垃圾。",
      "notes": []
    },
    {
      "verse": 46,
      "text": "我们所有的仇敌张口来攻击我们；",
      "notes": []
    },
    {
      "verse": 47,
      "text": "惊吓和陷阱临到我们，残害和毁灭也临到我们。",
      "notes": []
    },
    {
      "verse": 48,
      "text": "因我百姓遭毁灭，我的眼睛泪流成河。",
      "notes": [
        "“我百姓”：原文直译“我百姓的女儿”。"
      ]
    },
    {
      "verse": 49,
      "text": "我的眼睛流泪不停，流泪不止，",
      "notes": []
    },
    {
      "verse": 50,
      "text": "直等到耶和华垂顾，从天上观看。",
      "notes": []
    },
    {
      "verse": 51,
      "text": "为我城中的百姓，我眼所见的使我心痛。",
      "notes": [
        "“百姓”：原文直译“女子们”。"
      ]
    },
    {
      "verse": 52,
      "text": "无故与我为敌的追逼我，像追捕雀鸟一样。",
      "notes": []
    },
    {
      "verse": 53,
      "text": "他们要在坑中了结我的性命，丢石头在我身上。",
      "notes": []
    },
    {
      "verse": 54,
      "text": "众水淹没我的头，我说：“我没命了！”",
      "notes": []
    },
    {
      "verse": 55,
      "text": "耶和华啊，在极深的地府里，我求告你的名。",
      "notes": []
    },
    {
      "verse": 56,
      "text": "我的声音你听见了，求你不要掩耳不听我的呼声，我的求救。",
      "notes": []
    },
    {
      "verse": 57,
      "text": "我求告你的时候，你临近我，说：“不要惧怕！”",
      "notes": []
    },
    {
      "verse": 58,
      "text": "主啊，你为我伸冤，你救赎了我的命。",
      "notes": []
    },
    {
      "verse": 59,
      "text": "耶和华啊，你已看见我的委屈，求你为我主持正义。",
      "notes": []
    },
    {
      "verse": 60,
      "text": "他们要报复，谋害我，你都看见了。",
      "notes": []
    },
    {
      "verse": 61,
      "text": "耶和华啊，你听见他们的辱骂，他们害我的一切计谋，",
      "notes": []
    },
    {
      "verse": 62,
      "text": "那些起来攻击我的人嘴唇所说的话和他们终日攻击我的计谋。",
      "notes": []
    },
    {
      "verse": 63,
      "text": "求你留意！他们无论坐下或起来，我都是他们的笑柄。",
      "notes": []
    },
    {
      "verse": 64,
      "text": "耶和华啊，求你照他们手所做的向他们施行报应。",
      "notes": []
    },
    {
      "verse": 65,
      "text": "求你使他们心里刚硬，使你的诅咒临到他们。",
      "notes": []
    },
    {
      "verse": 66,
      "text": "求你发怒追赶他们，从耶和华的地上除灭他们。",
      "notes": [
        "“地上”：原文是“诸天底下”。"
      ]
    }
  ]
}
