{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "MRK",
  "book_name": "马可福音",
  "chapter": 1,
  "heading": "施洗约翰传道",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/MRK/1/",
  "verses": [
    {
      "verse": 1,
      "text": "神的儿子，耶稣基督福音的起头。",
      "notes": [
        "有古卷没有“神的儿子”。"
      ]
    },
    {
      "verse": 2,
      "text": "正如以赛亚先知书上记着：“看哪，我要差遣我的使者在你面前，他要为你预备道路。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "在旷野有声音呼喊着：预备主的道，修直他的路。”",
      "notes": []
    },
    {
      "verse": 4,
      "text": "照这话，施洗约翰来到旷野，宣讲悔改的洗礼，使罪得赦。",
      "notes": [
        "有古卷是“约翰来了，在旷野施洗”。"
      ]
    },
    {
      "verse": 5,
      "text": "犹太全地和全耶路撒冷的人都出去，到约翰那里，承认他们的罪，在约旦河里受他的洗。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "约翰穿骆驼毛的衣服，腰束皮带，吃的是蝗虫和野蜜。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他宣讲，说：“有一位在我以后来的，能力比我更大，我就是弯腰给他解鞋带也不配。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "我用水给你们施洗，他却要用圣灵给你们施洗。”",
      "notes": []
    },
    {
      "verse": 9,
      "section_headings": [
        "耶稣受洗"
      ],
      "text": "那时，耶稣从加利利的拿撒勒来，在约旦河里受了约翰的洗。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "他从水里一上来，就看见天裂开了，圣灵仿佛鸽子降在他身上。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "又有声音从天上来，说：“你是我的爱子，我喜爱你。”",
      "notes": []
    },
    {
      "verse": 12,
      "section_headings": [
        "耶稣受试探"
      ],
      "text": "圣灵立刻把耶稣催促到旷野里去。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "他在旷野四十天，受撒但的试探，并与野兽同在一起，且有天使来伺候他。",
      "notes": []
    },
    {
      "verse": 14,
      "section_headings": [
        "开始在加利利传道"
      ],
      "text": "约翰下监以后，耶稣来到加利利，宣讲神的福音，",
      "notes": []
    },
    {
      "verse": 15,
      "text": "说：“日期满了，神的国近了。你们要悔改，信福音！”",
      "notes": []
    },
    {
      "verse": 16,
      "section_headings": [
        "呼召四个渔夫"
      ],
      "text": "耶稣沿着加利利的海边走，看见西门和西门的弟弟安得烈在海上撒网；他们本是打鱼的。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "耶稣对他们说：“来跟从我，我要叫你们得人如得鱼一样。”",
      "notes": []
    },
    {
      "verse": 18,
      "text": "他们立刻舍了网，跟从他。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "耶稣稍往前走，又见西庇太的儿子雅各和他弟弟约翰在船上补网。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "耶稣随即呼召他们，他们就把父亲西庇太和雇工留在船上，跟从了耶稣。",
      "notes": []
    },
    {
      "verse": 21,
      "section_headings": [
        "耶稣赶逐污灵"
      ],
      "text": "他们到了迦百农，耶稣就在安息日进了会堂教导人。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "他们对他的教导感到很惊奇，因为他教导他们正像有权柄的人，不像文士。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "当时，会堂里有一个污灵附身的人，他在喊叫，",
      "notes": []
    },
    {
      "verse": 24,
      "text": "说：“拿撒勒人耶稣，你为什么干扰我们？你来消灭我们吗？我知道你是谁，你是神的圣者。”",
      "notes": []
    },
    {
      "verse": 25,
      "text": "耶稣斥责他说：“不要作声，从这人身上出来吧！”",
      "notes": []
    },
    {
      "verse": 26,
      "text": "污灵使那人抽了一阵风，大声喊叫，就出来了。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "众人都惊讶，以致彼此对问：“这是什么事？是个新的教导啊！他用权柄命令污灵，连污灵也听从了他。”",
      "notes": []
    },
    {
      "verse": 28,
      "text": "于是耶稣的名声立刻传遍了全加利利周围地区。",
      "notes": []
    },
    {
      "verse": 29,
      "section_headings": [
        "治好许多病人"
      ],
      "text": "他们一出会堂，就同雅各和约翰进了西门和安得烈的家。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "西门的岳母正发烧躺着，就有人告诉耶稣。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "耶稣进前拉着她的手，扶她起来，烧就退了，于是她服事他们。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "傍晚日落的时候，有人带着一切害病的和被鬼附的，来到耶稣跟前。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "全城的人都聚集在门前。",
      "notes": []
    },
    {
      "verse": 34,
      "text": "耶稣治好了许多害各样病的人，又赶出许多鬼，不许鬼说话，因为鬼认识他。",
      "notes": []
    },
    {
      "verse": 35,
      "section_headings": [
        "在加利利传道"
      ],
      "text": "次日早晨，天未亮的时候，耶稣起来，到旷野地方去，在那里祷告。",
      "notes": []
    },
    {
      "verse": 36,
      "text": "西门和同伴出去找他，",
      "notes": []
    },
    {
      "verse": 37,
      "text": "找到了就对他说：“众人都在找你！”",
      "notes": []
    },
    {
      "verse": 38,
      "text": "耶稣对他们说：“让我们往别处去，到邻近的乡村，我也好在那里传道，因为我是为这事出来的。”",
      "notes": []
    },
    {
      "verse": 39,
      "text": "于是他走遍全加利利，在他们的会堂传道，并且赶鬼。",
      "notes": []
    },
    {
      "verse": 40,
      "section_headings": [
        "洁净麻风病人"
      ],
      "text": "有一个麻风病人来求耶稣，向他跪下，说：“你若肯，你能使我洁净。”",
      "notes": [
        "有古卷没有“向他跪下”。"
      ]
    },
    {
      "verse": 41,
      "text": "耶稣动了慈心，就伸手摸他，说：“我肯，你洁净了吧！”",
      "notes": []
    },
    {
      "verse": 42,
      "text": "麻风病立刻离开他，他就洁净了。",
      "notes": []
    },
    {
      "verse": 43,
      "text": "耶稣严严地叮嘱他，立刻打发他走，",
      "notes": []
    },
    {
      "verse": 44,
      "text": "对他说：“你要注意，千万不可告诉任何人，只要去，让祭司为你检查，又因为你已经洁净，献上摩西所吩咐的祭物，作为证据给众人看。”",
      "notes": []
    },
    {
      "verse": 45,
      "text": "那人出去，倒说许多的话，把这件事传扬开了，使耶稣不能再公开进城，只好留在外边旷野地方，人从各处都到他跟前来。",
      "notes": []
    }
  ]
}
