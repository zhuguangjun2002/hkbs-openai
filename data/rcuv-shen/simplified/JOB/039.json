{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "JOB",
  "book_name": "约伯记",
  "chapter": 39,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/JOB/39/",
  "verses": [
    {
      "verse": 1,
      "text": "“你知道岩石间的野山羊几时生产吗？你能观察母鹿下小鹿吗？",
      "notes": []
    },
    {
      "verse": 2,
      "text": "你能数算它们怀胎的月数吗？你知道它们几时生产吗？",
      "notes": []
    },
    {
      "verse": 3,
      "text": "它们屈身，生下幼儿，就解除了阵痛。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "其子渐渐肥壮，在荒野长大；它们出去，不再归回。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "“谁放野驴自由？谁解开快驴的绳索？",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我使旷野作它的住处，使盐地当它的居所。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "它嘲笑城内的喧嚷，不听赶牲口的喝声。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "诸山是它漫游的草场，它寻找各样青绿之物。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "“野牛岂肯服事你？岂肯在你的槽旁过夜？",
      "notes": []
    },
    {
      "verse": 10,
      "text": "你岂能用套绳将野牛系于犁沟？它岂肯随你耙松山谷之地？",
      "notes": []
    },
    {
      "verse": 11,
      "text": "你岂可因它力大就倚靠它？岂可把你的工交给它做呢？",
      "notes": []
    },
    {
      "verse": 12,
      "text": "你岂能靠它把你的谷物运回，又收聚在你的禾场上吗？",
      "notes": [
        "本节原文另译“你岂能信赖它会回来，又收聚你禾场上的谷物呢？”"
      ]
    },
    {
      "verse": 13,
      "text": "“鸵鸟的翅膀欢然拍动，但岂是鹳的翎毛和羽毛吗？",
      "notes": [
        "“但岂是...羽毛吗”或译“它的翎毛和羽毛岂是显示慈爱吗”；“慈爱”与“鹳”的希伯来话发音相近。"
      ]
    },
    {
      "verse": 14,
      "text": "因它把蛋留在地上，使蛋在尘土中得温暖，",
      "notes": []
    },
    {
      "verse": 15,
      "text": "却忘记脚会把蛋踹碎，野兽会践踏它。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "它粗暴待雏，似乎不是自己生的；虽徒然劳苦，也不惧怕。",
      "notes": [
        "“劳苦”指“孵蛋”。"
      ]
    },
    {
      "verse": 17,
      "text": "因为神使它忘记智慧，也未将悟性分给它。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "它几时挺身展开翅膀，就嘲笑马和骑马的人。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "“马的力量是你所赐的吗？它颈项上的鬃是你披上的吗？",
      "notes": []
    },
    {
      "verse": 20,
      "text": "是你叫它跳跃像蝗虫吗？它喷气之威严使人惊惶。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "它用蹄在谷中挖地，以能力欢跃；它出去迎击仇敌。",
      "notes": [
        "“它用蹄...挖地”：原文直译“它们在谷中挖地”。",
        "“仇敌”：原文是“兵器”。"
      ]
    },
    {
      "verse": 22,
      "text": "它嘲笑惧怕，并不惊惶，也不因刀剑退却。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "箭袋在它身上铮铮有声，枪和短枪闪闪发亮。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "它震颤激动，将地吞下 ；一听角声就站不住。",
      "notes": [
        "“将地吞下”意思是“全速奔跑”。"
      ]
    },
    {
      "verse": 25,
      "text": "每逢角声一响，它说：‘啊哈！’它从远处闻到战争的气息，听见军官如雷的吼声和呐喊。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "“鹰展开翅膀向南飞翔，岂是藉着你的智慧吗？",
      "notes": []
    },
    {
      "verse": 27,
      "text": "大鹰上腾在高处搭窝，岂是听你的指示吗？",
      "notes": []
    },
    {
      "verse": 28,
      "text": "它住在山岩，以山峰和坚固之所为家，",
      "notes": []
    },
    {
      "verse": 29,
      "text": "从那里窥察食物，眼睛自远方瞭望。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "它的雏吸血；被杀的人在哪里，它也在哪里。”",
      "notes": []
    }
  ]
}
