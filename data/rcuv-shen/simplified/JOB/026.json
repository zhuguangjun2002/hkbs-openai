{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "JOB",
  "book_name": "约伯记",
  "chapter": 26,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/JOB/26/",
  "verses": [
    {
      "verse": 1,
      "text": "约伯回答说：",
      "notes": []
    },
    {
      "verse": 2,
      "text": "“无能的人蒙你何等的帮助！膀臂无力的人蒙你何等的拯救！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "无智慧的人蒙你何等的指教！你向他显出丰富的知识。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "你向谁发出言语？谁的灵从你而出？",
      "notes": []
    },
    {
      "verse": 5,
      "text": "在大水和水族以下，阴魂战兢。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "在神面前，阴间显露；冥府也不得遮掩。",
      "notes": [
        "“冥府”：原文音译“亚巴顿”，意思是“灭亡之地”。"
      ]
    },
    {
      "verse": 7,
      "text": "神将北极铺在空中，将大地悬在虚空。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他将水包在密云中，盛水的云却不破裂。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他遮蔽宝座的正面，把他的云彩铺在其上。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "他在水面上划一圆圈，直到光明与黑暗的交界。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "天的柱子震动，因他的斥责惊奇。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "他以能力搅动大海，藉知识打伤拉哈伯。",
      "notes": [
        "“搅动”或译“平静”。"
      ]
    },
    {
      "verse": 13,
      "text": "他藉自己的灵使天空晴朗；他的手刺杀爬得快的蛇。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "看哪，这不过是神工作的些微；我们听见他的话，是何等细微的声音！他大能的雷声谁能明白呢？”",
      "notes": []
    }
  ]
}
