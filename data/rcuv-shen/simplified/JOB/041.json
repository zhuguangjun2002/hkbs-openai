{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "JOB",
  "book_name": "约伯记",
  "chapter": 41,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/JOB/41/",
  "verses": [
    {
      "verse": 1,
      "text": "“你能用鱼钩钓上力威亚探吗？能用绳子压下它的舌头吗？",
      "notes": [
        "“力威亚探”是音译，一种海兽；或译“鳄鱼”。"
      ]
    },
    {
      "verse": 2,
      "text": "你能用绳索穿它的鼻子吗？能用钩子穿它的腮骨吗？",
      "notes": []
    },
    {
      "verse": 3,
      "text": "它岂向你连连恳求，向你说温柔的话吗？",
      "notes": []
    },
    {
      "verse": 4,
      "text": "它岂肯与你立约，让你拿它永远作奴仆吗？",
      "notes": []
    },
    {
      "verse": 5,
      "text": "你岂可拿它当雀鸟玩耍？岂可将它系来给你幼女？",
      "notes": []
    },
    {
      "verse": 6,
      "text": "合伙的鱼贩岂可拿它当货物？他们岂可把它分给商人呢？",
      "notes": []
    },
    {
      "verse": 7,
      "text": "你能用倒钩扎满它的皮，能用鱼叉叉满它的头吗？",
      "notes": []
    },
    {
      "verse": 8,
      "text": "把你的手掌按在它身上吧！想一想与它搏斗，你就不再这样做了！",
      "notes": []
    },
    {
      "verse": 9,
      "text": "看哪，对它有指望是徒然的；一见它，岂不也丧胆吗？",
      "notes": [
        "“一见它，岂不也丧胆吗？”原文另译“一见到它，人也丧胆。”有古译本是“一见它，神明也丧胆吗？”"
      ]
    },
    {
      "verse": 10,
      "text": "没有那么凶猛的人敢惹它。这样，谁能在我面前站立得住呢？",
      "notes": [
        "“没有...敢惹它。”或译“它不是那么凶猛，以致没有人敢惹它吗？”"
      ]
    },
    {
      "verse": 11,
      "text": "谁能与我对质，使我偿还呢？天下万物都是我的。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "“我不能缄默不提它的肢体和力量，以及健美的骨骼。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "谁能剥它的外皮？谁能进它的铠甲之间呢？",
      "notes": [
        "“它的铠甲之间”是根据七十士译本；原文是“它辔头的两边”。"
      ]
    },
    {
      "verse": 14,
      "text": "谁能开它的腮颊？它牙齿的四围是可畏的。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "它的背上有一排排的鳞甲，紧紧闭合，封得严密。",
      "notes": [
        "“它的背上...鳞甲”是根据七十士译本；原文是“它以一排排的鳞甲为可夸”。"
      ]
    },
    {
      "verse": 16,
      "text": "这鳞甲一一相连，气不得透入其间，",
      "notes": []
    },
    {
      "verse": 17,
      "text": "互相连接，胶结一起，不能分开。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "它打喷嚏就发出光来，它的眼睛好像晨曦。",
      "notes": [
        "“好像晨曦”：原文直译“好像清晨的眼皮”。"
      ]
    },
    {
      "verse": 19,
      "text": "从它口中发出烧着的火把，有火星飞迸出来；",
      "notes": []
    },
    {
      "verse": 20,
      "text": "从它鼻孔冒出烟来，如烧开的锅在沸腾。",
      "notes": [
        "“在沸腾”：原文另译“和芦苇”。"
      ]
    },
    {
      "verse": 21,
      "text": "它的气点着煤炭，有火焰从它口中发出。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "它颈项中存着劲力，恐惧在它面前蹦跳。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "它的肉块紧紧结连，紧贴其身，不能摇动。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "它的心结实如石头，如下面的磨石那样结实。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "它一起来，神明都恐惧，因崩溃而惊慌失措。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "人用刀剑扎它，是无用的，枪、标枪、尖枪也一样。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "它以铁为干草，以铜为烂木。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "箭不能使它逃走，它看弹石如碎秸。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "它当棍棒作碎秸，它嘲笑短枪的飕飕声。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "它肚腹下面是尖瓦片；它如钉耙刮过淤泥。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "它使深渊滚沸如锅，使海洋如锅中膏油。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "它使走过以后的路发光，令人觉得深渊如同白发。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "尘世上没有像它那样的受造物，一无所惧。",
      "notes": []
    },
    {
      "verse": 34,
      "text": "凡高大的，它盯着看；它在一切狂傲的野兽中作王。”",
      "notes": []
    }
  ]
}
