{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 9,
  "heading": "称颂耶和华的公义",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/9/",
  "verses": [
    {
      "verse": 1,
      "text": "我要一心称谢耶和华，传扬你一切奇妙的作为。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "我要因你欢喜快乐；至高者啊，我要歌颂你的名！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "我的仇敌回转撤退的时候，他们在你面前跌倒灭亡。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "因你已经为我伸冤，为我辩护；你坐在宝座上，按公义审判。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "你曾斥责列国，灭绝恶人；你曾涂去他们的名，直到永永远远。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "仇敌到了尽头；他们遭毁坏，直到永远。你拆毁他们的城镇，连他们的名字也都消灭！",
      "notes": [
        "“名字”：原文是“纪念”。"
      ]
    },
    {
      "verse": 7,
      "text": "惟耶和华坐在王位上，直到永远；他已经为审判摆设宝座。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他要按公义审判世界，按正直判断万民。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "耶和华要作受欺压者的庇护所，在患难时的庇护所。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "耶和华啊，认识你名的人要倚靠你，因你没有离弃寻求你的人。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "应当歌颂居于锡安的耶和华，将他所做的传扬在万民中。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "那位追讨流人血的，他记念受屈的人，不忘记困苦人的哀求。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "耶和华啊，求你怜悯我！你是从死门把我提升起来的，求你看那恨我的人所加给我的苦难，",
      "notes": []
    },
    {
      "verse": 14,
      "text": "好让我述说你一切的美德。我要在锡安的城门因你的救恩欢乐。",
      "notes": [
        "“锡安”：原文直译“锡安女子”。"
      ]
    },
    {
      "verse": 15,
      "text": "外邦人陷在自己所掘的坑中，他们的脚被自己暗设的网罗缠住了。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "耶和华已将自己显明，他已施行审判；恶人被自己手所做的缠住了。（细拉）",
      "notes": [
        "“恶人...缠住了”或译“他叫恶人被自己手所做的缠住了”。"
      ]
    },
    {
      "verse": 17,
      "text": "恶人，就是忘记神的外邦人，都必归到阴间。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "贫穷人必不永久被忘，困苦人的指望必不永远落空。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "耶和华啊，求你兴起，不容世人得胜！愿外邦人在你面前受审判！",
      "notes": []
    },
    {
      "verse": 20,
      "text": "耶和华啊，求你使他们恐惧，愿外邦人知道自己不过是人。（细拉）",
      "notes": []
    }
  ]
}
