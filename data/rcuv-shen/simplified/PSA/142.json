{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 142,
  "heading": "求主眷顾",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/142/",
  "verses": [
    {
      "verse": 1,
      "text": "我出声哀告耶和华，出声恳求耶和华。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "我在他面前倾诉我的苦情，在他面前陈说我的患难。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "我的灵在我里面发昏的时候，你知道我的道路。在我所行的路上，人为我暗设罗网。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "求你留意向我右边观看，无人认识我；我无避难之处，也无人眷顾我。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "耶和华啊，我曾向你哀求。我说：“你是我的避难所，在活人之地，你是我的福分。”",
      "notes": []
    },
    {
      "verse": 6,
      "text": "求你留心听我的呼求，因我落到极卑微之地；求你救我脱离迫害我的人，因为他们比我强盛。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "求你从被囚之地领我出来，我好颂扬你的名。义人必环绕我，因为你用厚恩待我。",
      "notes": []
    }
  ]
}
