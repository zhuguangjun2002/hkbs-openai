{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 112,
  "heading": "义人之福",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/112/",
  "verses": [
    {
      "verse": 1,
      "text": "哈利路亚！敬畏耶和华，甚喜爱他命令的，这人有福了！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "他的后裔在世必强盛，正直人的后代必蒙福。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他的家中有金银财宝，他的义行存到永远。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "正直人在黑暗中有光向他照耀，他有恩惠，有怜悯，有公义。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "施恩与人、借贷与人、秉公处事的人必享美福，",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他永不动摇。义人被记念，直到永远。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他不惧怕凶恶的信息，他的心坚定，倚靠耶和华。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他的心确定，总不惧怕，直到他看见敌人遭报。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他施舍，周济贫穷，他的义行存到永远，他的角必被高举，大有荣耀。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "恶人看见就愤怒，必咬牙而消亡，恶人的心愿要归于幻灭。",
      "notes": []
    }
  ]
}
