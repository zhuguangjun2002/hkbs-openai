{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 1,
  "heading": "真福",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/1/",
  "verses": [
    {
      "verse": 1,
      "verse_end": 2,
      "text": "不从恶人的计谋，不站罪人的道路，不坐傲慢人的座位，惟喜爱耶和华的律法，昼夜思想他的律法；这人便为有福！",
      "notes": [
        "“思想”或译“默念”。"
      ]
    },
    {
      "verse": 3,
      "text": "他要像一棵树栽在溪水旁，按时候结果子，叶子也不枯干。凡他所做的尽都顺利。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "恶人并不是这样，却像糠秕被风吹散。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "因此，当审判的时候恶人必站立不住，罪人在义人的会众中也是如此。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "因为耶和华知道义人的道路，恶人的道路却必灭亡。",
      "notes": []
    }
  ]
}
