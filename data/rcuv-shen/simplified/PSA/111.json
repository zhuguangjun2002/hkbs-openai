{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 111,
  "heading": "赞美耶和华",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/111/",
  "verses": [
    {
      "verse": 1,
      "text": "哈利路亚！我要在正直人的大会和会众中一心称谢耶和华。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "耶和华的作为本为大，被所有喜爱的人所探寻。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他所做的是尊荣和威严，他的公义存到永远。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他行了奇事，使人记念；耶和华有恩惠，有怜悯。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "他赐粮食给敬畏他的人，他必永远记念他的约。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他向百姓显出大能的作为，将列国赐给他们为业。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他手所做的信实公平，他的训词全然可靠，",
      "notes": []
    },
    {
      "verse": 8,
      "text": "是永永远远坚定的，是按信实正直设立的。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他向百姓施行救赎，颁布他的约，直到永远；他的名圣而可畏。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "敬畏耶和华是智慧的开端，凡遵行他命令的有美好的见识。耶和华是永远当赞美的！",
      "notes": []
    }
  ]
}
