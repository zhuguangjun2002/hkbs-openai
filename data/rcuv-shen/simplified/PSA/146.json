{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 146,
  "heading": "赞美耶和华的救助",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/146/",
  "verses": [
    {
      "verse": 1,
      "text": "哈利路亚！我的心哪，你要赞美耶和华！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "我一生要赞美耶和华！我还活着的时候要歌颂我的神！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "你们不要倚靠君王，不要倚靠世人，他一点也不能帮助。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他的气一断，就归回尘土，他所打算的，当日就消灭了。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "以雅各的神为帮助、仰望耶和华－他神的，这人有福了！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "耶和华造天、地、海和其中的万物，他守信实，直到永远。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他为受欺压的伸冤，赐食物给饥饿的人。耶和华释放被囚的，",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和华开了盲人的眼睛，耶和华扶起被压下的人，耶和华喜爱义人。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "耶和华保护寄居的，扶持孤儿和寡妇，却使恶人的道路弯曲。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "耶和华要作王，直到永远！锡安哪，你的神要作王，直到万代！哈利路亚！",
      "notes": []
    }
  ]
}
