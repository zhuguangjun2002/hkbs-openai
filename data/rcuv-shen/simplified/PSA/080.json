{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 80,
  "heading": "求主复兴国家",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/80/",
  "verses": [
    {
      "verse": 1,
      "text": "领约瑟如领羊群的以色列牧者啊，求你侧耳而听！在基路伯之上坐宝座的啊，求你发出光来！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "在以法莲、便雅悯、玛拿西面前求你施展你的大能，拯救我们。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "神啊，求你使我们回转，使你的脸发光，我们就会得救！",
      "notes": [
        "“回转”或译“复兴”；下同。"
      ]
    },
    {
      "verse": 4,
      "text": "耶和华─万军之神啊，你因你百姓的祷告发怒，要到几时呢？",
      "notes": []
    },
    {
      "verse": 5,
      "text": "你以眼泪当食物给他们吃，量出满碗的眼泪给他们喝。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "你使邻邦因我们纷争，我们的仇敌彼此戏笑。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "万军之神啊，求你使我们回转，使你的脸发光，我们就会得救！",
      "notes": []
    },
    {
      "verse": 8,
      "text": "你从埃及拔出一棵葡萄树，赶出外邦人，把这树栽上。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "你在它面前清除杂物，它就深深扎根，蔓延满地。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "它的影子遮蔽群山，枝子好像高大的香柏树。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "它长出枝子，直到大海，伸展嫩枝，延到大河。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "你为何拆毁这树的篱笆，任凭路人摘取？",
      "notes": []
    },
    {
      "verse": 13,
      "text": "林中的野猪践踏它，田里的走兽吞吃它。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "万军之神啊，求你转回，从天上垂看观察，眷顾这葡萄树；",
      "notes": []
    },
    {
      "verse": 15,
      "text": "保护你右手所栽的根，你为自己所坚固的幼苗。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "这树已经被火焚烧，被刀砍伐，因你脸上的怒容就灭亡了。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "愿你的手扶持你右边的人，你为自己所坚固的人子。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "这样，我们就不背离你；求你救活我们，让我们得以求告你的名。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "耶和华─万军之神啊，求你使我们回转，使你的脸发光，我们就会得救！",
      "notes": []
    }
  ]
}
