{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 137,
  "heading": "被掳的哀歌",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/137/",
  "verses": [
    {
      "verse": 1,
      "text": "我们在巴比伦河边，坐在那里，追想锡安，就哭了。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "在一排柳树中，我们挂上我们的竖琴。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "掳掠我们的在那里要我们唱歌；抢夺我们的要我们为他们作乐：“给我们唱一首锡安的歌吧！”",
      "notes": []
    },
    {
      "verse": 4,
      "text": "我们怎能在外邦之土唱耶和华的歌呢？",
      "notes": []
    },
    {
      "verse": 5,
      "text": "耶路撒冷啊，我若忘记你，宁愿我的右手枯萎；",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我若不记得你，不看你过于我最喜乐的，宁愿我的舌头贴于上膛！",
      "notes": []
    },
    {
      "verse": 7,
      "text": "耶路撒冷攻破的日子，以东人说：“拆毁！拆毁！直拆到根基！”耶和华啊，求你记得！",
      "notes": []
    },
    {
      "verse": 8,
      "text": "将要被灭的巴比伦哪，用你待我们的恶行报复你的，那人有福了。",
      "notes": [
        "“巴比伦”：原文直译“巴比伦女子”。"
      ]
    },
    {
      "verse": 9,
      "text": "抓起你的婴孩摔在磐石上的，那人有福了。",
      "notes": []
    }
  ]
}
