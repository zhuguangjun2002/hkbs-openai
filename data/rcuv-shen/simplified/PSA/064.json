{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 64,
  "heading": "求主保护",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/64/",
  "verses": [
    {
      "verse": 1,
      "text": "神啊，我哀叹的时候，求你听我的声音！求你保护我的性命，不受仇敌的惊吓！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "求你把我隐藏，使我脱离作恶之人的暗谋，脱离作孽之人的扰乱。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他们磨舌如刀，发出苦毒的言语，好像瞄准了的箭，",
      "notes": []
    },
    {
      "verse": 4,
      "text": "要在暗地里射完全人；他们忽然射他，并不惧怕。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "他们彼此勉励，设下恶计；他们商量，暗设圈套，说：“谁能看见呢？”",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他们图谋奸恶：“我们完成了精密的策划。”各人的意念心思是深沉的。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "但神要用箭射他们，他们忽然受了伤。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他们必然绊跌，被自己的舌头所害；凡看见他们的都必摇头。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "众人都要害怕，要传扬神的工作，并且明白他的作为。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "义人必因耶和华欢喜，并要投靠他；凡心里正直的人都必夸耀。",
      "notes": []
    }
  ]
}
