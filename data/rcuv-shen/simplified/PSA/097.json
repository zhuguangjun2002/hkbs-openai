{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 97,
  "heading": "神是最高的统治者",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/97/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华作王！愿地快乐！愿众海岛欢喜！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "密云和幽暗在他四围，公义和公平是他宝座的根基。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "烈火在他前头行，烧灭他四围的敌人。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他的闪电光照世界，大地看见就震动。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "诸山见耶和华的面，就是全地之主的面，就如蜡熔化。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "诸天表明他的公义，万民看见他的荣耀。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "愿所有事奉雕刻偶像、靠虚无神明自夸的，都蒙羞愧。万神哪，你们都当拜他。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和华啊，因你的判断，锡安听见就欢喜；犹大的城镇也都快乐。",
      "notes": [
        "“犹大的城镇”：原文直译“犹大众女子”。"
      ]
    },
    {
      "verse": 9,
      "text": "因为你－耶和华至高，超乎全地；受尊崇，远超万神之上。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "你们爱耶和华的，都当恨恶罪恶；他保护圣民的性命，搭救他们脱离恶人的手。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "散播亮光是为义人，喜乐归于心里正直的人。",
      "notes": [
        "“散播亮光是为义人”：有古卷、七十士译本和其他古译本是“有亮光照耀着义人”。"
      ]
    },
    {
      "verse": 12,
      "text": "义人哪，你们当靠耶和华欢喜，当颂扬他神圣的名字。",
      "notes": [
        "“名字”：原文是“纪念”。"
      ]
    }
  ]
}
