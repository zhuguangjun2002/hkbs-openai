{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 25,
  "heading": "求主指引保护",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/25/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华啊，我的心仰望你。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "我的神啊，我素来倚靠你；求你不要叫我羞愧，不要叫我的仇敌向我夸胜。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "凡等候你的必不羞愧，惟有那无故行奸诈的必要羞愧。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华啊，求你将你的道指示我，将你的路指教我！",
      "notes": []
    },
    {
      "verse": 5,
      "text": "求你指教我，引导我进入你的真理，因为你是救我的神。我整日等候你。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "耶和华啊，求你记念你的怜悯和慈爱，因为这是亘古以来所常有的。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "求你不要记得我幼年的罪愆和我的过犯；耶和华啊，求你因你的良善，按你的慈爱记念我。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和华是良善正直的，因此，他必教导罪人走正路。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他要按公平引领谦卑人，将他的道指教他们。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "凡遵守他的约和他法度的人，耶和华都以慈爱信实待他。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "耶和华啊，求你因你名的缘故赦免我的罪，因我的罪重大。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "谁敬畏耶和华，耶和华必教导他当选择的道路。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "他要安然居住，他的后裔必承受土地。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "耶和华与敬畏他的人亲密，他要将自己的约指示他们。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "我的眼目时常仰望耶和华，因他必将我的脚从网里拉出来。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "求你转向我，怜悯我，因我孤独困苦。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "我心里愁苦甚多，求你救我脱离我的祸患。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "求你看顾我的困苦、我的艰难，赦免我一切的罪。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "求你察看我的仇敌，因为他们人数众多，并且痛恨我。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "求你保护我的性命，搭救我，使我不致羞愧，因为我投靠你。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "愿纯全、正直保护我，因为我等候你。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "神啊，求你救赎以色列脱离他一切的愁苦。",
      "notes": []
    }
  ]
}
