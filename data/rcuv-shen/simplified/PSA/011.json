{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 11,
  "heading": "在主里得安稳",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/11/",
  "verses": [
    {
      "verse": 1,
      "text": "我投靠耶和华；你们怎么对我说：“你当像鸟逃到你们的山去；",
      "notes": []
    },
    {
      "verse": 2,
      "text": "看哪，恶人弯弓，把箭搭在弦上，要在暗中射那心里正直的人。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "根基若毁坏，义人还能做什么呢？”",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华在他的圣殿里，耶和华在天上的宝座上；他的眼睛察看，他的眼目察验世人。",
      "notes": [
        "“眼目”：原文是“眼皮”。"
      ]
    },
    {
      "verse": 5,
      "text": "耶和华考验义人；惟有恶人和喜爱暴力的人，他心里恨恶。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他要向恶人密布罗网，烈火、硫磺、热风作他们杯中的份。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "因为耶和华是公义的，他喜爱义行，正直人必得见他的面。",
      "notes": []
    }
  ]
}
