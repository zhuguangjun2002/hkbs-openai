{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 98,
  "heading": "神掌管世界",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/98/",
  "verses": [
    {
      "verse": 1,
      "text": "你们要向耶和华唱新歌！因为他行过奇妙的事，他的右手和圣臂施行救恩。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "耶和华显明了他的救恩，在列国眼前显出公义；",
      "notes": []
    },
    {
      "verse": 3,
      "text": "记念他对以色列家的慈爱和信实。地的四极都看见我们神的救恩。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "全地都要向耶和华欢呼，要扬声，欢唱，歌颂！",
      "notes": []
    },
    {
      "verse": 5,
      "text": "用琴歌颂耶和华，用琴和诗歌的声音歌颂他！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "用号筒和角声，在大君王耶和华面前欢呼！",
      "notes": []
    },
    {
      "verse": 7,
      "text": "愿海和其中所充满的澎湃，愿世界和住在其间的发声。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "愿大水拍掌，愿诸山在耶和华面前一同欢呼；",
      "notes": []
    },
    {
      "verse": 9,
      "text": "因为他来要审判全地。他要按公义审判世界，按公正审判万民。",
      "notes": []
    }
  ]
}
