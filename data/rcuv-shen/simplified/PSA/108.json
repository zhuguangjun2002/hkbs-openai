{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 108,
  "heading": "抗敌求助",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/108/",
  "verses": [
    {
      "verse": 1,
      "text": "神啊，我心坚定；我口要唱诗歌颂！",
      "notes": [
        "“口”：原文是“荣耀”。"
      ]
    },
    {
      "verse": 2,
      "text": "琴瑟啊，当醒起！我要唤起曙光！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "耶和华啊，我要在万民中称谢你，在万族中歌颂你！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "因为你的慈爱大过诸天，你的信实达到穹苍。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "神啊，愿你崇高过于诸天！愿你的荣耀高过全地！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "求你应允我，用右手施行拯救，好让你所亲爱的人得救。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "神在他的圣所说：“我要欢乐；要划分示剑，丈量疏割谷。",
      "notes": [
        "“在他的圣所”或译“指着他的圣洁”。"
      ]
    },
    {
      "verse": 8,
      "text": "基列是我的，玛拿西是我的，以法莲是护卫我头的，犹大是我的权杖。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "摩押是我的沐浴盆，我要向以东扔鞋，我必因胜非利士而欢呼。”",
      "notes": []
    },
    {
      "verse": 10,
      "text": "谁能领我进坚固城？谁能引我到以东地？",
      "notes": []
    },
    {
      "verse": 11,
      "text": "神啊，你真的丢弃了我们吗？神啊，你不和我们的军队同去吗？",
      "notes": []
    },
    {
      "verse": 12,
      "text": "求你帮助我们攻击敌人，因为人的帮助是枉然的。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "我们倚靠神才得施展大能，因为践踏我们敌人的就是他。",
      "notes": []
    }
  ]
}
