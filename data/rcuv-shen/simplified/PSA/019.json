{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 19,
  "heading": "造化的荣耀",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/19/",
  "verses": [
    {
      "verse": 1,
      "text": "诸天述说神的荣耀，穹苍传扬他手的作为。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "这日到那日发出言语，这夜到那夜传出知识。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "无言无语，也无声音可听。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "它们的声浪传遍天下，它们的言语传到地极。神在其中为太阳安设帐幕，",
      "notes": [
        "“声浪”：原文是“绳索”。"
      ]
    },
    {
      "verse": 5,
      "text": "太阳如同新郎步出洞房，又如勇士欢然奔路。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "它从天这边出来，绕到天那边，没有一物可隐藏得不到它的热气。",
      "notes": []
    },
    {
      "verse": 7,
      "section_headings": [
        "耶和华的律法"
      ],
      "text": "耶和华的律法全备，使人苏醒；耶和华的法度确定，使愚蒙人有智慧。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和华的训词正直，使人心快活；耶和华的命令清洁，使人眼目明亮。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "耶和华的典章真实，全然公义，敬畏耶和华是纯洁的，存到永远，",
      "notes": []
    },
    {
      "verse": 10,
      "text": "比金子可羡慕，比极多的纯金可羡慕；比蜜甘甜，比蜂房下滴的蜜甘甜。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "因此你的仆人受警戒，遵守这些有极大的赏赐。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "谁能察觉自己的错失呢？求你赦免我隐藏的过犯。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "求你拦阻仆人不犯任意妄为的罪，不容这罪辖制我，我就完全，免犯大罪。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "耶和华－我的磐石，我的救赎主啊，愿我口中的言语，心里的意念在你面前蒙悦纳。",
      "notes": []
    }
  ]
}
