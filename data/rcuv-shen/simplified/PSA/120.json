{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 120,
  "heading": "求主恩助",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/120/",
  "verses": [
    {
      "verse": 1,
      "text": "我在急难中求告耶和华，他就应允我。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "耶和华啊，求你救我脱离说谎的嘴唇和诡诈的舌头！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "诡诈的舌头啊，他会给你什么呢？会加给你什么呢？",
      "notes": []
    },
    {
      "verse": 4,
      "text": "就是勇士的利箭、罗腾木的炭火。",
      "notes": [
        "“罗腾木”为小树名，松类。"
      ]
    },
    {
      "verse": 5,
      "text": "祸哉！我寄居在米设，住在基达帐棚之中。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我与那恨恶和平的人许久同住。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "我愿和平，当我发言，他们却要战争。",
      "notes": []
    }
  ]
}
