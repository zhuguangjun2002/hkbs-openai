{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 104,
  "heading": "造化主颂",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/104/",
  "verses": [
    {
      "verse": 1,
      "text": "我的心哪，你要称颂耶和华！耶和华－我的神啊，你为至大！你以尊荣威严为衣，",
      "notes": []
    },
    {
      "verse": 2,
      "text": "披上亮光，如披外袍，铺张穹苍，如铺幔子，",
      "notes": []
    },
    {
      "verse": 3,
      "text": "在水中立楼阁的栋梁，用云彩为车辇，藉着风的翅膀而行，",
      "notes": []
    },
    {
      "verse": 4,
      "text": "以风为使者，以火焰为仆役，",
      "notes": []
    },
    {
      "verse": 5,
      "text": "将地立在根基上，使地永不动摇。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "你用深水遮盖地面，犹如衣裳；诸水高过山岭。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "你的斥责一发，水就奔逃；你的雷声一发，水就奔流。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "诸山上升，诸谷下沉，归你为它所立定之地。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "你定了界限，使水不能超越，不再转回淹没大地。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "耶和华使泉源涌在山谷，流在山间，",
      "notes": []
    },
    {
      "verse": 11,
      "text": "使野地的走兽有水喝，野驴得解其渴。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "天上的飞鸟在水旁住宿，在枝干间啼叫。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "他从楼阁中浇灌山岭；因他作为的功效，地就丰足。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "他使草生长，给牲畜吃，使菜蔬生长，供给人用，使人从地里得食物，",
      "notes": [
        "“使菜蔬...用”或译“使人耕种而长菜蔬”。"
      ]
    },
    {
      "verse": 15,
      "text": "得酒能悦人心，得油能润人面，得粮能养人心。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "佳美的树木，就是耶和华所栽种的黎巴嫩的香柏树，都满了汁浆。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "雀鸟在其上搭窝，鹳以松树为家。",
      "notes": [
        "“松树”：原文另译“树顶”。"
      ]
    },
    {
      "verse": 18,
      "text": "高山为野山羊的居所，岩石为石獾的藏身处。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "你安置月亮以定季节，太阳自知沉落。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "你造黑暗为夜，林中的百兽就都爬出来。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "少壮狮子吼叫觅食，向神寻求食物。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "太阳一出，兽就躲避，躺卧在洞里。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "人出去做工，劳碌直到晚上。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "耶和华啊，你所造的何其多！都是你用智慧造成的，全地遍满了你所造之物。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "那里有海，又大又广，其中有无数的动物，大小活物都有。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "那里有船行走，有你所造的力威亚探悠游在其中。",
      "notes": [
        "“力威亚探”是音译，一种海兽。"
      ]
    },
    {
      "verse": 27,
      "text": "这些都仰望你按时给它们食物。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "你给它们，它们就拾起来；你张手，它们就饱得美食。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "你转脸，它们就惊惶；你收回它们的气，它们就死亡，归于尘土。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "你差遣你的灵，它们就受造；你使地面更换为新。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "愿耶和华的荣耀存到永远！愿耶和华喜爱自己所造的！",
      "notes": []
    },
    {
      "verse": 32,
      "text": "他看地，地便震动；他摸山，山就冒烟。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "我一生要向耶和华唱诗！我还活的时候，要向我的神歌颂！",
      "notes": []
    },
    {
      "verse": 34,
      "text": "愿他悦纳我的默念！我要因耶和华欢喜！",
      "notes": []
    },
    {
      "verse": 35,
      "text": "愿罪人从世上消灭！愿恶人归于无有！我的心哪，你要称颂耶和华！哈利路亚！",
      "notes": [
        "“哈利路亚”意思是“你们要赞美耶和华”；下同。"
      ]
    }
  ]
}
