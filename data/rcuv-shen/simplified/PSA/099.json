{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 99,
  "heading": "神是至高之王",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/99/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华作王，万民当战抖！他坐在基路伯的宝座上，地当动摇。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "耶和华在锡安为大，他超越万民之上。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "愿他们颂扬他大而可畏的名，他本为圣！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "喜爱公平、大能的王啊，你坚立公正，在雅各中施行公平和公义。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "当尊崇耶和华－我们的神，在他脚凳前下拜。他本为圣！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "在他的祭司中有摩西和亚伦，在求告他名的人中有撒母耳。他们求告耶和华，他就应允他们。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他在云柱中向他们说话，他们遵守他的法度和他所赐给他们的律例。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和华－我们的神啊，你应允了他们；你是赦免他们的神，却按他们所做的报应他们。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "当尊崇耶和华－我们的神，在他的圣山下拜，因为耶和华－我们的神本为圣！",
      "notes": []
    }
  ]
}
