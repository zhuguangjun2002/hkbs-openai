{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 47,
  "heading": "至高的主宰",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/47/",
  "verses": [
    {
      "verse": 1,
      "text": "万民哪，你们都要鼓掌！用欢呼的声音向神呼喊！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "因为耶和华至高者是可畏的，他是治理全地的大君王。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他使万民服在我们以下，又使万族服在我们脚下。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他为我们选择产业，就是他所爱之雅各的荣耀。（细拉）",
      "notes": []
    },
    {
      "verse": 5,
      "text": "神上升，有喊声相送；耶和华上升，有角声相送。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "你们要向神歌颂，歌颂！向我们的王歌颂，歌颂！",
      "notes": []
    },
    {
      "verse": 7,
      "text": "因为神是全地的王，你们要用圣诗歌颂！",
      "notes": []
    },
    {
      "verse": 8,
      "text": "神作王治理列国，神坐在他的圣宝座上。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "万民的君王聚集，要作亚伯拉罕的神的子民，因为地上的盾牌是属神的，他为至高！",
      "notes": []
    }
  ]
}
