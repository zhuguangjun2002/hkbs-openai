{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 87,
  "heading": "锡安颂",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/87/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华所立的根基在圣山上。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "耶和华爱锡安的门，胜于爱雅各一切的住处。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "神的城啊，有荣耀的事是指着你说的。（细拉）",
      "notes": []
    },
    {
      "verse": 4,
      "text": "我要提起拉哈伯和巴比伦人，是在认识我之中的；看哪，非利士、推罗和古实人，个个生在那里。",
      "notes": [
        "“拉哈伯”是神话故事中的大海怪。"
      ]
    },
    {
      "verse": 5,
      "text": "论到锡安，必有话说：“这一个、那一个都生在其中”；而且至高者必亲自坚立这城。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "当耶和华记录万民的时候，他要写出人的出生地。（细拉）",
      "notes": []
    },
    {
      "verse": 7,
      "text": "歌唱的、跳舞的，都要说：“我的泉源都在你里面。”",
      "notes": [
        "本节七十士译本是“他们都以住在你里面为乐。”"
      ]
    }
  ]
}
