{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 72,
  "heading": "为王祈祷",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/72/",
  "verses": [
    {
      "verse": 1,
      "text": "神啊，求你将你的公平赐给王，将你的公义赐给王的儿子。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "使他按公义审判你的子民，按公平审判你的困苦人。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "大山小山都要因公义使百姓得享平安。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他必为百姓中困苦的人伸冤，拯救贫穷之辈，压碎那欺压人的人。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "太阳还存，月亮犹在，人要敬畏你，直到万代！",
      "notes": [
        "“人要敬畏你”：七十士译本是“愿他永活”。"
      ]
    },
    {
      "verse": 6,
      "text": "他必降临，像雨降在已割的草地上，如甘霖滋润田地。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "在他的日子，公义要兴旺，大有平安，除非月亮不在。",
      "notes": [
        "“公义”：有古卷是“义人”。"
      ]
    },
    {
      "verse": 8,
      "text": "他要执掌权柄，从这海直到那海，从大河直到地极。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "住在旷野的必在他面前下拜，他的仇敌必要舔土。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "他施和海岛的王要进贡，示巴和西巴的王要献礼物。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "众王都要叩拜他，万国都要事奉他。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "贫穷人呼求，他要搭救，无人帮助的困苦人，他也搭救。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "他要怜悯贫寒和贫穷的人，拯救贫穷人的性命。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "他要救赎他们脱离欺压和残暴，他们的血在他眼中看为宝贵。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "愿他永远活着，示巴的金子要献给他；愿人常常为他祷告，终日祝福他。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "在地的山顶上，愿五谷茂盛，所结的谷实响动，如黎巴嫩的树林；愿城里的人兴旺，如地上的草。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "愿他的名存到永远，他的名如太阳之长久；愿人因他蒙福，万国称他为有福。",
      "notes": [
        "“长久”：原文另译“坚定”或“延续”。"
      ]
    },
    {
      "verse": 18,
      "text": "惟独耶和华－以色列的神能行奇事，他是应当称颂的！",
      "notes": []
    },
    {
      "verse": 19,
      "text": "他荣耀的名也当称颂，直到永远。愿他的荣耀充满全地！阿们！阿们！",
      "notes": []
    },
    {
      "verse": 20,
      "text": "耶西的儿子－大卫的祈祷完毕。",
      "notes": []
    }
  ]
}
