{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 125,
  "heading": "耶和华子民的安全",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/125/",
  "verses": [
    {
      "verse": 1,
      "text": "倚靠耶和华的人好像锡安山，安稳坐镇，永不动摇。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "众山怎样围绕耶路撒冷，耶和华也照样围绕他的百姓，从今时直到永远。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "恶人的杖必不在义人的土地上停留，免得义人伸手作恶。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华啊，求你善待行善和心里正直的人。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "至于那偏行弯曲道路的人，耶和华必将他们和作恶的人一同驱逐出去。愿平安归于以色列！",
      "notes": []
    }
  ]
}
