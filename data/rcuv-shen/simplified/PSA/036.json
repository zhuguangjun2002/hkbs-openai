{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 36,
  "heading": "人的邪恶",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/36/",
  "verses": [
    {
      "verse": 1,
      "text": "过犯在恶人的心底向他说话，他的眼中不怕神。",
      "notes": [
        "“过犯...说话”是根据一些古卷和七十士译本；原文是“过犯在我的心底向恶人说话”。"
      ]
    },
    {
      "verse": 2,
      "text": "他自夸自媚，以致罪孽无法察觉，不被恨恶。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他口中的言语尽是罪孽诡诈，他不再有智慧，也不再行善。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他在床上图谋罪孽，定意行不善的道，不憎恶恶事。",
      "notes": []
    },
    {
      "verse": 5,
      "section_headings": [
        "神的良善"
      ],
      "text": "耶和华啊，你的慈爱上及诸天，你的信实达到穹苍，",
      "notes": []
    },
    {
      "verse": 6,
      "text": "你的公义好像高山，你的判断如同深渊；耶和华啊，人民、牲畜，你都救护。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "神啊，你的慈爱何其宝贵！世人投靠在你翅膀的荫下。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他们必因你殿里的丰盛得以饱足，你也必叫他们喝你那喜乐的泉水。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "因为在你那里有生命的泉源，在你的光中，我们必得见光。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "愿你常施慈爱给认识你的人，常以公义待心里正直的人。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "不容骄傲人的脚践踏我，不容凶恶人的手赶逐我。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "在那里，作恶的人已经仆倒；他们被推倒，不能再起来。",
      "notes": []
    }
  ]
}
