{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 29,
  "heading": "耶和华威严的声音",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/29/",
  "verses": [
    {
      "verse": 1,
      "text": "神的子民哪，你们要将荣耀、能力归给耶和华，都归给耶和华！",
      "notes": [
        "“神的子民”或译“强有力的”或“诸神”。"
      ]
    },
    {
      "verse": 2,
      "text": "要将耶和华的名的荣耀归给他，要敬拜神圣荣耀的耶和华。",
      "notes": [
        "“要敬拜...耶和华”或译“以圣洁的妆饰敬拜耶和华”。"
      ]
    },
    {
      "verse": 3,
      "text": "耶和华的声音在众水上，荣耀的神打雷；耶和华打雷在大水之上。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华的声音大有能力，耶和华的声音满有威严。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "耶和华的声音震碎香柏树，耶和华震碎黎巴嫩的香柏树。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他使黎巴嫩跳跃如牛犊，使西连跳跃如野牛犊。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "耶和华的声音使火焰分岔。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和华的声音震动旷野，耶和华震动加低斯的旷野。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "耶和华的声音惊动母鹿落胎，树林也脱落净光。凡在他殿中的，都述说他的荣耀。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "耶和华坐在洪水之上为王；耶和华坐着为王，直到永远。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "耶和华必赐力量给他的百姓，耶和华必赐平安的福给他的百姓。",
      "notes": []
    }
  ]
}
