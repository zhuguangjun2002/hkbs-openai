{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 140,
  "heading": "求耶和华护佑",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/140/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华啊，求你救我脱离邪恶的人，保护我脱离残暴的人！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "他们心中图谋奸恶，日日不停挑起战争。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他们的舌头锐利如蛇，嘴唇里有毒蛇的毒液。（细拉）",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华啊，求你庇护我脱离恶人的手，保护我脱离残暴的人，他们想要推倒我。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "骄傲的人为我暗设罗网和绳索；他们在路旁张开网，为我设下圈套。（细拉）",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我曾对耶和华说：“你是我的神。”耶和华啊，求你侧耳听我恳求的声音！",
      "notes": []
    },
    {
      "verse": 7,
      "text": "主－耶和华、我救恩的力量啊，在战争的日子，你遮蔽了我的头。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和华啊，求你不要遂恶人的心愿；不要成就他们的计谋，免得他们自高。（细拉）",
      "notes": []
    },
    {
      "verse": 9,
      "text": "至于那些昂首围困我的人，愿他们嘴唇的奸恶陷害自己！",
      "notes": [
        "“陷害”：原文是“遮蔽”。"
      ]
    },
    {
      "verse": 10,
      "text": "愿他们被丢在火中，火炭落在他们身上；愿他们被抛在深坑里，不能再起来！",
      "notes": []
    },
    {
      "verse": 11,
      "text": "愿说恶言的人在地上站立不住；愿祸患猎取残暴的人，把他打倒。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "我知道耶和华必为困苦人伸冤，为贫穷人辩护。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "义人必颂扬你的名，正直人要在你面前居住。",
      "notes": []
    }
  ]
}
