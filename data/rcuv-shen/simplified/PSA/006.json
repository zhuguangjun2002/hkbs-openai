{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 6,
  "heading": "患难中求助的祈祷",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/6/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华啊，求你不要在怒中责备我，不要在烈怒中惩罚我！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "耶和华啊，求你怜悯我，因为我软弱。耶和华啊，求你医治我，因为我的骨头战抖。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "我的心也大大惊惶。耶和华啊，你要等到几时呢？",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华啊，求你转回搭救我，因你的慈爱拯救我。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "因为死了的人不会记念你，在阴间有谁称谢你？",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我因呻吟而困乏；我每夜流泪，使床铺漂起，把褥子湿透。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "我的眼睛因忧愁而昏花，因敌人的缘故，我的眼目模糊不清。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "你们所有作恶的人，离开我吧！因为耶和华听了我哀哭的声音。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "耶和华听了我的恳求，耶和华必接纳我的祷告。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "我所有的仇敌都必羞愧，大大惊惶；转眼之间，他们要羞愧撤退。",
      "notes": []
    }
  ]
}
