{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 10,
  "heading": "为公义而祈祷",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/10/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华啊，你为什么站在远处？在患难的时候为什么隐藏？",
      "notes": []
    },
    {
      "verse": 2,
      "text": "恶人骄横地追逼困苦人；愿他们陷在自己所设的计谋里。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "因为恶人以自己的心愿自夸，贪财的背弃耶和华，并且轻慢他。",
      "notes": [
        "“贪财的...轻慢他”或译“他称赞贪财的，却轻慢耶和华”。"
      ]
    },
    {
      "verse": 4,
      "text": "恶人面带骄傲，不寻找耶和华；他的思想中全无神。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "他的路时常亨通，你的审判不在他眼里。至于他所有的敌人，他都向他们发怒气。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他心里说：“我必不动摇，世世代代不遭灾难。”",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他满口咒骂、诡诈、欺压，舌底尽是毒害、奸恶。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他在村庄埋伏等候，在隐密处杀害无辜的人，他的眼睛窥探无倚无靠的人。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他埋伏在暗地，如狮子蹲在洞中。他埋伏，要俘掳困苦人；他拉网，就把困苦人掳去。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "他屈身蹲伏，无倚无靠的人就倒在他的暴力之下。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "他心里说：“神竟忘记了，神转脸永不观看。”",
      "notes": []
    },
    {
      "verse": 12,
      "text": "耶和华啊，求你兴起！神啊，求你举手！不要忘记困苦人！",
      "notes": []
    },
    {
      "verse": 13,
      "text": "恶人为何轻慢神，心里说“你必不追究”？",
      "notes": []
    },
    {
      "verse": 14,
      "text": "你已经察看，顾念人的忧患和愁苦，放在你的手中。无倚无靠的人把自己交托给你，你向来是帮助孤儿的。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "求你打断恶人的膀臂，至于坏人，求你追究他的恶，直到净尽。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "耶和华永永远远为王，外邦人从他的地已经灭绝了。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "耶和华啊，困苦人的心愿你早已听见；你必坚固他们的心，也必侧耳听他们的祈求，",
      "notes": []
    },
    {
      "verse": 18,
      "text": "为要给孤儿和受欺压的人伸冤，使世上的人不再威吓他们。",
      "notes": []
    }
  ]
}
