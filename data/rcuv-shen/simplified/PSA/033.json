{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 33,
  "heading": "颂赞之歌",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/33/",
  "verses": [
    {
      "verse": 1,
      "text": "义人哪，你们当因耶和华欢呼，正直人理当赞美耶和华。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "你们要弹琴称谢耶和华，用十弦瑟歌颂他。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "应当向他唱新歌，弹得巧妙，声音洪亮。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "因为耶和华的言语正直，他的作为尽都信实。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "他喜爱公义和公平，遍地满了耶和华的慈爱。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "诸天藉耶和华的话而造，万象藉他口中的气而成。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他聚集海水如垒，收藏深洋在仓库。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "愿全地都敬畏耶和华！愿世上的居民都惧怕他！",
      "notes": []
    },
    {
      "verse": 9,
      "text": "因为他说有，就有，命立，就立。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "耶和华使列国的筹算归于无有，使万民的计谋全无功效。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "耶和华的筹算永远立定，他心中的计划万代长存。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "以耶和华为神的，那国有福了！耶和华拣选为自己产业的，那民有福了！",
      "notes": []
    },
    {
      "verse": 13,
      "text": "耶和华从天上观看，看见所有的人，",
      "notes": []
    },
    {
      "verse": 14,
      "text": "从他的居所察看地上每一个居民，",
      "notes": []
    },
    {
      "verse": 15,
      "text": "他塑造他们的心，洞察他们一切的作为。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "君王不能因兵多得胜，勇士不能因力大得救。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "靠马得救是枉然的，马也不能因力大救人。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "看哪，耶和华的眼目看顾敬畏他的人和仰望他慈爱的人，",
      "notes": []
    },
    {
      "verse": 19,
      "text": "要救他们的性命脱离死亡，使他们在饥荒中存活。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "我们的心向来等候耶和华；他是我们的帮助，是我们的盾牌。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "我们的心必靠他欢喜，因为我们向来倚靠他的圣名。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "耶和华啊，求你照着我们所仰望你的，向我们施行慈爱！",
      "notes": []
    }
  ]
}
