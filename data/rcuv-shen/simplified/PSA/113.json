{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 113,
  "heading": "赞美耶和华的良善",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/113/",
  "verses": [
    {
      "verse": 1,
      "text": "哈利路亚！耶和华的仆人哪，你们要赞美，赞美耶和华的名！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "耶和华的名是应当称颂的，从今时直到永远！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "从日出之地到日落之处，耶和华的名是应当赞美的！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华超乎万国之上，他的荣耀高过诸天。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "谁像耶和华－我们的神呢？他坐在至高之处，",
      "notes": []
    },
    {
      "verse": 6,
      "text": "自己谦卑，观看天上地下的事。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他从灰尘里抬举贫寒的人，从粪堆中提拔贫穷的人，",
      "notes": []
    },
    {
      "verse": 8,
      "text": "使他们与贵族同坐，与本国的贵族同坐。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他使不孕的妇女安居家中，成为快乐的母亲，儿女成群。哈利路亚！",
      "notes": []
    }
  ]
}
