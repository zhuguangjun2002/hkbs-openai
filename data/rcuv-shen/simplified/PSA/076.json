{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 76,
  "heading": "神是胜利者",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/76/",
  "verses": [
    {
      "verse": 1,
      "text": "在犹大，神为人所认识；在以色列，他的名为大。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "在撒冷有他的住处，在锡安有他的居所。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他在那里折断弓上的火箭、盾牌、刀剑和战争的兵器。（细拉）",
      "notes": []
    },
    {
      "verse": 4,
      "text": "你是光荣的，比猎物之山更威严。",
      "notes": [
        "“猎物”：七十士译本是“永恒”。"
      ]
    },
    {
      "verse": 5,
      "text": "心中勇敢的人都被掠夺；他们睡了长觉，没有一个英雄能措手。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "雅各的神啊，你的斥责一发，战车和战马都沉睡了。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "你，惟独你是可畏的！你的怒气一发，谁能在你面前站得住呢？",
      "notes": []
    },
    {
      "verse": 8,
      "verse_end": 9,
      "text": "你从天上使人听判断。神起来施行审判，要救地上所有困苦的人；那时地就惧怕而静默。（细拉）",
      "notes": []
    },
    {
      "verse": 10,
      "text": "人的愤怒终必称谢你，你要以人的余怒束腰。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "你们当向耶和华－你们的神许愿，还愿；在他四围的人都当拿贡物献给那可畏的主。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "他要挫折王子的骄气，向地上的君王显为可畏。",
      "notes": []
    }
  ]
}
