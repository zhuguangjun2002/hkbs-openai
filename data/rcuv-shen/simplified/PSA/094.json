{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 94,
  "heading": "神审判万人",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/94/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华啊，你是伸冤的神；伸冤的神啊，求你发出光来！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "审判世界的主啊，求你挺身而立，使骄傲的人受应得的报应！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "耶和华啊，恶人夸胜要到几时呢？要到几时呢？",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他们咆哮，说狂妄的话，作恶的人全都夸耀自己。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "耶和华啊，他们强压你的百姓，苦害你的产业。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他们杀死寡妇和寄居的人，又杀害孤儿。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他们说：“耶和华必不看见，雅各的神必不留意。”",
      "notes": []
    },
    {
      "verse": 8,
      "text": "百姓中像畜牲一般的人当思想，你们愚昧人要到几时才有智慧呢？",
      "notes": []
    },
    {
      "verse": 9,
      "text": "造耳朵的，难道自己听不见吗？造眼睛的，难道自己看不见吗？",
      "notes": []
    },
    {
      "verse": 10,
      "text": "管教列国的，就是叫人得知识的，难道自己不惩治人吗？",
      "notes": []
    },
    {
      "verse": 11,
      "text": "耶和华知道人的意念是虚妄的。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "耶和华啊，你所管教、用律法教导的人有福了！",
      "notes": []
    },
    {
      "verse": 13,
      "text": "你使他在遭难的日子仍得平安，直到为恶人挖好了坑。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "因为耶和华必不丢弃他的百姓，也不离弃他的产业。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "审判要回复公义，心里正直的，都必跟随它。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "谁肯为我起来攻击邪恶的？谁肯为我站起抵挡作恶的？",
      "notes": []
    },
    {
      "verse": 17,
      "text": "若不是耶和华帮助我，我早就住在寂静之中了。",
      "notes": [
        "“寂静”就是“死亡”。"
      ]
    },
    {
      "verse": 18,
      "text": "我若说：“我失了脚！”耶和华啊，你的慈爱必扶持我。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "我心里多忧多疑，你的安慰使我欢乐。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "那藉着律例玩弄奸恶、以权位肆行残害的，岂能与你交往呢？",
      "notes": []
    },
    {
      "verse": 21,
      "text": "他们大家聚集攻击义人，将无辜的人定了死罪。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "但耶和华向来作我的碉堡，我的神作了我投靠的磐石。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "他叫他们的罪孽归到自己身上，要因他们的邪恶剪除他们；耶和华－我们的神要把他们剪除。",
      "notes": []
    }
  ]
}
