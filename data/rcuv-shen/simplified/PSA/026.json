{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 26,
  "heading": "义人的祈祷",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/26/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华啊，求你为我伸冤，因我向来行事纯正；我倚靠耶和华，必不动摇。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "耶和华啊，求你察看我，考验我，熬炼我的肺腑心肠。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "因为你的慈爱常在我眼前，我也按你的真理而行。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "我未曾与虚妄的人同坐，也不与伪善的人来往。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "我痛恨恶人的集会，必不与恶人同坐。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "耶和华啊，我要洗手表明无辜，才环绕你的祭坛；",
      "notes": []
    },
    {
      "verse": 7,
      "text": "我好发出称谢的声音，述说你一切奇妙的作为。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和华啊，我喜爱你所住的殿和你显荣耀的居所。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "不要把我的性命和罪人一同除掉，不要把我的生命和好流人血的一同除掉。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "他们的手中有奸恶，他们的右手满有贿赂。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "至于我，却要行事纯正；求你救赎我，怜悯我！",
      "notes": []
    },
    {
      "verse": 12,
      "text": "我的脚站在平坦的地方，在聚会中我要称颂耶和华！",
      "notes": []
    }
  ]
}
