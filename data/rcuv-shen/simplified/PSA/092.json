{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 92,
  "heading": "颂赞之诗",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/92/",
  "verses": [
    {
      "verse": 1,
      "text": "这是多么好啊！称谢耶和华，歌颂你至高者的名，",
      "notes": []
    },
    {
      "verse": 2,
      "text": "早晨传扬你的慈爱，每夜传扬你的信实。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "用十弦的乐器和瑟，用琴优雅的声音；",
      "notes": []
    },
    {
      "verse": 4,
      "text": "因你－耶和华藉着你的作为使我高兴，我要因你手的工作欢呼。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "耶和华啊，你的工作何其大！你的心思极其深！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "畜牲一般的人不晓得，愚昧人也不明白。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "恶人虽茂盛如草，作恶的人虽全都兴旺，他们却要灭亡，直到永远。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和华啊，惟有你是至高，直到永远。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "耶和华啊，看哪，你的仇敌，看哪，你的仇敌都要灭亡；作恶的全都要离散。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "你却高举了我的角，如野牛的角；我是被新油膏抹的。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "我的眼睛看见我的仇敌遭报，我的耳朵听见那些起来攻击我的恶人受罚。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "义人要兴旺如棕树，生长如黎巴嫩的香柏树。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "他们栽于耶和华的殿中，发旺在我们神的院里。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "他们发白的时候仍结果子，而且鲜美多汁，",
      "notes": []
    },
    {
      "verse": 15,
      "text": "好显明耶和华是正直的；他是我的磐石，在他毫无不义。",
      "notes": []
    }
  ]
}
