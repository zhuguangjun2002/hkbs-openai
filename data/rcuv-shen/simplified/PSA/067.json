{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 67,
  "heading": "感恩的诗",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/67/",
  "verses": [
    {
      "verse": 1,
      "text": "愿神怜悯我们，赐福给我们，使他的脸向我们发光，（细拉）",
      "notes": []
    },
    {
      "verse": 2,
      "text": "好让全地得知你的道路，万国得知你的救恩。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "神啊，愿万民称谢你！愿万民都称谢你！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "愿万族都快乐欢呼；因为你必按公正审判万民，引导地上的万族。（细拉）",
      "notes": []
    },
    {
      "verse": 5,
      "text": "神啊，愿万民称谢你！愿万民都称谢你！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "地已经出了土产，神，我们的神，要赐福给我们。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "神要赐福给我们，地的四极都要敬畏他！",
      "notes": []
    }
  ]
}
