{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 74,
  "heading": "求主解救国家",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/74/",
  "verses": [
    {
      "verse": 1,
      "text": "神啊，你为何永远丢弃我们呢？为何向你草场的羊发怒，如烟冒出呢？",
      "notes": []
    },
    {
      "verse": 2,
      "text": "求你记念你古时得来的会众，就是你所赎、作你产业支派的，并记念你向来居住的锡安山。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "求你举步去看那日久荒凉之地，看仇敌在圣所中所做的一切恶事。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "你的敌人在你会中吼叫，他们竖起自己的标帜为记号，",
      "notes": []
    },
    {
      "verse": 5,
      "text": "好像人扬起斧子对着林中的树，",
      "notes": [
        "“好像人扬起斧子”：七十士译本和其他古译本是“好像斧子在入口处”。"
      ]
    },
    {
      "verse": 6,
      "text": "现在将圣所中的雕刻，全都用斧子锤子打坏。",
      "notes": [
        "“雕刻”：七十士译本是“门扉”。"
      ]
    },
    {
      "verse": 7,
      "text": "他们用火焚烧你的圣所，亵渎你名的居所于地。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他们心里说“我们要尽行毁灭”；就在遍地烧毁敬拜神聚会的所在。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "我们看不见自己的标帜，不再有先知，我们当中也无人知道这灾祸要到几时。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "神啊，敌人辱骂要到几时呢？仇敌藐视你的名要到永远吗？",
      "notes": []
    },
    {
      "verse": 11,
      "text": "你为什么缩回你的右手？求你从怀中伸出手来，毁灭他们。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "神自古以来是我的王，在这地上施行拯救。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "你曾用能力将海分开，你打破水里大鱼的头。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "你曾压碎力威亚探的头，把它给旷野的禽兽作食物。",
      "notes": [
        "“力威亚探”是音译，一种海兽。"
      ]
    },
    {
      "verse": 15,
      "text": "你曾分裂泉源和溪流；使长流的江河枯干。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "白昼属你，黑夜也属你；亮光和太阳是你预备的。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "地的一切疆界是你立的，夏天和冬天是你定的。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "耶和华啊，仇敌辱骂，愚顽之辈藐视你的名；求你记念这事。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "不要将属你的斑鸠交给野兽，不要永远忘记你困苦人的性命。",
      "notes": [
        "“斑鸠”：七十士译本和其他古译本是“赞美”。"
      ]
    },
    {
      "verse": 20,
      "text": "求你顾念所立的约，因为地上黑暗之处遍满了凶暴。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "不要让受欺压的人蒙羞回去；要使困苦贫穷的人赞美你的名。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "神啊，求你起来为自己辩护！求你记念愚顽人怎样终日辱骂你。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "不要忘记你敌人的喧闹，就是那时常上升、起来对抗你之人的喧哗。",
      "notes": []
    }
  ]
}
