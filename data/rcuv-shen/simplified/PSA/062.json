{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 62,
  "heading": "在神保佑中安稳自在",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/62/",
  "verses": [
    {
      "verse": 1,
      "text": "我的心默默无声，专等候神，我的救恩从他而来。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "惟独他是我的磐石，我的拯救；他是我的庇护所，我必不大大动摇。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "你们大家攻击一人，使他被杀，如歪斜的墙、将倒的壁，要到几时呢？",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他们彼此商议，要把他从高位上拉下来；他们喜爱谎话，口虽祝福，心却诅咒。（细拉）",
      "notes": []
    },
    {
      "verse": 5,
      "text": "我的心哪，你当默默无声，专等候神，因为我的盼望是从他而来。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "惟独他是我的磐石，我的拯救；他是我的庇护所，我必不动摇。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "我的拯救、我的荣耀都在于神；我力量的磐石、我的避难所都在于神。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "百姓啊，要时时倚靠他，在他面前倾心吐意；神是我们的避难所。（细拉）",
      "notes": []
    },
    {
      "verse": 9,
      "text": "人真是虚空，人真是虚假；放在天平里就必浮起，他们一共比空气还轻。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "不要仗势欺人，也不要因抢夺而骄傲；若财宝加增，不要放在心上。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "神说了一次、两次，我都听见了，就是能力属乎神。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "主啊，慈爱也是属乎你，因为你照着各人所做的报应他。",
      "notes": []
    }
  ]
}
