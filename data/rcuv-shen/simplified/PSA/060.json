{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 60,
  "heading": "求主解救",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/60/",
  "verses": [
    {
      "verse": 1,
      "text": "神啊，你丢弃了我们，破坏了我们；你曾发怒，求你使我们复兴！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "你使地震动，崩裂；求你将裂口补好，因为地在摇动。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "你让你的子民遇见艰难，使我们喝那令人东倒西歪的酒。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "你把旌旗赐给敬畏你的人，可以躲避弓箭。（细拉）",
      "notes": [
        "“躲避弓箭”是根据七十士译本；原文是“为真理扬起来”。"
      ]
    },
    {
      "verse": 5,
      "text": "求你应允我们，用右手施行拯救，好让你所亲爱的人得救。",
      "notes": [
        "“我们”：原文另译“我”。"
      ]
    },
    {
      "verse": 6,
      "text": "神在他的圣所说：“我要欢乐；要划分示剑，丈量疏割谷。",
      "notes": [
        "“在他的圣所”或译“指着他的圣洁”。"
      ]
    },
    {
      "verse": 7,
      "text": "基列是我的，玛拿西是我的。以法莲是护卫我头的，犹大是我的权杖。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "摩押是我的沐浴盆，我要向以东扔鞋。非利士啊，你还能因我欢呼吗？”",
      "notes": []
    },
    {
      "verse": 9,
      "text": "谁能领我进坚固城？谁能引我到以东地？",
      "notes": []
    },
    {
      "verse": 10,
      "text": "神啊，你真的丢弃了我们吗？神啊，你不和我们的军队同去吗？",
      "notes": []
    },
    {
      "verse": 11,
      "text": "求你帮助我们攻击敌人，因为人的帮助是枉然的。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "我们倚靠神才得施展大能，因为践踏我们敌人的就是他。",
      "notes": []
    }
  ]
}
