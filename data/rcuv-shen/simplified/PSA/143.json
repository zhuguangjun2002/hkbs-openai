{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 143,
  "heading": "求主拯救",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/143/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华啊，求你听我的祷告，侧耳听我的恳求，凭你的信实和公义应允我。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "求你不要审问仆人，因为在你面前，凡活着的人没有一个是义的。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "因为仇敌迫害我，将我打倒在地，使我住在幽暗之处，像死了许久的人一样。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "我的灵在我里面发昏，我的心在我里面颤栗。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "我追想古时之日，思想你的一切作为，默念你手的工作。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我向你举手，我的心渴想你，如干旱之地盼雨一样。（细拉）",
      "notes": []
    },
    {
      "verse": 7,
      "text": "耶和华啊，求你速速应允我！我的心神耗尽！求你不要转脸不顾我，免得我像那些下入地府的人一样。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "求你使我清晨得听你慈爱的声音，因我倚靠你；求你使我知道当走的路，因我的心仰望你。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "耶和华啊，求你救我脱离我的仇敌！我往你那里藏身。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "求你指教我遵行你的旨意，因你是我的神；愿你至善的灵引我到平坦之地。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "耶和华啊，求你为你名的缘故将我救活，凭你的公义，将我从患难中领出来，",
      "notes": []
    },
    {
      "verse": 12,
      "text": "凭你的慈爱剪除我的仇敌，灭绝所有苦待我的人，因我是你的仆人。",
      "notes": []
    }
  ]
}
