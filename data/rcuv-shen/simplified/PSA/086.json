{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 86,
  "heading": "求主恩助",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/86/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华啊，求你侧耳应允我，因我是困苦贫穷的。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "求你保住我的性命，因我是虔诚的人。我的神啊，求你拯救我这倚靠你的仆人！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "主啊，求你怜悯我，因我终日求告你。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "主啊，求你使你的仆人心里欢喜，因为我的心仰望你。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "主啊，你本为良善，乐于饶恕人，以丰盛的慈爱对待凡求告你的人。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "耶和华啊，求你侧耳听我的祷告，留心听我恳求的声音。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "我在患难之日要求告你，因为你必应允我。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "主啊，诸神之中没有可与你相比的，你的作为也无以为比。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "主啊，你所造的万民都要来敬拜你，他们要荣耀你的名。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "因你本为大，且行奇妙的事，惟独你是神。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "耶和华啊，求你将你的道指教我，我要照你的真理而行；求你使我专心敬畏你的名！",
      "notes": []
    },
    {
      "verse": 12,
      "text": "主－我的神啊，我要一心称谢你；我要荣耀你的名，直到永远。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "因为你的慈爱在我身上浩大，你救了我的性命免入阴间的深处。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "神啊，骄傲的人起来攻击我，又有一群强横的人寻索我的命；他们没有将你放在眼里。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "主啊，你是有怜悯，有恩惠的神，不轻易发怒，并有丰盛的慈爱和信实。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "求你转向我，怜悯我，将你的力量赐给仆人，拯救你使女的儿子。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "求你向我显出恩待我的凭据，使恨我的人看见就羞愧，因为你－耶和华帮助我，安慰了我。",
      "notes": []
    }
  ]
}
