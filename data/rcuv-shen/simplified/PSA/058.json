{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 58,
  "heading": "求神罚恶",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/58/",
  "verses": [
    {
      "verse": 1,
      "text": "你们缄默不语，真合公义吗？你们审判世人，岂按正直吗？",
      "notes": []
    },
    {
      "verse": 2,
      "text": "不然！你们心中作恶，量出你们在地上手中的残暴。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "恶人一出母胎就与神疏远，一离母腹就走错路，说谎话。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他们的毒气好像蛇的毒气，他们好像聋的毒蛇塞住耳朵，",
      "notes": []
    },
    {
      "verse": 5,
      "text": "听不见弄蛇者的声音，也听不见魔术师的咒语。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "神啊，求你敲碎他们口中的牙！耶和华啊，求你敲掉少壮狮子的大牙！",
      "notes": []
    },
    {
      "verse": 7,
      "text": "愿他们消灭，如急流的水一般；他们瞄准射箭的时候，箭头仿佛折断。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "愿他们像蜗牛腐烂消失，又像妇人流掉的胎儿，未见天日。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "你们用荆棘烧火，锅还未热，神就用旋风把未烧着的和已烧着的一齐刮去。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "义人见仇敌遭报就欢喜，他要在恶人的血中洗脚。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "因此，人必说：“义人诚然有善报，在地上果然有施行审判的神！”",
      "notes": []
    }
  ]
}
