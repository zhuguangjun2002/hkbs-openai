{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 82,
  "heading": "神是最高的主宰",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/82/",
  "verses": [
    {
      "verse": 1,
      "text": "神站立在神圣的会中，在诸神中施行审判。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "你们审判不秉公义，抬举恶人的脸面，要到几时呢？（细拉）",
      "notes": []
    },
    {
      "verse": 3,
      "text": "当为贫寒的人和孤儿伸冤，为困苦和穷乏的人施行公义。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "当保护贫寒和贫穷的人，救他们脱离恶人的手。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "他们愚昧，他们无知，在黑暗中走来走去；地的根基都摇动了。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我曾说：“你们是诸神，都是至高者的儿子。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "然而，你们要死去，与世人一样，要仆倒，像任何一位王子一般。”",
      "notes": []
    },
    {
      "verse": 8,
      "text": "神啊，求你起来审判全地，因为你必得万国为业。",
      "notes": []
    }
  ]
}
