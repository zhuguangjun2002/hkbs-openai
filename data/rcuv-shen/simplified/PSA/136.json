{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 136,
  "heading": "感恩的圣诗",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PSA/136/",
  "verses": [
    {
      "verse": 1,
      "text": "你们要称谢耶和华，因他本为善；他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "你们要称谢万神之神，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "你们要称谢万主之主，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "称谢那惟一能行大奇事的，因他的慈爱永远长存。",
      "notes": [
        "死海古卷和七十士译本没有“大”。"
      ]
    },
    {
      "verse": 5,
      "text": "称谢那用智慧造天的，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "称谢那铺地在水以上的，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "称谢那造成大光的，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他造太阳管白昼，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他造月亮星宿管黑夜，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "称谢那击杀埃及凡是头生的，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 11,
      "verse_end": 12,
      "text": "他以大能的手和伸出来的膀臂，因他的慈爱永远长存。领以色列人从埃及人中出来，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "称谢那分裂红海的，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "他领以色列从其中经过，因他的慈爱永远长存；",
      "notes": []
    },
    {
      "verse": 15,
      "text": "却把法老和他的军队推落红海里，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "称谢那引导自己子民行走旷野的，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "称谢那击杀大君王的，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "他杀戮威武的君王，因他的慈爱永远长存；",
      "notes": []
    },
    {
      "verse": 19,
      "text": "杀戮亚摩利王西宏，因他的慈爱永远长存；",
      "notes": []
    },
    {
      "verse": 20,
      "text": "杀戮巴珊王噩，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "他赏赐他们的地为业，因他的慈爱永远长存；",
      "notes": []
    },
    {
      "verse": 22,
      "text": "作为他仆人以色列的产业，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "我们身处卑微，他顾念我们，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "他搭救我们脱离敌人，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "凡有血有肉的，他赐粮食，因他的慈爱永远长存。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "你们要称谢天上的神，因他的慈爱永远长存。",
      "notes": []
    }
  ]
}
