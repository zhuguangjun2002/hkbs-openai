{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 29,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/29/",
  "verses": [
    {
      "verse": 1,
      "text": "人屡次受责罚，仍然硬着颈项，他必顷刻被毁，无从医治。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "义人增多，民就喜乐；恶人掌权，民就叹息。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "爱慕智慧的，使父亲喜乐；结交妓女的，却浪费钱财。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "王藉公平，使国坚定；强索贡物的，使它毁坏。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "谄媚邻舍的，就是设网罗绊他的脚。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "恶人犯罪，自陷圈套；惟独义人欢呼喜乐。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "义人关注贫寒人的案情；恶人不明了这种知识。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "傲慢人煽动全城；智慧人止息众怒。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "智慧人与愚妄人有争讼，或怒或笑，总不得安宁。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "好流人血的，恨恶完全人，正直人却顾惜他的性命。",
      "notes": [
        "“顾惜”：原文是“寻索”。"
      ]
    },
    {
      "verse": 11,
      "text": "愚昧人怒气全发；智慧人自我平息。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "君王若听谎言，他一切臣仆都是奸恶。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "穷乏人和欺压者相遇，耶和华使他们的眼目明亮。",
      "notes": [
        "“相遇”或译“是一样的”。"
      ]
    },
    {
      "verse": 14,
      "text": "君王凭诚信判断贫寒人，他的国位必永远坚立。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "杖打和责备能增加智慧；任性的少年使母亲羞愧。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "恶人多，过犯也加多，义人必看见他们败亡。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "管教你的儿子，他就使你得安宁，也使你心里喜乐。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "没有异象，民就放肆；惟遵守律法的，便为有福。",
      "notes": [
        "“异象”或译“默示”。"
      ]
    },
    {
      "verse": 19,
      "text": "仆人不能靠言语受教；他即使明白，也不回应。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "你见过言语急躁的人吗？愚昧人比他更有指望。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "人将仆人从小娇养，至终必带来忧伤。",
      "notes": [
        "“至终必带来忧伤”或译“这仆人至终必成了他的继承人”。"
      ]
    },
    {
      "verse": 22,
      "text": "好生气的人挑起争端，暴怒的人多多犯错。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "人的高傲使自己蒙羞；心里谦逊的，必得尊荣。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "与盗贼分赃的，是恨恶自己的性命；他虽听见发誓的声音，也不告诉人。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "惧怕人的，陷入圈套；惟有倚靠耶和华的，必得安稳。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "求王恩的人多；人获公正来自耶和华。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "不义之人，义人憎恶；行事正直的，恶人憎恶。",
      "notes": []
    }
  ]
}
