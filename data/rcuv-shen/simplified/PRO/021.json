{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 21,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/21/",
  "verses": [
    {
      "verse": 1,
      "text": "王的心在耶和华手中像河水，他能使它随意流转。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "人一切所行的，在自己眼中看为正直，惟有耶和华衡量人心。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "行公义和公平比献祭更蒙耶和华悦纳。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "眼高心傲，就是恶人的灯，都是罪。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "殷勤筹划的，足致丰裕；行事急躁的，必致缺乏。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "用诡诈之舌所得的财富如被吹散的雾气，趋向灭亡。",
      "notes": [
        "“趋向灭亡”：有古卷、七十士译本和其他古译本是“和死亡的圈套”。"
      ]
    },
    {
      "verse": 7,
      "text": "恶人的残暴必扫去自己，因他们不肯按公平行事。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "有罪的人其路弯曲；纯洁的人行为正直。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "宁可住在房顶的一角，也不与好争吵的妇人同住。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "恶人的心渴想邪恶，他的眼并不怜悯邻舍。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "傲慢人受惩罚，愚蒙人可得智慧；智慧人受训诲，便得知识。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "公义的神鉴察恶人的家，他倾覆恶人，以致灭亡。",
      "notes": [
        "“公义的神”或译“义人”。"
      ]
    },
    {
      "verse": 13,
      "text": "塞耳不听贫寒人哀求的，他自己呼求，也不蒙应允。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "暗中送的礼物挽回怒气，怀里的贿赂能止息暴怒。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "秉公行义使义人喜乐，却使作恶的人败坏。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "人偏离智慧的路，必与阴魂为伍。",
      "notes": [
        "“必与阴魂为伍”：原文是“必住在阴魂的会中”。"
      ]
    },
    {
      "verse": 17,
      "text": "爱宴乐的，必致穷乏；贪爱酒和油的，必不富足。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "恶人作义人的赎价，奸诈人代替正直人。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "宁可住在旷野之地，也不与争吵易怒的妇人同住。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "智慧人的居所积蓄宝物与膏油；愚昧人却挥霍一空。",
      "notes": [
        "“智慧人...膏油”：七十士译本是“渴慕的宝物留在智慧人的嘴上”。"
      ]
    },
    {
      "verse": 21,
      "text": "追求公义慈爱的，就寻得生命、公义和尊荣。",
      "notes": [
        "七十士译本没有“公义”。"
      ]
    },
    {
      "verse": 22,
      "text": "智慧人爬上勇士的城墙，摧毁他所倚靠的堡垒。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "谨守口和舌的，就保护自己免受灾难。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "心骄气傲的人名叫傲慢，他行事出于狂妄骄傲。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "懒惰人的欲望害死自己，因为他的手不肯做工；",
      "notes": []
    },
    {
      "verse": 26,
      "text": "有人终日贪得无餍，义人却施舍而不吝惜。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "恶人献的祭是可憎的，何况他存恶意来献呢？",
      "notes": []
    },
    {
      "verse": 28,
      "text": "不实的见证必消灭；惟聆听真情的，他的证词有力。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "恶人脸无羞耻；正直人行事坚定。",
      "notes": [
        "“正直人行事坚定”：原文另译“正直人明白己道”。"
      ]
    },
    {
      "verse": 30,
      "text": "没有人能以智慧、聪明、谋略抵挡耶和华。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "马是为打仗之日预备的；得胜却在于耶和华。",
      "notes": []
    }
  ]
}
