{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 28,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/28/",
  "verses": [
    {
      "verse": 1,
      "text": "恶人虽无人追赶也逃跑；义人却胆壮像狮子。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "地上因有罪过，君王就多更换；因聪明和有见识的人，国必长存。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "穷乏人欺压贫寒人，好像暴雨扫过，不留粮食。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "离弃律法的，夸奖恶人；遵守律法的，却与恶人相争。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "恶人不明白公义；惟有寻求耶和华的，无不明白。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "行为纯正的穷乏人胜过行事歪曲的有钱人。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "谨守教诲的，是聪明之子；与贪食者为伍的，却羞辱其父。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "人以厚利增加财富，是给那怜悯贫寒人的积财。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "转耳不听教诲的，他的祈祷也可憎。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "诱惑正直人行恶道的，必掉在自己的坑里；惟有完全人必承受福分。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "有钱人自以为有智慧，但聪明的贫寒人能看穿他。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "义人高升，有大荣耀；恶人兴起，人就躲藏。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "遮掩自己过犯的，必不顺利；承认且离弃过犯的，必蒙怜悯。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "常存敬畏的，这人有福了；心里刚硬的，必陷在祸患里。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "邪恶的君王压制贫民，好像吼叫的狮子，又如觅食的熊。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "无知的君王多行暴虐；恨恶非分之财的，必年长日久。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "背负流人血之罪的，必逃跑直到地府；愿无人帮助他！",
      "notes": []
    },
    {
      "verse": 18,
      "text": "行为正直的，必蒙拯救；行事弯曲的，立时跌倒。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "耕种自己田地的，粮食充足；追求虚浮的，穷困潦倒。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "诚实人必多得福；想要急速发财的，难免受罚。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "看人情面是不好的；却有人因一块饼而犯法。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "守财奴想要急速发财，却不知穷乏必临到他身上。",
      "notes": [
        "“守财奴”：原文直译“眼目邪恶的人”。"
      ]
    },
    {
      "verse": 23,
      "text": "责备人的，后来蒙人喜悦，多于那用舌头谄媚人的。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "抢夺父母竟说“这不是罪过”，此人与毁灭者同类。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "心中贪婪的，挑起争端；倚靠耶和华的，必得丰裕。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "心中自以为是的，就是愚昧人；凭智慧行事的，必蒙拯救。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "周济穷乏人的，不致缺乏；遮眼不看的，多受诅咒。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "恶人兴起，人就躲藏；恶人败亡，义人必增多。",
      "notes": []
    }
  ]
}
