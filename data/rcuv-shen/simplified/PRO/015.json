{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 15,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/15/",
  "verses": [
    {
      "verse": 1,
      "text": "回答柔和，使怒消退；言语粗暴，触动怒气。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "智慧人的舌善发知识；愚昧人的口吐出愚昧。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "耶和华的眼目无处不在，恶人善人，他都鉴察。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "温良的舌是生命树；邪恶的舌使人心碎。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "愚妄人藐视父亲的管教；领受责备，使人精明。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "义人家中多有财富；恶人获利反受扰害。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "智慧人的嘴传扬知识；愚昧人的心并非如此。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "恶人献祭，为耶和华所憎恶；正直人祈祷，为他所喜悦。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "恶人的道路，为耶和华所憎恶；追求公义的，为他所喜爱。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "背弃正路的，必受严刑；恨恶责备的，必致死亡。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "阴间和冥府尚且在耶和华面前，何况世人的心呢？",
      "notes": [
        "“冥府”：原文音译“亚巴顿”，意思是“灭亡之地”。"
      ]
    },
    {
      "verse": 12,
      "text": "傲慢人不爱受责备，也不去接近智慧人。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "心中喜乐，面有喜色；心里忧愁，灵就忧伤。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "聪明人的心追求知识；愚昧人的口吞吃愚昧。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "困苦人的日子都是愁苦；心中欢畅的，常享宴席。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "财宝稀少，敬畏耶和华，强如财宝众多，烦乱不安。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "有爱，吃素菜，强如相恨，吃肥牛。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "暴怒的人挑启争端；忍怒的人止息纷争。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "懒惰人的道像荆棘的篱笆；正直人的路是平坦大道。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "智慧之子使父亲喜乐；愚昧的人藐视母亲。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "无知的人以愚昧为乐；聪明的人按正直而行。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "不先商议，所谋无效；谋士众多，所谋得成。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "口善应对，自觉喜乐；话合其时，何等美好。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "生命之道使智慧人上升，使他远离底下的阴间。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "耶和华必拆毁骄傲人的家，却要立定寡妇的地界。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "恶谋为耶和华所憎恶；良言却是纯净的。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "暴力敛财的，扰害己家；恨恶贿赂的，必得存活。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "义人的心思量应答；恶人的口吐出恶言。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "耶和华远离恶人，却听义人的祈祷。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "眼睛发光，使心喜乐；好的信息，滋润骨头。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "耳听使人得生命的责备，必居住在智慧人之中。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "弃绝管教的，轻看自己的生命；领受责备的，却得智慧的心。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "敬畏耶和华是智慧的训诲；要得尊荣，先有谦卑。",
      "notes": []
    }
  ]
}
