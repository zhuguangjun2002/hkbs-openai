{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 14,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/14/",
  "verses": [
    {
      "verse": 1,
      "text": "妇人的智慧建立家室；愚昧却亲手拆毁它。",
      "notes": [
        "本节七十士译本是“智慧妇人建立家室；愚妄妇人亲手拆毁”。"
      ]
    },
    {
      "verse": 2,
      "text": "行事正直的，敬畏耶和华；偏离正路的，却藐视他。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "在愚妄人的口中有骄傲的杖；智慧人的嘴唇必保护自己。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "没有牛，槽就空空；土产丰盛却凭牛的力气。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "诚实的证人不说谎；虚假的证人口吐谎言。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "傲慢人枉寻智慧；聪明人易得知识。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "不要到愚昧人面前，你无法从他嘴唇里知道知识。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "通达人的智慧使他认清自己的道路；愚昧人的愚昧却是自欺。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "愚妄人嘲笑赎愆祭；但正直人蒙悦纳。",
      "notes": [
        "“赎愆祭”或译“复和”。"
      ]
    },
    {
      "verse": 10,
      "text": "心中的苦楚，只有自己知道；心里的喜乐，陌生人无法分享。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "恶人的房屋必倒塌；正直人的帐棚必兴旺。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "有一条路，人以为正，至终成为死亡之路。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "人在喜笑中，心也会忧愁；快乐的终点就是愁苦。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "心中背道的，必满尝其果；善人必从自己的行为得到回报。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "无知的人什么话都信；通达人谨慎自己的脚步。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "智慧人有所惧怕，就远离恶事；愚昧人却狂傲自恃。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "轻易发怒的，行事愚昧；擅长诡计的，被人恨恶。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "愚蒙人承受愚昧为产业；通达人得知识为冠冕。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "坏人在善人面前俯伏；恶人在义人门口也是如此。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "穷乏人，连邻舍也恨他；有钱人，爱他的人众多。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "藐视邻舍的，这人有罪；施恩给困苦人的，这人有福。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "谋恶的，岂非走入迷途？谋善的，有慈爱和诚实。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "任何勤劳总有收获；仅耍嘴皮必致穷乏。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "智慧人的冠冕是富有智慧；愚昧人的愚昧终究是愚昧。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "诚实作证，救人性命；口吐谎言是诡诈。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "敬畏耶和华的，大有倚靠；他的儿女也有避难所。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "敬畏耶和华是生命的泉源，使人离开死亡的圈套。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "君王的荣耀在乎民多；没有百姓，王就衰败。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "不轻易发怒的，大有聪明；性情暴躁的，大显愚昧。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "平静的心使肉体有生气；嫉妒使骨头朽烂。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "欺压贫寒人的，是蔑视造他的主；怜悯贫穷人的，是尊敬主。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "恶人因所行的恶必被推倒；义人临死，有所投靠。",
      "notes": [
        "“义人临死”：七十士译本是“义人因其完全”。"
      ]
    },
    {
      "verse": 33,
      "text": "智慧安居在聪明人的心中，在愚昧人的心中却不认识。",
      "notes": [
        "“在愚昧人...不认识”是根据七十士译本；原文是“也为愚昧人的心所知”。"
      ]
    },
    {
      "verse": 34,
      "text": "公义使邦国高举；罪恶是百姓的羞辱。",
      "notes": []
    },
    {
      "verse": 35,
      "text": "君王的恩宠临到智慧的臣仆；但其愤怒临到蒙羞的臣仆。",
      "notes": []
    }
  ]
}
