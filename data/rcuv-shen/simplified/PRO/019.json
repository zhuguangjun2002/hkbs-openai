{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 19,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/19/",
  "verses": [
    {
      "verse": 1,
      "text": "行为纯正的穷乏人胜过嘴唇歪曲的愚昧人。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "热心而无见识，实为不善；脚步急快的，易入歧途。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "人因愚昧自毁前途，他的心却埋怨耶和华。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "财富使朋友增多；贫寒人连仅有的朋友也离弃他。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "作假见证的，难免受罚；口吐谎言的，不能逃脱。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "有权贵的，许多人求他赏脸；爱送礼的，人都作他的朋友。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "穷乏人连兄弟都恨他，何况朋友，更是远离他！他用言语追随，他们却不在。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "得着智慧的，爱惜生命；持守聪明的，寻得好处。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "作假见证的，难免受罚；口吐谎言的，必定灭亡。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "愚昧人奢华度日并不相宜，仆人管辖王子，也不应该。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "人有见识就不轻易发怒，宽恕人的过失便是自己的荣耀。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "王的愤怒好像狮子吼叫；他的恩惠却如草上的甘露。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "愚昧的儿子是父亲的祸患，妻子的争吵如雨连连滴漏。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "房屋钱财是祖宗所遗留的；惟有贤慧的妻是耶和华所赐的。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "懒惰使人沉睡，懈怠的人必捱饿。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "遵守诫命的，保全生命；轻忽己路的，必致死亡。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "怜悯贫寒人的，就是借给耶和华，他的报偿，耶和华必归还他。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "趁还有指望，管教你的儿子，不可执意摧毁他。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "暴怒的人必受惩罚，你若救他，必须再救。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "要听劝言，接受训诲，使你终久有智慧。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "人心多有计谋；惟有耶和华的筹算才能成就。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "仁慈的人令人喜爱，穷乏人强如说谎言的。",
      "notes": [
        "“仁慈...喜爱”或译“贪心是人的羞耻”。"
      ]
    },
    {
      "verse": 23,
      "text": "敬畏耶和华的，得着生命，他必饱足安居，不遭祸患。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "懒惰人把手埋入盘里，连缩回送进口中也不肯。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "责打傲慢人，能使无知的人变精明；责备聪明人，他就明白知识。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "虐待父亲、驱逐母亲的，是蒙羞致辱之子。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "我儿啊，停止听那叫你偏离知识言语的教导。",
      "notes": [
        "“停止...教导”或译“不可听了教导而又偏离知识的言语”；又或译“不可偏离知识的言语，要听教导”。"
      ]
    },
    {
      "verse": 28,
      "text": "卑劣的见证嘲笑公平，恶人的口吞下罪孽。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "刑罚是为傲慢人预备的，鞭打则是为愚昧人的背预备的。",
      "notes": []
    }
  ]
}
