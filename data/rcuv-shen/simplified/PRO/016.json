{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 16,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/16/",
  "verses": [
    {
      "verse": 1,
      "text": "心中的筹谋在乎人，舌头的应对出于耶和华。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "人一切所行的，在自己眼中看为纯洁，惟有耶和华衡量人的内心。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "你所做的，要交托耶和华，你所谋的，就必坚立。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华造万物各适其用，就是恶人也为祸患的日子所造。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "凡心里骄傲的，为耶和华所憎恶；击掌保证，他难免受罚。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "因慈爱和信实，罪孽得赎；敬畏耶和华的，远离恶事。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "人所行的若蒙耶和华喜悦，耶和华也使仇敌与他和好。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "少获利，行事公义，强如多获利，行事不义。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "人心筹算自己的道路；惟耶和华指引他的脚步。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "王的嘴唇有圣言，审判之时，他的口必不差错。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "公道的秤和天平属耶和华，囊中一切的法码是他所定。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "作恶，为王所憎恶，因国位是靠公义坚立。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "公义的嘴唇，王喜悦，说正直话的，他喜爱。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "王的震怒是死亡的使者，但智慧人能平息王怒。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "王脸上的光使人有生命，他的恩惠好像云带来的春雨。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "得智慧胜过得金子，选聪明强如选银子。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "正直人的道远离恶事，谨守己路的，保全性命。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "骄傲在败坏以先，内心高傲在跌倒之前。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "心里谦卑与困苦人来往，强如与骄傲人同分战利品。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "留心训言的，必得福乐；倚靠耶和华的，这人有福。",
      "notes": [
        "“留心训言的”或译“专注事务的”。"
      ]
    },
    {
      "verse": 21,
      "text": "心中有智慧的，必称为聪明人；嘴唇的甜言，增长人的学问。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "人有智慧就有生命的泉源；愚妄人必受愚妄的惩戒。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "智慧人的心使他的口谨慎，又使他的嘴唇增长学问。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "良言如同蜂巢，使心甘甜，使骨得医治。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "有一条路，人以为正，至终却成为死亡之路。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "劳力的人为自己劳力，因为他的口腹催逼他。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "匪徒图谋奸恶，嘴唇上的言语仿佛烧焦的火。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "乖谬的人散播纷争，造谣的离间密友。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "残暴的人引诱邻舍，领他走不好的道路。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "紧闭双目的，图谋乖谬；紧咬嘴唇的，成就恶事。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "白发是荣耀的冠冕，行在公义道上的，必能得着。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "不轻易发怒的，胜过勇士；控制自己脾气的，强如取城。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "人虽可掷签在膝上，定事却由耶和华。",
      "notes": []
    }
  ]
}
