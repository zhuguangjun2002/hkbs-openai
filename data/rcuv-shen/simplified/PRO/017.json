{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 17,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/17/",
  "verses": [
    {
      "verse": 1,
      "text": "一块干饼，大家相安；胜过宴席满屋，大家相争。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "明智的仆人必管辖蒙羞的儿子，并在兄弟中同分产业。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "鼎为炼银，炉为炼金，惟有耶和华熬炼人心。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "行恶的，留心听恶毒的嘴唇；说谎的，侧耳听邪恶的舌头。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "讥笑穷乏人的，是蔑视造他的主；幸灾乐祸的，难免受罚。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "子孙为老人的冠冕；父母是儿女的荣耀。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "愚顽人说美言并不相宜，君子说谎言也不合宜。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "贿赂在馈赠者的眼中看为玉石，随处运转都得顺利。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "包容过错的，寻求友爱；喋喋不休的，离间密友。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "一句责备的话深入聪明人的心，强如打愚昧人一百下。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "恶人只寻求背叛，残忍的使者必奉差攻击他。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "宁可遇见失丧小熊的母熊，也不愿遇见正行愚昧的愚昧人。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "以恶报善的，祸患必不离他的家。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "纷争掀起，如同缺口的水；因此，争端尚未爆发就当制止。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "定恶人为义的，定义人为有罪的，都为耶和华所憎恶。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "愚昧人既无知，为何手拿银钱去买智慧呢？",
      "notes": []
    },
    {
      "verse": 17,
      "text": "朋友时常亲爱，弟兄为患难而生。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "在邻舍面前击掌担保的，是无知的人。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "喜爱争吵的，是喜爱过犯；门盖得高的，自取败坏。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "心中歪曲的，得不着福乐；舌头颠倒是非的，陷在祸患中。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "生愚昧之子的，自己必愁苦；愚顽人的父亲毫无喜乐。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "喜乐的心能治好疾病；忧伤的灵使骨头枯干。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "恶人暗中受贿赂，以致弯曲公正的路。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "聪明人面前有智慧；愚昧人眼望地的尽头。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "愚昧的儿子使父亲愁烦，使那生他的母亲忧苦。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "刑罚义人实为不善，责打正直的君子也不宜。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "节制言语的，有见识；性情温良的人，有聪明。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "愚妄人若静默不言，可算为智慧，闭上嘴唇也可算为聪明。",
      "notes": []
    }
  ]
}
