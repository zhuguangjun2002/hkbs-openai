{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 26,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/26/",
  "verses": [
    {
      "verse": 1,
      "text": "愚昧人得尊荣不相宜，正如夏天落雪，收割时下雨。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "诅咒不会无故临到，正如麻雀掠过，燕子翻飞。",
      "notes": [
        "“诅咒...临到”：原文另译“无故的诅咒必返回自己身上”。"
      ]
    },
    {
      "verse": 3,
      "text": "鞭子是为打马，辔头是为勒驴，刑杖正是为打愚昧人的背。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "不要照愚昧人的愚昧话回答他，免得你与他一样。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "要照愚昧人的愚昧话回答他，免得他自以为有智慧。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "藉愚昧人的手寄信的，就像砍断双脚，喝下残暴。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "箴言在愚昧人的口中，正如瘸子的脚悬空无用。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "将尊荣给愚昧人的，就像石头绑在弹弓上。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "箴言在愚昧人的口中，好像荆棘刺入醉汉的手。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "雇愚昧人的，与雇过路人的，就像弓箭手射伤任何人。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "愚昧人重复做愚昧之事，就如狗转过来吃自己所吐的。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "你看见自以为有智慧的人吗？愚昧人比他更有指望。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "懒惰人说：“道路有猛狮，街上有壮狮。”",
      "notes": []
    },
    {
      "verse": 14,
      "text": "懒惰人在床上，就像门在轴心上转动一样。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "懒惰人把手埋入盘里，就是送进口中也觉得累。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "懒惰人眼看自己比七个善于应对的人更有智慧。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "过路时卷入与己无关的纷争，好像人揪住狗耳一般。",
      "notes": []
    },
    {
      "verse": 18,
      "verse_end": 19,
      "text": "人欺骗邻舍，却说“我只是开玩笑而已”，他就像疯狂的人抛掷致死的火把和利箭。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "火缺了柴就必熄灭；无人造谣，纷争就止息。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "好争吵的人煽动争端，就如余火加炭，火上加柴一样。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "造谣者的话如同美食，深入人的肚腹。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "火热的嘴唇，邪恶的心，好像银渣包在瓦器上。",
      "notes": [
        "“火热的”：七十士译本是“油滑的”。"
      ]
    },
    {
      "verse": 24,
      "text": "仇敌用嘴唇掩饰，心里却藏着诡诈；",
      "notes": []
    },
    {
      "verse": 25,
      "text": "他用甜言蜜语，你不能相信他，因为他心中有七样可憎恶的事。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "他虽用诡诈掩饰怨恨，他的邪恶必在集会中显露。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "挖陷坑的，自己必陷在其中；滚石头的，石头反滚在他身上。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "虚谎的舌憎恨他所压伤的人；谄媚的口败坏人的事。",
      "notes": []
    }
  ]
}
