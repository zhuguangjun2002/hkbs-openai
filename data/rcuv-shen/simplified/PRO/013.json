{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 13,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/13/",
  "verses": [
    {
      "verse": 1,
      "text": "智慧之子听父亲的训诲；傲慢人不听责备。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "人因口所结的果实，必享美福；奸诈人却意图残暴。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "谨慎守口的，得保生命；大张嘴唇的，必致败亡。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "懒惰的人奢求，却无所得；殷勤的人必然丰裕。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "义人恨恶谎言；恶人可憎可耻。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "行为纯正的，有公义保护；犯罪的，被罪恶倾覆。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "假冒富足的，一无所有；装作穷乏的，多有财物。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "财富可作人的生命赎价；穷乏人却听不见威吓的话。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "义人的光使人欢喜；恶人的灯要熄灭。",
      "notes": [
        "“使人欢喜”：原文另译“明亮”。"
      ]
    },
    {
      "verse": 10,
      "text": "骄傲挑启纷争；听劝言却有智慧。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "不劳而获之财必减少；逐渐积蓄的必增多。",
      "notes": [
        "“不劳而获之财”：七十士译本是“暴发的不义之财”。"
      ]
    },
    {
      "verse": 12,
      "text": "盼望迟延，令人心忧；愿望实现，就是得到生命树。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "藐视训言的，自取灭亡；敬畏诫命的，必得善报。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "智慧人的教诲是生命的泉源，使人避开死亡的圈套。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "美好的见识使人得宠；奸诈人的道路恒久奸诈。",
      "notes": [
        "“恒久奸诈”：原文是“恒久”。"
      ]
    },
    {
      "verse": 16,
      "text": "通达人都凭知识行事；愚昧人张扬自己的愚昧。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "邪恶的使者必陷入祸患；忠信的使臣带来医治。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "弃绝管教的，必贫穷受辱；领受责备的，必享尊荣。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "愿望实现，心觉甘甜；远离恶事，为愚昧人所憎恶。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "与智慧人同行的，必得智慧；和愚昧人作伴的，必受亏损。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "祸患追赶罪人；义人却得善报。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "善人给子孙遗留产业；罪人积财却归义人。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "穷乏人开垦的地虽多产粮食，却因不公而被夺走。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "不忍用杖打儿子的，是恨恶他；疼爱儿子的，勤加管教。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "义人吃喝食欲满足；恶人肚腹却是缺乏。",
      "notes": []
    }
  ]
}
