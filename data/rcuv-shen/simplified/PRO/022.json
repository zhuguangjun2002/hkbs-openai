{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 22,
  "heading": "智言三十则",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/22/",
  "verses": [
    {
      "verse": 1,
      "text": "美名胜过大财，宏恩强如金银。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "有钱人与穷乏人相遇，他们都为耶和华所造。",
      "notes": [
        "“相遇”或译“是一样的”。"
      ]
    },
    {
      "verse": 3,
      "text": "通达人见祸就藏躲；愚蒙人却前往受害。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "敬畏耶和华心存谦卑，就得财富、尊荣、生命为赏赐。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "歪曲的人路上有荆棘和罗网，保护自己生命的，必要远离。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "教养孩童走当行的道，就是到老他也不偏离。",
      "notes": [
        "七十士译本没有本节。"
      ]
    },
    {
      "verse": 7,
      "text": "有钱人管辖穷乏人，欠债的是债主的仆人。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "撒不义种子的必收割灾祸，他逞怒的杖也必废掉。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "眼目仁慈的必蒙福，因他将食物分给贫寒人。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "赶出傲慢人，争端就消除，纷争和羞辱也必止息。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "喜爱清心，嘴唇有恩言的，王必与他为友。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "耶和华的眼目保护知识，却毁坏奸诈人的言语。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "懒惰人说：“外面有狮子，我在街上必被杀害。”",
      "notes": []
    },
    {
      "verse": 14,
      "text": "陌生女子的口是深坑，耶和华所憎恶的，必陷在其中。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "愚昧迷住孩童的心，用管教的杖可以远远赶除。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "欺压贫寒人为要利己的，并送礼给有钱人的，都必缺乏。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "你要侧耳听智慧人的言语，留心领会我的知识。",
      "notes": [
        "“你要...言语”：七十士译本是“智慧人的言语：你要侧耳听我的言语”。"
      ]
    },
    {
      "verse": 18,
      "text": "你若心中存记，嘴唇也准备就绪，这是美的。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "我今日特地指教你，为要使你倚靠耶和华。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "谋略和知识的美事，我岂没有写给你吗？",
      "notes": [
        "“美事”：原文另译“三十句”。"
      ]
    },
    {
      "verse": 21,
      "text": "要使你明白真情实理，好将实情回覆那差你来的人。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "不可因人贫寒就抢夺他，也不可在城门口欺压困苦人，",
      "notes": []
    },
    {
      "verse": 23,
      "text": "因耶和华必为他们辩护，也必夺取那抢夺者的命。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "不可结交好生气的人，也不可与暴怒的人来往，",
      "notes": []
    },
    {
      "verse": 25,
      "text": "恐怕你效法他的行为，自己就陷在圈套里。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "不要为人击掌担保，也不要为债务作保。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "你若没有什么可偿还，何必使人夺去你睡卧的床呢？",
      "notes": []
    },
    {
      "verse": 28,
      "text": "祖先所立的地界，你不可挪移。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "你看见办事殷勤的人吗？他必侍立在君王面前，不在平庸的人面前。",
      "notes": []
    }
  ]
}
