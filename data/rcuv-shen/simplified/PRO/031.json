{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 31,
  "heading": "给君王的忠告",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/31/",
  "verses": [
    {
      "verse": 1,
      "text": "玛撒王利慕伊勒的言语，就是他母亲教导他的。",
      "notes": [
        "“玛撒王...他的”或译“利慕伊勒王的言语，是他母亲教导他的神谕”。"
      ]
    },
    {
      "verse": 2,
      "text": "我儿，怎么了？我腹中生的儿，怎么了？我许愿而得的儿，怎么了？",
      "notes": []
    },
    {
      "verse": 3,
      "text": "不要将你的精力给妇女，也不要有败坏君王的行为。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "利慕伊勒啊，君王不宜，君王不宜喝酒，王子寻找烈酒也不相宜；",
      "notes": []
    },
    {
      "verse": 5,
      "text": "恐怕喝了就忘记所颁的法令，颠倒所有困苦人的是非。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "可以把烈酒给将亡的人喝，把酒给心里愁苦的人喝，",
      "notes": []
    },
    {
      "verse": 7,
      "text": "让他喝了，就忘记他的贫穷，不再记得他的苦楚。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "你当为不能自辩的人开口，为所有孤独无助者伸冤。",
      "notes": [
        "“不能自辩的人”或译“哑巴”。"
      ]
    },
    {
      "verse": 9,
      "text": "你当开口按公义判断，当为困苦和贫穷的人辩护。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "才德的妇人谁能得着呢？她的价值远胜过宝石。",
      "notes": [
        "由本节开始，原文是字母诗。"
      ]
    },
    {
      "verse": 11,
      "text": "她丈夫心里信赖她，必不缺少利益；",
      "notes": []
    },
    {
      "verse": 12,
      "text": "她终其一生，使丈夫有益无损。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "她寻找羊毛和麻，欢喜用手做工。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "她好像商船，从远方运来粮食，",
      "notes": []
    },
    {
      "verse": 15,
      "text": "未到黎明她就起来，把食物分给家中的人，将当做的工分派女仆。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "她想得田地，就去买来，用手中的成果栽葡萄园。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "她以能力束腰，使膀臂有力。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "她觉得自己获利不错，她的灯终夜不灭。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "她伸手拿卷线杆，她的手掌把住纺车。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "她张手周济困苦人，伸手帮助贫穷人。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "她不因下雪为家里的人担心，因为全家都穿上朱红衣服。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "她为自己制作被单，她的衣服是细麻和紫色布做的。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "她丈夫在城门口与本地的长老同坐，为人所认识。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "她做细麻布衣裳来卖，又将腰带卖给商家。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "能力和威仪是她的衣服，她想到日后的景况就喜笑。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "她开口就发智慧，她舌上有仁慈的教诲。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "她管理家务，并不吃闲饭。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "她的儿女起来称她有福，她的丈夫也称赞她：",
      "notes": []
    },
    {
      "verse": 29,
      "text": "“才德的女子很多，惟独你超过一切。”",
      "notes": []
    },
    {
      "verse": 30,
      "text": "魅力是虚假的，美貌是虚浮的；惟敬畏耶和华的妇女必得称赞。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "她手中的成果你们要赏给她，愿她的工作在城门口荣耀她。",
      "notes": []
    }
  ]
}
