{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 12,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/12/",
  "verses": [
    {
      "verse": 1,
      "text": "喜爱管教的，就是喜爱知识；恨恶责备的，却像畜牲。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "善人蒙耶和华的恩宠；设诡计的，耶和华必定罪。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "人靠恶行不能坚立；义人的根必不动摇。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "才德的妻子是丈夫的冠冕；蒙羞的妇人使丈夫骨头朽烂。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "义人的思念是公平；恶人的计谋是诡诈。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "恶人的言论埋伏流人的血；正直人的口却拯救人。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "恶人倾覆，归于无有；义人的家却屹立不倒。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "人按自己的智慧得称赞；心中偏邪的，必被藐视。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "被人藐视，但有自己仆人的，胜过妄自尊大，却缺乏食物。",
      "notes": [
        "“有自己仆人”或译“自己工作”。"
      ]
    },
    {
      "verse": 10,
      "text": "义人顾惜他牲畜的命；恶人的怜悯也是残忍。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "耕种自己田地的，必得饱食；追求虚浮的，却是无知。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "恶人想得坏人的猎物；义人的根结出果实。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "嘴唇的过错是恶人的圈套；但义人必脱离患难。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "人因口所结的果实，必饱得美福；人手所做的，必归到自己身上。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "愚妄人所行的，在自己眼中看为正直；惟智慧人从善如流。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "愚妄人的恼怒立时显露；通达人却能忍辱。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "说出真话的，显明公义；作假见证的，显出诡诈。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "说话浮躁，犹如刺刀；智慧人的舌头却能医治。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "诚实的嘴唇永远坚立；说谎的舌头只存片时。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "图谋恶事的，心存诡诈；劝人和睦的，便得喜乐。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "义人不遭灾害；恶人满受祸患。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "说谎的嘴唇，为耶和华所憎恶；行事诚实，为他所喜悦。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "通达人隐藏知识；愚昧人的心彰显愚昧。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "殷勤人的手必掌权；懒惰的人必服苦役。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "人心忧虑，就必沉重；一句良言，使心欢乐。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "义人引导他的邻舍；恶人的道叫人迷失。",
      "notes": [
        "“义人引导他的邻舍”或译“义人慎选他的朋友”，又或译“义人比他的邻舍更好”。"
      ]
    },
    {
      "verse": 27,
      "text": "懒惰的人不烤猎物；殷勤的人却得宝贵的财物。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "在公义的路上有生命；在其道上并无死亡。",
      "notes": []
    }
  ]
}
