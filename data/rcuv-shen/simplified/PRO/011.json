{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 11,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/11/",
  "verses": [
    {
      "verse": 1,
      "text": "诡诈的天平为耶和华所憎恶；公平的法码为他所喜悦。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "骄傲来，羞耻也来；谦逊人却有智慧。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "正直人的纯正必引导自己；奸诈人的邪恶必毁灭自己。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "遭怒的日子钱财无益；惟有公义能救人脱离死亡。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "完全人的义修平自己的路；但恶人必因自己的恶跌倒。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "正直人的义必拯救自己；奸诈人必被自己的欲望缠住。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "恶人一死，他的指望就灭绝；罪人的盼望也必灭绝。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "义人得脱离患难，有恶人来代替他。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "不虔敬的人用口败坏邻舍；义人却因知识得救。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "义人享福，全城喜乐；恶人灭亡，人人欢呼。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "因正直人的祝福，城必升高；因邪恶人的口，它必倾覆。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "藐视邻舍的，便是无知；聪明人却静默不言。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "到处传话的，泄漏机密；内心老实的，保守秘密。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "无智谋，民就败落；谋士多，就必得胜。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "为陌生人担保的，必受亏损；恨恶击掌的，却得安稳。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "恩慈的妇女得尊荣；强壮的男子得财富。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "仁慈的人善待自己；残忍的人扰害己身。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "恶人做事，得虚幻的报酬；撒公义种子的，得实在的报偿。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "真正行义的，必得生命；追求邪恶的，必致死亡。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "心中歪曲的，为耶和华所憎恶；行为正直的，为他所喜悦。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "击掌保证，恶人难免受罚；义人的后裔必得拯救。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "妇女美貌而无见识，如同金环戴在猪鼻上。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "义人的心愿尽是好的；恶人的指望却带来愤怒。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "有施舍的，钱财增添；吝惜过度，反致穷乏。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "慷慨待人，必然丰裕；滋润人的，连自己也得滋润。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "屯粮不卖的，百姓必诅咒他；愿意出售的，祝福临到头上。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "恳切求善的，就求得恩宠；但那求恶的，恶必临到他。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "倚靠财富的，自己必跌倒；义人必兴旺如绿叶。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "扰害己家的，必承受虚空；愚妄人作心中有智慧者的仆人。",
      "notes": [
        "“虚空”：原文是“风”。"
      ]
    },
    {
      "verse": 30,
      "text": "义人的果实是生命树；智慧人必能得人。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "看哪，义人在地上尚且受报，何况恶人和罪人呢？",
      "notes": []
    }
  ]
}
