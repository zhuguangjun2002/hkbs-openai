{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 18,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/PRO/18/",
  "verses": [
    {
      "verse": 1,
      "text": "孤僻的人只顾自己的心愿，他鄙视一切健全的知识。",
      "notes": [
        "“只顾自己的心愿”：七十士译本和其他古译本是“只顾为自己找藉口”。"
      ]
    },
    {
      "verse": 2,
      "text": "愚昧人不喜爱聪明，只喜爱表达自己的心意。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "邪恶来，藐视跟着来；羞耻到，辱骂同时到。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "人的口所讲的话如同深水，智慧之泉如涌流的河水。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "偏袒恶人的情面，是不好的。审判时使义人受屈，也是不善。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "愚昧人的嘴唇挑起争端，一开口就招鞭打。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "愚昧人的口自取败坏，他的嘴唇是自己生命的圈套。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "造谣者的话如同美食，深入人的肚腹。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "做工懈怠的，是破坏者的兄弟。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "耶和华的名是坚固台，义人奔入就得安稳。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "有钱人的财物是他坚固的城，在他幻想中，犹如高墙。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "败坏之先，人心骄傲；要得尊荣，先有谦卑。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "未听完就回话的，就是他的愚昧和羞辱。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "人的心灵忍耐疾病；心灵忧伤，谁能承当呢？",
      "notes": []
    },
    {
      "verse": 15,
      "text": "聪明人的心得知识；智慧人的耳求知识。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "人的礼物为他开路，引他到高位的人面前。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "先诉情由的，似乎有理；另一人来到，就察出实情。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "掣签能止息纷争，也能化解双方激烈的争辩。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "被冒犯的弟兄强如难以攻下的坚城；纷争如同城堡的门闩。",
      "notes": [
        "“被冒犯的弟兄”：七十士译本是“弟兄互助”。"
      ]
    },
    {
      "verse": 20,
      "text": "人的肚腹必因口所结的果实饱足；他必因嘴唇所出的感到满足。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "生死在舌头的掌握之下，喜爱弄舌的，必吃它所结的果实。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "得着妻子的，得着好处，他是蒙了耶和华的恩惠。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "穷乏人说哀求的话；有钱人却用威吓的话回答。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "朋友太多的人，必受损害；但有一知己比兄弟更亲密。",
      "notes": [
        "“朋友...损害”或译“有些朋友是玩弄友谊的”。"
      ]
    }
  ]
}
