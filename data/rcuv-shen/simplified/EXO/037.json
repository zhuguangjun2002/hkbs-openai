{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "EXO",
  "book_name": "出埃及记",
  "chapter": 37,
  "heading": "造约柜",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/EXO/37/",
  "verses": [
    {
      "verse": 1,
      "text": "比撒列用金合欢木做一个柜子，长二肘半，宽一肘半，高一肘半。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "里里外外包上纯金，四围镶上金边。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他又铸了四个金环，安在柜子的四脚上；这边两个环，那边两个环。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他用金合欢木做了两根杠，包上金子，",
      "notes": []
    },
    {
      "verse": 5,
      "text": "又把杠穿过柜旁的环，以便抬柜。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他用纯金做了一个柜盖，长二肘半，宽一肘半，",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他造两个用金子锤出的基路伯，从柜盖的两端锤出它们。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "这端一个基路伯，那端一个基路伯；从柜盖的两端锤出两个基路伯。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "二基路伯的翅膀向上张开，用翅膀遮住柜盖，脸彼此相对；基路伯的脸朝向柜盖。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "他用金合欢木做了一张供桌，长二肘，宽一肘，高一肘半，",
      "notes": []
    },
    {
      "verse": 11,
      "text": "把它包上纯金，四围镶上金边。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "供桌的四围各做了一掌宽的边缘，边缘镶上金边。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "他又铸了四个金环，把环安在四个桌脚的四角上。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "环靠近边缘，以便穿杠抬供桌。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "他用金合欢木做了两根杠，包上金子，用来抬供桌。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "他又用纯金做了桌上的器具，就是盘、碟，以及浇酒祭的杯和壶。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "他造一座用纯金锤出的灯台；灯台的座、干、杯、花萼和花瓣，都和灯台接连一块。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "灯台两旁伸出六根枝子：这边三根，那边三根。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "这边的枝子上有三个杯，形状像杏花，有花萼有花瓣；那边的枝子上也有三个杯，形状像杏花，有花萼有花瓣。从灯台伸出来的六根枝子都是如此。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "灯台本身有四个杯，形状像杏花，有花萼有花瓣。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "灯台的第一对枝子下面有花萼，灯台的第二对枝子下面有花萼，灯台的第三对枝子下面也有花萼；灯台伸出的六根枝子都是如此。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "花萼和枝子都和灯台接连一块，全是从一块纯金锤出来的。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "他用纯金做灯台的七盏灯，以及灯剪和灯盘。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "他用一他连得的纯金做灯台和灯台的一切器具。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "他用金合欢木做香坛，长一肘，宽一肘，这坛是正方形的，高二肘。坛的四个翘角与坛接连一块。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "他把坛的上面与坛的四围，以及坛的四个翘角包上纯金，又在坛的四围镶上金边。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "他在坛的两个对侧，金边下面做了两个金环，用来穿杠抬坛。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "他又用金合欢木做杠，包上金子。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "他按配制香料的方法制成圣膏油和芬芳的纯香。",
      "notes": []
    }
  ]
}
