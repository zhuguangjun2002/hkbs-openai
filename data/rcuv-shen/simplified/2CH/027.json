{
  "translation": "rcuv-shen",
  "version": "RCUV1s",
  "version_name": "和合本2010 (和修)（神版）",
  "script": "simplified",
  "book_code": "2CH",
  "book_name": "历代志下",
  "chapter": 27,
  "heading": "犹大王约坦",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1s/2CH/27/",
  "verses": [
    {
      "verse": 1,
      "text": "约坦登基的时候年二十五岁，在耶路撒冷作王十六年。他母亲名叫耶路沙，是撒督的女儿。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "约坦行耶和华眼中看为正的事，效法他父亲乌西雅一切所行的，只是他不入耶和华的殿。百姓仍旧行败坏的事。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "约坦建造耶和华殿的上门，在俄斐勒城墙上有很多建设，",
      "notes": []
    },
    {
      "verse": 4,
      "text": "又在犹大山区建造城镇，在树林中建筑营寨和瞭望楼。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "约坦与亚扪人的王打仗，胜了他们。那年亚扪人向他进贡一百他连得银子，一万歌珥小麦，一万歌珥大麦；第二年、第三年亚扪人也这样做。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "约坦日渐强盛，因为他在耶和华－他神面前行正道。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "约坦其余的事和一切战役，以及他的行为，看哪，都写在《以色列和犹大列王记》上。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他登基的时候年二十五岁，在耶路撒冷作王十六年。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "约坦与他祖先同睡，葬在大卫城，他儿子亚哈斯接续他作王。",
      "notes": []
    }
  ]
}
