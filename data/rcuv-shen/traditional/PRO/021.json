{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 21,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PRO/21/",
  "verses": [
    {
      "verse": 1,
      "text": "王的心在耶和華手中像河水，他能使它隨意流轉。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "人一切所行的，在自己眼中看為正直，惟有耶和華衡量人心。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "行公義和公平比獻祭更蒙耶和華悅納。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "眼高心傲，就是惡人的燈，都是罪。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "殷勤籌劃的，足致豐裕；行事急躁的，必致缺乏。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "用詭詐之舌所得的財富如被吹散的霧氣，趨向滅亡。",
      "notes": [
        "「趨向滅亡」：有古卷、七十士譯本和其他古譯本是「和死亡的圈套」。"
      ]
    },
    {
      "verse": 7,
      "text": "惡人的殘暴必掃去自己，因他們不肯按公平行事。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "有罪的人其路彎曲；純潔的人行為正直。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "寧可住在房頂的一角，也不與好爭吵的婦人同住。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "惡人的心渴想邪惡，他的眼並不憐憫鄰舍。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "傲慢人受懲罰，愚蒙人可得智慧；智慧人受訓誨，便得知識。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "公義的神鑒察惡人的家，他傾覆惡人，以致滅亡。",
      "notes": [
        "「公義的神」或譯「義人」。"
      ]
    },
    {
      "verse": 13,
      "text": "塞耳不聽貧寒人哀求的，他自己呼求，也不蒙應允。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "暗中送的禮物挽回怒氣，懷裏的賄賂能止息暴怒。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "秉公行義使義人喜樂，卻使作惡的人敗壞。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "人偏離智慧的路，必與陰魂為伍。",
      "notes": [
        "「必與陰魂為伍」：原文是「必住在陰魂的會中」。"
      ]
    },
    {
      "verse": 17,
      "text": "愛宴樂的，必致窮乏；貪愛酒和油的，必不富足。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "惡人作義人的贖價，奸詐人代替正直人。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "寧可住在曠野之地，也不與爭吵易怒的婦人同住。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "智慧人的居所積蓄寶物與膏油；愚昧人卻揮霍一空。",
      "notes": [
        "「智慧人...膏油」：七十士譯本是「渴慕的寶物留在智慧人的嘴上」。"
      ]
    },
    {
      "verse": 21,
      "text": "追求公義慈愛的，就尋得生命、公義和尊榮。",
      "notes": [
        "七十士譯本沒有「公義」。"
      ]
    },
    {
      "verse": 22,
      "text": "智慧人爬上勇士的城牆，摧毀他所倚靠的堡壘。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "謹守口和舌的，就保護自己免受災難。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "心驕氣傲的人名叫傲慢，他行事出於狂妄驕傲。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "懶惰人的慾望害死自己，因為他的手不肯做工；",
      "notes": []
    },
    {
      "verse": 26,
      "text": "有人終日貪得無饜，義人卻施捨而不吝惜。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "惡人獻的祭是可憎的，何況他存惡意來獻呢？",
      "notes": []
    },
    {
      "verse": 28,
      "text": "不實的見證必消滅；惟聆聽真情的，他的證詞有力。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "惡人臉無羞恥；正直人行事堅定。",
      "notes": [
        "「正直人行事堅定」：原文另譯「正直人明白己道」。"
      ]
    },
    {
      "verse": 30,
      "text": "沒有人能以智慧、聰明、謀略抵擋耶和華。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "馬是為打仗之日預備的；得勝卻在於耶和華。",
      "notes": []
    }
  ]
}
