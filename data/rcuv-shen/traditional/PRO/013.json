{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 13,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PRO/13/",
  "verses": [
    {
      "verse": 1,
      "text": "智慧之子聽父親的訓誨；傲慢人不聽責備。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "人因口所結的果實，必享美福；奸詐人卻意圖殘暴。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "謹慎守口的，得保生命；大張嘴唇的，必致敗亡。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "懶惰的人奢求，卻無所得；殷勤的人必然豐裕。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "義人恨惡謊言；惡人可憎可恥。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "行為純正的，有公義保護；犯罪的，被罪惡傾覆。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "假冒富足的，一無所有；裝作窮乏的，多有財物。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "財富可作人的生命贖價；窮乏人卻聽不見威嚇的話。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "義人的光使人歡喜；惡人的燈要熄滅。",
      "notes": [
        "「使人歡喜」：原文另譯「明亮」。"
      ]
    },
    {
      "verse": 10,
      "text": "驕傲挑啟紛爭；聽勸言卻有智慧。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "不勞而獲之財必減少；逐漸積蓄的必增多。",
      "notes": [
        "「不勞而獲之財」：七十士譯本是「暴發的不義之財」。"
      ]
    },
    {
      "verse": 12,
      "text": "盼望遲延，令人心憂；願望實現，就是得到生命樹。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "藐視訓言的，自取滅亡；敬畏誡命的，必得善報。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "智慧人的教誨是生命的泉源，使人避開死亡的圈套。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "美好的見識使人得寵；奸詐人的道路恆久奸詐。",
      "notes": [
        "「恆久奸詐」：原文是「恆久」。"
      ]
    },
    {
      "verse": 16,
      "text": "通達人都憑知識行事；愚昧人張揚自己的愚昧。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "邪惡的使者必陷入禍患；忠信的使臣帶來醫治。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "棄絕管教的，必貧窮受辱；領受責備的，必享尊榮。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "願望實現，心覺甘甜；遠離惡事，為愚昧人所憎惡。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "與智慧人同行的，必得智慧；和愚昧人作伴的，必受虧損。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "禍患追趕罪人；義人卻得善報。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "善人給子孫遺留產業；罪人積財卻歸義人。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "窮乏人開墾的地雖多產糧食，卻因不公而被奪走。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "不忍用杖打兒子的，是恨惡他；疼愛兒子的，勤加管教。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "義人吃喝食慾滿足；惡人肚腹卻是缺乏。",
      "notes": []
    }
  ]
}
