{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 11,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PRO/11/",
  "verses": [
    {
      "verse": 1,
      "text": "詭詐的天平為耶和華所憎惡；公平的法碼為他所喜悅。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "驕傲來，羞恥也來；謙遜人卻有智慧。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "正直人的純正必引導自己；奸詐人的邪惡必毀滅自己。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "遭怒的日子錢財無益；惟有公義能救人脫離死亡。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "完全人的義修平自己的路；但惡人必因自己的惡跌倒。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "正直人的義必拯救自己；奸詐人必被自己的慾望纏住。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "惡人一死，他的指望就滅絕；罪人的盼望也必滅絕。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "義人得脫離患難，有惡人來代替他。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "不虔敬的人用口敗壞鄰舍；義人卻因知識得救。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "義人享福，全城喜樂；惡人滅亡，人人歡呼。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "因正直人的祝福，城必升高；因邪惡人的口，它必傾覆。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "藐視鄰舍的，便是無知；聰明人卻靜默不言。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "到處傳話的，洩漏機密；內心老實的，保守祕密。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "無智謀，民就敗落；謀士多，就必得勝。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "為陌生人擔保的，必受虧損；恨惡擊掌的，卻得安穩。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "恩慈的婦女得尊榮；強壯的男子得財富。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "仁慈的人善待自己；殘忍的人擾害己身。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "惡人做事，得虛幻的報酬；撒公義種子的，得實在的報償。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "真正行義的，必得生命；追求邪惡的，必致死亡。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "心中歪曲的，為耶和華所憎惡；行為正直的，為他所喜悅。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "擊掌保證，惡人難免受罰；義人的後裔必得拯救。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "婦女美貌而無見識，如同金環戴在豬鼻上。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "義人的心願盡是好的；惡人的指望卻帶來憤怒。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "有施捨的，錢財增添；吝惜過度，反致窮乏。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "慷慨待人，必然豐裕；滋潤人的，連自己也得滋潤。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "屯糧不賣的，百姓必詛咒他；願意出售的，祝福臨到頭上。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "懇切求善的，就求得恩寵；但那求惡的，惡必臨到他。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "倚靠財富的，自己必跌倒；義人必興旺如綠葉。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "擾害己家的，必承受虛空；愚妄人作心中有智慧者的僕人。",
      "notes": [
        "「虛空」：原文是「風」。"
      ]
    },
    {
      "verse": 30,
      "text": "義人的果實是生命樹；智慧人必能得人。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "看哪，義人在地上尚且受報，何況惡人和罪人呢？",
      "notes": []
    }
  ]
}
