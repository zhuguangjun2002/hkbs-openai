{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 29,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PRO/29/",
  "verses": [
    {
      "verse": 1,
      "text": "人屢次受責罰，仍然硬著頸項，他必頃刻被毀，無從醫治。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "義人增多，民就喜樂；惡人掌權，民就嘆息。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "愛慕智慧的，使父親喜樂；結交妓女的，卻浪費錢財。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "王藉公平，使國堅定；強索貢物的，使它毀壞。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "諂媚鄰舍的，就是設網羅絆他的腳。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "惡人犯罪，自陷圈套；惟獨義人歡呼喜樂。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "義人關注貧寒人的案情；惡人不明瞭這種知識。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "傲慢人煽動全城；智慧人止息眾怒。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "智慧人與愚妄人有爭訟，或怒或笑，總不得安寧。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "好流人血的，恨惡完全人，正直人卻顧惜他的性命。",
      "notes": [
        "「顧惜」：原文是「尋索」。"
      ]
    },
    {
      "verse": 11,
      "text": "愚昧人怒氣全發；智慧人自我平息。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "君王若聽謊言，他一切臣僕都是奸惡。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "窮乏人和欺壓者相遇，耶和華使他們的眼目明亮。",
      "notes": [
        "「相遇」或譯「是一樣的」。"
      ]
    },
    {
      "verse": 14,
      "text": "君王憑誠信判斷貧寒人，他的國位必永遠堅立。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "杖打和責備能增加智慧；任性的少年使母親羞愧。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "惡人多，過犯也加多，義人必看見他們敗亡。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "管教你的兒子，他就使你得安寧，也使你心裏喜樂。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "沒有異象，民就放肆；惟遵守律法的，便為有福。",
      "notes": [
        "「異象」或譯「默示」。"
      ]
    },
    {
      "verse": 19,
      "text": "僕人不能靠言語受教；他即使明白，也不回應。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "你見過言語急躁的人嗎？愚昧人比他更有指望。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "人將僕人從小嬌養，至終必帶來憂傷。",
      "notes": [
        "「至終必帶來憂傷」或譯「這僕人至終必成了他的繼承人」。"
      ]
    },
    {
      "verse": 22,
      "text": "好生氣的人挑起爭端，暴怒的人多多犯錯。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "人的高傲使自己蒙羞；心裏謙遜的，必得尊榮。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "與盜賊分贓的，是恨惡自己的性命；他雖聽見發誓的聲音，也不告訴人。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "懼怕人的，陷入圈套；惟有倚靠耶和華的，必得安穩。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "求王恩的人多；人獲公正來自耶和華。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "不義之人，義人憎惡；行事正直的，惡人憎惡。",
      "notes": []
    }
  ]
}
