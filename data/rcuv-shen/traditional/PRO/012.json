{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 12,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PRO/12/",
  "verses": [
    {
      "verse": 1,
      "text": "喜愛管教的，就是喜愛知識；恨惡責備的，卻像畜牲。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "善人蒙耶和華的恩寵；設詭計的，耶和華必定罪。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "人靠惡行不能堅立；義人的根必不動搖。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "才德的妻子是丈夫的冠冕；蒙羞的婦人使丈夫骨頭朽爛。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "義人的思念是公平；惡人的計謀是詭詐。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "惡人的言論埋伏流人的血；正直人的口卻拯救人。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "惡人傾覆，歸於無有；義人的家卻屹立不倒。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "人按自己的智慧得稱讚；心中偏邪的，必被藐視。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "被人藐視，但有自己僕人的，勝過妄自尊大，卻缺乏食物。",
      "notes": [
        "「有自己僕人」或譯「自己工作」。"
      ]
    },
    {
      "verse": 10,
      "text": "義人顧惜他牲畜的命；惡人的憐憫也是殘忍。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "耕種自己田地的，必得飽食；追求虛浮的，卻是無知。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "惡人想得壞人的獵物；義人的根結出果實。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "嘴唇的過錯是惡人的圈套；但義人必脫離患難。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "人因口所結的果實，必飽得美福；人手所做的，必歸到自己身上。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "愚妄人所行的，在自己眼中看為正直；惟智慧人從善如流。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "愚妄人的惱怒立時顯露；通達人卻能忍辱。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "說出真話的，顯明公義；作假見證的，顯出詭詐。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "說話浮躁，猶如刺刀；智慧人的舌頭卻能醫治。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "誠實的嘴唇永遠堅立；說謊的舌頭只存片時。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "圖謀惡事的，心存詭詐；勸人和睦的，便得喜樂。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "義人不遭災害；惡人滿受禍患。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "說謊的嘴唇，為耶和華所憎惡；行事誠實，為他所喜悅。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "通達人隱藏知識；愚昧人的心彰顯愚昧。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "殷勤人的手必掌權；懶惰的人必服苦役。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "人心憂慮，就必沉重；一句良言，使心歡樂。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "義人引導他的鄰舍；惡人的道叫人迷失。",
      "notes": [
        "「義人引導他的鄰舍」或譯「義人慎選他的朋友」，又或譯「義人比他的鄰舍更好」。"
      ]
    },
    {
      "verse": 27,
      "text": "懶惰的人不烤獵物；殷勤的人卻得寶貴的財物。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "在公義的路上有生命；在其道上並無死亡。",
      "notes": []
    }
  ]
}
