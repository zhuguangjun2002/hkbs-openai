{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 31,
  "heading": "給君王的忠告",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PRO/31/",
  "verses": [
    {
      "verse": 1,
      "text": "瑪撒王利慕伊勒的言語，就是他母親教導他的。",
      "notes": [
        "「瑪撒王...他的」或譯「利慕伊勒王的言語，是他母親教導他的神諭」。"
      ]
    },
    {
      "verse": 2,
      "text": "我兒，怎麼了？我腹中生的兒，怎麼了？我許願而得的兒，怎麼了？",
      "notes": []
    },
    {
      "verse": 3,
      "text": "不要將你的精力給婦女，也不要有敗壞君王的行為。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "利慕伊勒啊，君王不宜，君王不宜喝酒，王子尋找烈酒也不相宜；",
      "notes": []
    },
    {
      "verse": 5,
      "text": "恐怕喝了就忘記所頒的法令，顛倒所有困苦人的是非。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "可以把烈酒給將亡的人喝，把酒給心裏愁苦的人喝，",
      "notes": []
    },
    {
      "verse": 7,
      "text": "讓他喝了，就忘記他的貧窮，不再記得他的苦楚。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "你當為不能自辯的人開口，為所有孤獨無助者伸冤。",
      "notes": [
        "「不能自辯的人」或譯「啞巴」。"
      ]
    },
    {
      "verse": 9,
      "text": "你當開口按公義判斷，當為困苦和貧窮的人辯護。",
      "notes": []
    },
    {
      "verse": 10,
      "section_headings": [
        "論賢妻"
      ],
      "text": "才德的婦人誰能得著呢？她的價值遠勝過寶石。",
      "notes": [
        "由本節開始，原文是字母詩。"
      ]
    },
    {
      "verse": 11,
      "text": "她丈夫心裏信賴她，必不缺少利益；",
      "notes": []
    },
    {
      "verse": 12,
      "text": "她終其一生，使丈夫有益無損。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "她尋找羊毛和麻，歡喜用手做工。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "她好像商船，從遠方運來糧食，",
      "notes": []
    },
    {
      "verse": 15,
      "text": "未到黎明她就起來，把食物分給家中的人，將當做的工分派女僕。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "她想得田地，就去買來，用手中的成果栽葡萄園。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "她以能力束腰，使膀臂有力。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "她覺得自己獲利不錯，她的燈終夜不滅。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "她伸手拿捲線桿，她的手掌把住紡車。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "她張手賙濟困苦人，伸手幫助貧窮人。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "她不因下雪為家裏的人擔心，因為全家都穿上朱紅衣服。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "她為自己製作被單，她的衣服是細麻和紫色布做的。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "她丈夫在城門口與本地的長老同坐，為人所認識。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "她做細麻布衣裳來賣，又將腰帶賣給商家。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "能力和威儀是她的衣服，她想到日後的景況就喜笑。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "她開口就發智慧，她舌上有仁慈的教誨。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "她管理家務，並不吃閒飯。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "她的兒女起來稱她有福，她的丈夫也稱讚她：",
      "notes": []
    },
    {
      "verse": 29,
      "text": "「才德的女子很多，惟獨你超過一切。」",
      "notes": []
    },
    {
      "verse": 30,
      "text": "魅力是虛假的，美貌是虛浮的；惟敬畏耶和華的婦女必得稱讚。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "她手中的成果你們要賞給她，願她的工作在城門口榮耀她。",
      "notes": []
    }
  ]
}
