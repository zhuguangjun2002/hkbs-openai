{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 14,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PRO/14/",
  "verses": [
    {
      "verse": 1,
      "text": "婦人的智慧建立家室；愚昧卻親手拆毀它。",
      "notes": [
        "本節七十士譯本是「智慧婦人建立家室；愚妄婦人親手拆毀」。"
      ]
    },
    {
      "verse": 2,
      "text": "行事正直的，敬畏耶和華；偏離正路的，卻藐視他。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "在愚妄人的口中有驕傲的杖；智慧人的嘴唇必保護自己。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "沒有牛，槽就空空；土產豐盛卻憑牛的力氣。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "誠實的證人不說謊；虛假的證人口吐謊言。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "傲慢人枉尋智慧；聰明人易得知識。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "不要到愚昧人面前，你無法從他嘴唇裏知道知識。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "通達人的智慧使他認清自己的道路；愚昧人的愚昧卻是自欺。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "愚妄人嘲笑贖愆祭；但正直人蒙悅納。",
      "notes": [
        "「贖愆祭」或譯「復和」。"
      ]
    },
    {
      "verse": 10,
      "text": "心中的苦楚，只有自己知道；心裏的喜樂，陌生人無法分享。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "惡人的房屋必倒塌；正直人的帳棚必興旺。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "有一條路，人以為正，至終成為死亡之路。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "人在喜笑中，心也會憂愁；快樂的終點就是愁苦。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "心中背道的，必滿嘗其果；善人必從自己的行為得到回報。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "無知的人甚麼話都信；通達人謹慎自己的腳步。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "智慧人有所懼怕，就遠離惡事；愚昧人卻狂傲自恃。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "輕易發怒的，行事愚昧；擅長詭計的，被人恨惡。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "愚蒙人承受愚昧為產業；通達人得知識為冠冕。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "壞人在善人面前俯伏；惡人在義人門口也是如此。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "窮乏人，連鄰舍也恨他；有錢人，愛他的人眾多。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "藐視鄰舍的，這人有罪；施恩給困苦人的，這人有福。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "謀惡的，豈非走入迷途？謀善的，有慈愛和誠實。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "任何勤勞總有收穫；僅耍嘴皮必致窮乏。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "智慧人的冠冕是富有智慧；愚昧人的愚昧終究是愚昧。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "誠實作證，救人性命；口吐謊言是詭詐。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "敬畏耶和華的，大有倚靠；他的兒女也有避難所。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "敬畏耶和華是生命的泉源，使人離開死亡的圈套。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "君王的榮耀在乎民多；沒有百姓，王就衰敗。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "不輕易發怒的，大有聰明；性情暴躁的，大顯愚昧。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "平靜的心使肉體有生氣；嫉妒使骨頭朽爛。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "欺壓貧寒人的，是蔑視造他的主；憐憫貧窮人的，是尊敬主。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "惡人因所行的惡必被推倒；義人臨死，有所投靠。",
      "notes": [
        "「義人臨死」：七十士譯本是「義人因其完全」。"
      ]
    },
    {
      "verse": 33,
      "text": "智慧安居在聰明人的心中，在愚昧人的心中卻不認識。",
      "notes": [
        "「在愚昧人...不認識」是根據七十士譯本；原文是「也為愚昧人的心所知」。"
      ]
    },
    {
      "verse": 34,
      "text": "公義使邦國高舉；罪惡是百姓的羞辱。",
      "notes": []
    },
    {
      "verse": 35,
      "text": "君王的恩寵臨到智慧的臣僕；但其憤怒臨到蒙羞的臣僕。",
      "notes": []
    }
  ]
}
