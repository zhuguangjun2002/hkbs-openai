{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 22,
  "heading": "智言三十則",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PRO/22/",
  "verses": [
    {
      "verse": 1,
      "text": "美名勝過大財，宏恩強如金銀。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "有錢人與窮乏人相遇，他們都為耶和華所造。",
      "notes": [
        "「相遇」或譯「是一樣的」。"
      ]
    },
    {
      "verse": 3,
      "text": "通達人見禍就藏躲；愚蒙人卻前往受害。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "敬畏耶和華心存謙卑，就得財富、尊榮、生命為賞賜。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "歪曲的人路上有荊棘和羅網，保護自己生命的，必要遠離。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "教養孩童走當行的道，就是到老他也不偏離。",
      "notes": [
        "七十士譯本沒有本節。"
      ]
    },
    {
      "verse": 7,
      "text": "有錢人管轄窮乏人，欠債的是債主的僕人。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "撒不義種子的必收割災禍，他逞怒的杖也必廢掉。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "眼目仁慈的必蒙福，因他將食物分給貧寒人。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "趕出傲慢人，爭端就消除，紛爭和羞辱也必止息。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "喜愛清心，嘴唇有恩言的，王必與他為友。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "耶和華的眼目保護知識，卻毀壞奸詐人的言語。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "懶惰人說：「外面有獅子，我在街上必被殺害。」",
      "notes": []
    },
    {
      "verse": 14,
      "text": "陌生女子的口是深坑，耶和華所憎惡的，必陷在其中。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "愚昧迷住孩童的心，用管教的杖可以遠遠趕除。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "欺壓貧寒人為要利己的，並送禮給有錢人的，都必缺乏。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "你要側耳聽智慧人的言語，留心領會我的知識。",
      "notes": [
        "「你要...言語」：七十士譯本是「智慧人的言語：你要側耳聽我的言語」。"
      ]
    },
    {
      "verse": 18,
      "text": "你若心中存記，嘴唇也準備就緒，這是美的。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "我今日特地指教你，為要使你倚靠耶和華。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "謀略和知識的美事，我豈沒有寫給你嗎？",
      "notes": [
        "「美事」：原文另譯「三十句」。"
      ]
    },
    {
      "verse": 21,
      "text": "要使你明白真情實理，好將實情回覆那差你來的人。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "不可因人貧寒就搶奪他，也不可在城門口欺壓困苦人，",
      "notes": []
    },
    {
      "verse": 23,
      "text": "因耶和華必為他們辯護，也必奪取那搶奪者的命。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "不可結交好生氣的人，也不可與暴怒的人來往，",
      "notes": []
    },
    {
      "verse": 25,
      "text": "恐怕你效法他的行為，自己就陷在圈套裏。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "不要為人擊掌擔保，也不要為債務作保。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "你若沒有甚麼可償還，何必使人奪去你睡臥的床呢？",
      "notes": []
    },
    {
      "verse": 28,
      "text": "祖先所立的地界，你不可挪移。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "你看見辦事殷勤的人嗎？他必侍立在君王面前，不在平庸的人面前。",
      "notes": []
    }
  ]
}
