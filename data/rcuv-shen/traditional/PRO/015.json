{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 15,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PRO/15/",
  "verses": [
    {
      "verse": 1,
      "text": "回答柔和，使怒消退；言語粗暴，觸動怒氣。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "智慧人的舌善發知識；愚昧人的口吐出愚昧。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "耶和華的眼目無處不在，惡人善人，他都鑒察。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "溫良的舌是生命樹；邪惡的舌使人心碎。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "愚妄人藐視父親的管教；領受責備，使人精明。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "義人家中多有財富；惡人獲利反受擾害。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "智慧人的嘴傳揚知識；愚昧人的心並非如此。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "惡人獻祭，為耶和華所憎惡；正直人祈禱，為他所喜悅。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "惡人的道路，為耶和華所憎惡；追求公義的，為他所喜愛。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "背棄正路的，必受嚴刑；恨惡責備的，必致死亡。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "陰間和冥府尚且在耶和華面前，何況世人的心呢？",
      "notes": [
        "「冥府」：原文音譯「亞巴頓」，意思是「滅亡之地」。"
      ]
    },
    {
      "verse": 12,
      "text": "傲慢人不愛受責備，也不去接近智慧人。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "心中喜樂，面有喜色；心裏憂愁，靈就憂傷。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "聰明人的心追求知識；愚昧人的口吞吃愚昧。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "困苦人的日子都是愁苦；心中歡暢的，常享宴席。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "財寶稀少，敬畏耶和華，強如財寶眾多，煩亂不安。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "有愛，吃素菜，強如相恨，吃肥牛。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "暴怒的人挑啟爭端；忍怒的人止息紛爭。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "懶惰人的道像荊棘的籬笆；正直人的路是平坦大道。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "智慧之子使父親喜樂；愚昧的人藐視母親。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "無知的人以愚昧為樂；聰明的人按正直而行。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "不先商議，所謀無效；謀士眾多，所謀得成。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "口善應對，自覺喜樂；話合其時，何等美好。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "生命之道使智慧人上升，使他遠離底下的陰間。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "耶和華必拆毀驕傲人的家，卻要立定寡婦的地界。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "惡謀為耶和華所憎惡；良言卻是純淨的。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "暴力歛財的，擾害己家；恨惡賄賂的，必得存活。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "義人的心思量應答；惡人的口吐出惡言。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "耶和華遠離惡人，卻聽義人的祈禱。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "眼睛發光，使心喜樂；好的信息，滋潤骨頭。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "耳聽使人得生命的責備，必居住在智慧人之中。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "棄絕管教的，輕看自己的生命；領受責備的，卻得智慧的心。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "敬畏耶和華是智慧的訓誨；要得尊榮，先有謙卑。",
      "notes": []
    }
  ]
}
