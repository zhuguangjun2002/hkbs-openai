{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "LAM",
  "book_name": "耶利米哀歌",
  "chapter": 3,
  "heading": "懲罰、悔改、盼望",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/LAM/3/",
  "verses": [
    {
      "verse": 1,
      "text": "因耶和華憤怒的杖，我是遭遇困苦的人。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "他驅趕我走入黑暗，沒有光明。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他反手攻擊我，終日不停。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他使我皮肉枯乾，折斷我的骨頭。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "他築壘攻擊我，以苦楚和艱難圍困我；",
      "notes": []
    },
    {
      "verse": 6,
      "text": "使我住在幽暗之處，像死了許久的人一樣。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他圍住我，使我無法脫身；他使我的銅鏈沉重。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "儘管我哀號求救，他仍攔阻我的禱告。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他用鑿過的石頭擋住我的道路，使我的路徑彎曲。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "他向我如埋伏的熊，如在隱密處的獅子。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "他使我轉離正路，把我撕碎，使我淒涼。",
      "notes": [
        "「把我撕碎」：有一古譯本是「使我跛腳」。"
      ]
    },
    {
      "verse": 12,
      "text": "他拉弓，命我站立，當作箭靶；",
      "notes": []
    },
    {
      "verse": 13,
      "text": "把箭袋中的箭射入我的肺腑。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "我成了全體百姓的笑柄，成了他們終日的歌曲。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "他使我受盡苦楚，飽食茵蔯；",
      "notes": []
    },
    {
      "verse": 16,
      "text": "用沙石磨斷我的牙，以灰塵覆蓋我。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "你使我遠離平安，我忘了何為福樂。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "於是我說：「我的力量衰敗，在耶和華那裏我毫無指望！」",
      "notes": []
    },
    {
      "verse": 19,
      "text": "求你記得我的困苦和流離，它如茵蔯和苦膽一般；",
      "notes": []
    },
    {
      "verse": 20,
      "text": "我心想念這些，就在我裏面憂悶。",
      "notes": [
        "「憂悶」：原文另譯「沉思」。"
      ]
    },
    {
      "verse": 21,
      "text": "但我的心回轉過來，因此就有指望；",
      "notes": []
    },
    {
      "verse": 22,
      "text": "因耶和華的慈愛，我們不致滅絕，因他的憐憫永不斷絕，",
      "notes": [
        "「我們不致滅絕」：有古卷是「從不止息」。"
      ]
    },
    {
      "verse": 23,
      "text": "每早晨，這都是新的；你的信實極其廣大！",
      "notes": []
    },
    {
      "verse": 24,
      "text": "我心裏說：「耶和華是我的福分，因此，我要仰望他。」",
      "notes": []
    },
    {
      "verse": 25,
      "text": "凡等候耶和華，心裏尋求他的，耶和華必施恩給他。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "人仰望耶和華，安靜等候他的救恩，這是好的。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "人在年輕時負軛，這是好的。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "他當安靜獨坐，因為這是耶和華加在他身上的。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "讓他臉伏於地吧！或者還會有指望。",
      "notes": [
        "「臉伏於地」：原文是「口貼塵土」。"
      ]
    },
    {
      "verse": 30,
      "text": "讓人打他耳光，使他飽受凌辱吧！",
      "notes": []
    },
    {
      "verse": 31,
      "text": "主必不永遠撇棄，",
      "notes": []
    },
    {
      "verse": 32,
      "text": "他雖使人憂愁，還要照他豐盛的慈愛施憐憫；",
      "notes": []
    },
    {
      "verse": 33,
      "text": "他並不存心要人受苦，令世人憂愁。",
      "notes": []
    },
    {
      "verse": 34,
      "text": "把世上所有的囚犯踹在腳下，",
      "notes": []
    },
    {
      "verse": 35,
      "text": "在至高者面前扭曲人的公正，",
      "notes": []
    },
    {
      "verse": 36,
      "text": "在人的訴訟上顛倒是非，這都是主看不中的。",
      "notes": []
    },
    {
      "verse": 37,
      "text": "若非主發命令，誰能說了就成呢？",
      "notes": []
    },
    {
      "verse": 38,
      "text": "是禍，是福，不都出於至高者的口嗎？",
      "notes": []
    },
    {
      "verse": 39,
      "text": "人都有自己的罪，活人有甚麼好發怨言的呢？",
      "notes": []
    },
    {
      "verse": 40,
      "text": "讓我們省察，檢討自己的行為，歸向耶和華吧！",
      "notes": []
    },
    {
      "verse": 41,
      "text": "讓我們獻上我們的心，向天上的神舉手！",
      "notes": []
    },
    {
      "verse": 42,
      "text": "我們犯罪悖逆，你並未赦免。",
      "notes": []
    },
    {
      "verse": 43,
      "text": "你渾身是怒氣，追趕我們；你施行殺戮，並不顧惜。",
      "notes": []
    },
    {
      "verse": 44,
      "text": "你以密雲圍著自己，禱告不能穿透。",
      "notes": []
    },
    {
      "verse": 45,
      "text": "你使我們在萬民中成為污物和垃圾。",
      "notes": []
    },
    {
      "verse": 46,
      "text": "我們所有的仇敵張口來攻擊我們；",
      "notes": []
    },
    {
      "verse": 47,
      "text": "驚嚇和陷阱臨到我們，殘害和毀滅也臨到我們。",
      "notes": []
    },
    {
      "verse": 48,
      "text": "因我百姓遭毀滅，我的眼睛淚流成河。",
      "notes": [
        "「我百姓」：原文直譯「我百姓的女兒」。"
      ]
    },
    {
      "verse": 49,
      "text": "我的眼睛流淚不停，流淚不止，",
      "notes": []
    },
    {
      "verse": 50,
      "text": "直等到耶和華垂顧，從天上觀看。",
      "notes": []
    },
    {
      "verse": 51,
      "text": "為我城中的百姓，我眼所見的使我心痛。",
      "notes": [
        "「百姓」：原文直譯「女子們」。"
      ]
    },
    {
      "verse": 52,
      "text": "無故與我為敵的追逼我，像追捕雀鳥一樣。",
      "notes": []
    },
    {
      "verse": 53,
      "text": "他們要在坑中了結我的性命，丟石頭在我身上。",
      "notes": []
    },
    {
      "verse": 54,
      "text": "眾水淹沒我的頭，我說：「我沒命了！」",
      "notes": []
    },
    {
      "verse": 55,
      "text": "耶和華啊，在極深的地府裏，我求告你的名。",
      "notes": []
    },
    {
      "verse": 56,
      "text": "我的聲音你聽見了，求你不要掩耳不聽我的呼聲，我的求救。",
      "notes": []
    },
    {
      "verse": 57,
      "text": "我求告你的時候，你臨近我，說：「不要懼怕！」",
      "notes": []
    },
    {
      "verse": 58,
      "text": "主啊，你為我伸冤，你救贖了我的命。",
      "notes": []
    },
    {
      "verse": 59,
      "text": "耶和華啊，你已看見我的委屈，求你為我主持正義。",
      "notes": []
    },
    {
      "verse": 60,
      "text": "他們要報復，謀害我，你都看見了。",
      "notes": []
    },
    {
      "verse": 61,
      "text": "耶和華啊，你聽見他們的辱罵，他們害我的一切計謀，",
      "notes": []
    },
    {
      "verse": 62,
      "text": "那些起來攻擊我的人嘴唇所說的話和他們終日攻擊我的計謀。",
      "notes": []
    },
    {
      "verse": 63,
      "text": "求你留意！他們無論坐下或起來，我都是他們的笑柄。",
      "notes": []
    },
    {
      "verse": 64,
      "text": "耶和華啊，求你照他們手所做的向他們施行報應。",
      "notes": []
    },
    {
      "verse": 65,
      "text": "求你使他們心裏剛硬，使你的詛咒臨到他們。",
      "notes": []
    },
    {
      "verse": 66,
      "text": "求你發怒追趕他們，從耶和華的地上除滅他們。",
      "notes": [
        "「地上」：原文是「諸天底下」。"
      ]
    }
  ]
}
