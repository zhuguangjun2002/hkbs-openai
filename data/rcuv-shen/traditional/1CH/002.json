{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "1CH",
  "book_name": "歷代志上",
  "chapter": 2,
  "heading": "猶大的後裔",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/1CH/2/",
  "verses": [
    {
      "verse": 1,
      "text": "以色列的兒子是呂便、西緬、利未、猶大、以薩迦、西布倫、",
      "notes": []
    },
    {
      "verse": 2,
      "text": "但、約瑟、便雅憫、拿弗他利、迦得和亞設。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "猶大的兒子是珥、俄南和示拉，這三人是迦南女子拔‧書亞所生的。猶大的長子珥在耶和華眼中看為惡，耶和華就殺死了他。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "猶大的媳婦她瑪為猶大生了法勒斯和謝拉。猶大共有五個兒子。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "法勒斯的兒子是希斯崙和哈母勒。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "謝拉的兒子是心利、以探、希幔、甲各和大拉，共五人。",
      "notes": [
        "「大拉」：七十士譯本的一些抄本和其他古譯本是「達大」；參王上4．31。"
      ]
    },
    {
      "verse": 7,
      "text": "迦米的兒子是亞迦，他在當滅的物上犯了罪，連累了以色列人。",
      "notes": [
        "「亞迦」：有古卷是「亞干」；參書7．18。"
      ]
    },
    {
      "verse": 8,
      "text": "以探的兒子是亞撒利雅。",
      "notes": []
    },
    {
      "verse": 9,
      "section_headings": [
        "大衛王的家譜"
      ],
      "text": "希斯崙所生的兒子是耶拉篾、蘭和基路拜。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "蘭生亞米拿達；亞米拿達生拿順，拿順是猶大人的領袖。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "拿順生撒門；撒門生波阿斯；",
      "notes": []
    },
    {
      "verse": 12,
      "text": "波阿斯生俄備得；俄備得生耶西；",
      "notes": []
    },
    {
      "verse": 13,
      "text": "耶西生長子以利押，次子亞比拿達，三子示米亞，",
      "notes": [
        "「示米亞」：撒上16．9稱「沙瑪」。"
      ]
    },
    {
      "verse": 14,
      "text": "四子拿坦業，五子拉代，",
      "notes": []
    },
    {
      "verse": 15,
      "text": "六子阿鮮，七子大衛。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "他們的姊妹是洗魯雅和亞比該。洗魯雅的兒子是亞比篩、約押和亞撒黑，共三人。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "亞比該生亞瑪撒；亞瑪撒的父親是以實瑪利人益帖。",
      "notes": []
    },
    {
      "verse": 18,
      "section_headings": [
        "希斯崙的後裔"
      ],
      "text": "希斯崙的兒子迦勒娶阿蘇巴和耶略為妻，阿蘇巴的兒子是耶設、朔罷和押墩。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "阿蘇巴死了，迦勒又娶以法她，生了戶珥。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "戶珥生烏利；烏利生比撒列。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "後來，希斯崙六十歲時娶了基列的父親瑪吉的女兒，與她同房；瑪吉的女兒為他生了西割；",
      "notes": []
    },
    {
      "verse": 22,
      "text": "西割生睚珥。睚珥在基列地有二十三座城。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "後來基述和亞蘭奪了哈倭特‧睚珥，以及基納和所屬的鄉鎮，共六十個。這些城鎮的人全都是基列的父親瑪吉的子孫。",
      "notes": [
        "「鄉鎮」：原文直譯「女子們」；本卷書下同。"
      ]
    },
    {
      "verse": 24,
      "text": "希斯崙在迦勒‧以法他死後，他的妻子亞比雅為他生了提哥亞的父親亞施戶。",
      "notes": [
        "本節七十士譯本是「希斯崙死後，迦勒到了以法他。希斯崙的妻子是亞比雅，為他生了提哥亞的父親亞施戶。」"
      ]
    },
    {
      "verse": 25,
      "section_headings": [
        "耶拉篾的後裔"
      ],
      "text": "希斯崙的長子耶拉篾的兒子有長子蘭、布拿、阿連、阿鮮和亞希雅。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "耶拉篾又娶一妻名叫亞她拉，是阿南的母親。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "耶拉篾的長子蘭的兒子有瑪斯、雅憫和以結。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "阿南的兒子是沙買和雅大。沙買的兒子是拿答和亞比述。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "亞比述的妻子名叫亞比孩，為他生了亞辦和摩利。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "拿答的兒子是西列和亞遍；西列死了，沒有兒子。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "亞遍的兒子是以示；以示的兒子是示珊；示珊的兒子是亞來。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "沙買的兄弟雅大的兒子是益帖和約拿單；益帖死了，沒有兒子。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "約拿單的兒子是比勒和撒薩。這些都是耶拉篾的子孫。",
      "notes": []
    },
    {
      "verse": 34,
      "text": "示珊沒有兒子，只有女兒。示珊有一個僕人名叫耶哈，是埃及人。",
      "notes": []
    },
    {
      "verse": 35,
      "text": "示珊把女兒嫁給僕人耶哈，她為他生了亞太。",
      "notes": []
    },
    {
      "verse": 36,
      "text": "亞太生拿單；拿單生撒拔；",
      "notes": []
    },
    {
      "verse": 37,
      "text": "撒拔生以弗拉；以弗拉生俄備得；",
      "notes": []
    },
    {
      "verse": 38,
      "text": "俄備得生耶戶；耶戶生亞撒利雅；",
      "notes": []
    },
    {
      "verse": 39,
      "text": "亞撒利雅生希利斯；希利斯生以利亞薩；",
      "notes": []
    },
    {
      "verse": 40,
      "text": "以利亞薩生西斯買；西斯買生沙龍；",
      "notes": []
    },
    {
      "verse": 41,
      "text": "沙龍生耶加米雅；耶加米雅生以利沙瑪。",
      "notes": []
    },
    {
      "verse": 42,
      "section_headings": [
        "迦勒的其餘後裔"
      ],
      "text": "耶拉篾的兄弟迦勒的眾兒子：長子是米沙，米沙是西弗的父親，還有希伯倫的父親瑪利沙的眾兒子。",
      "notes": []
    },
    {
      "verse": 43,
      "text": "希伯倫的兒子是可拉、他普亞、利肯和示瑪。",
      "notes": []
    },
    {
      "verse": 44,
      "text": "示瑪生拉含，是約干之祖。利肯生沙買。",
      "notes": [
        "「約干」：原文另譯「約甸」；參書15．56。"
      ]
    },
    {
      "verse": 45,
      "text": "沙買的兒子是瑪雲；瑪雲是伯‧夙的父親。",
      "notes": []
    },
    {
      "verse": 46,
      "text": "迦勒的妾以法生哈蘭、摩撒和迦謝；哈蘭生迦卸。",
      "notes": []
    },
    {
      "verse": 47,
      "text": "雅代的兒子是利健、約坦、基珊、毗力、以法和沙亞弗。",
      "notes": []
    },
    {
      "verse": 48,
      "text": "迦勒的妾瑪迦生示別和特哈拿，",
      "notes": []
    },
    {
      "verse": 49,
      "text": "又生麥瑪拿的父親沙亞弗，又生抹比拿和基比亞的父親示法。迦勒的女兒是押撒。",
      "notes": []
    },
    {
      "verse": 50,
      "text": "這些都是迦勒的子孫。以法她的長子戶珥的子孫：基列‧耶琳之祖朔巴，",
      "notes": []
    },
    {
      "verse": 51,
      "text": "伯利恆之祖薩瑪，伯‧迦得之祖哈勒。",
      "notes": []
    },
    {
      "verse": 52,
      "text": "基列‧耶琳之祖朔巴的子孫是哈羅以和一半的米努哈人。",
      "notes": [
        "「米努哈人」就是「瑪拿哈人」；參54節。"
      ]
    },
    {
      "verse": 53,
      "text": "基列‧耶琳的宗族有以帖人、布特人、舒瑪人、密來人，又從這些宗族生出瑣拉人和以實陶人。",
      "notes": []
    },
    {
      "verse": 54,
      "text": "薩瑪的子孫有伯利恆人、尼陀法人、亞他綠‧伯‧約押人、一半的瑪拿哈人、瑣利人。",
      "notes": []
    },
    {
      "verse": 55,
      "text": "住雅比斯的文士的宗族有特拉人、示米押人和蘇甲人。這些都是利甲家之祖哈末所生的基尼人。",
      "notes": []
    }
  ]
}
