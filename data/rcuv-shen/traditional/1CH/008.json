{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "1CH",
  "book_name": "歷代志上",
  "chapter": 8,
  "heading": "便雅憫的後裔",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/1CH/8/",
  "verses": [
    {
      "verse": 1,
      "text": "便雅憫生長子比拉，次子亞實別，三子亞哈拉，",
      "notes": []
    },
    {
      "verse": 2,
      "text": "四子挪哈，五子拉法。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "比拉的兒子是亞大、基拉、亞比忽、",
      "notes": []
    },
    {
      "verse": 4,
      "text": "亞比書、乃幔、亞何亞、",
      "notes": []
    },
    {
      "verse": 5,
      "text": "基拉、示孚汛和戶蘭。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "以忽的後裔如下，他們是迦巴居民的族長，曾被擄到瑪拿轄：",
      "notes": []
    },
    {
      "verse": 7,
      "text": "乃幔、亞希亞、基拉；他擄了他們，又生了烏撒和亞希忽。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "沙哈連休了兩個妻子戶伸和巴拉之後，在摩押地生了兒子。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他與妻子賀得生了約巴、洗比雅、米沙、瑪拉干、",
      "notes": []
    },
    {
      "verse": 10,
      "text": "耶烏斯、沙迦和米瑪；這些是他的兒子，都是族長。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "戶伸為他生了亞比突和以利巴力。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "以利巴力的兒子是希伯、米珊和沙麥；沙麥建立阿挪、羅德和所屬的鄉鎮。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "比利亞和示瑪是亞雅崙居民的族長，他們驅逐了迦特的居民。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "亞希約、沙煞、耶利末、",
      "notes": [
        "「亞希約、沙煞」：七十士譯本是「他們的弟兄是沙煞」。"
      ]
    },
    {
      "verse": 15,
      "text": "西巴第雅、亞拉得、亞得、",
      "notes": []
    },
    {
      "verse": 16,
      "text": "米迦勒、伊施巴和約哈都是比利亞的兒子。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "西巴第雅、米書蘭、希西基、希伯、",
      "notes": []
    },
    {
      "verse": 18,
      "text": "伊施米萊、伊斯利亞和約巴都是以利巴力的兒子。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "雅金、細基利、撒底、",
      "notes": []
    },
    {
      "verse": 20,
      "text": "以利乃、洗勒太、以利業、",
      "notes": []
    },
    {
      "verse": 21,
      "text": "亞大雅、比拉雅和申拉都是示每的兒子。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "伊施班、希伯、以利業、",
      "notes": []
    },
    {
      "verse": 23,
      "text": "亞伯頓、細基利、哈難、",
      "notes": []
    },
    {
      "verse": 24,
      "text": "哈拿尼雅、以攔、安陀提雅、",
      "notes": []
    },
    {
      "verse": 25,
      "text": "伊弗底雅、毗努伊勒都是沙煞的兒子。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "珊示萊、示哈利、亞他利雅、",
      "notes": []
    },
    {
      "verse": 27,
      "text": "雅利西、以利亞和細基利都是耶羅罕的兒子。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "這些人按照他們的家譜都是族長，是領袖，都住在耶路撒冷。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "在基遍住的有基遍的父親耶利，他的妻子名叫瑪迦；",
      "notes": []
    },
    {
      "verse": 30,
      "text": "他的長子是亞伯頓，還有蘇珥、基士、巴力、拿答、",
      "notes": [
        "「巴力」：七十士譯本的一些抄本是「巴力、尼珥」；參代上9．36。"
      ]
    },
    {
      "verse": 31,
      "text": "基多、亞希約和撒迦。",
      "notes": [
        "七十士譯本在此加「米基羅」；參代上9．37。"
      ]
    },
    {
      "verse": 32,
      "text": "米基羅生示米暗。這些人在他們弟兄的對面，和他們的弟兄同住在耶路撒冷。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "尼珥生基士；基士生掃羅；掃羅生約拿單、麥基‧舒亞、亞比拿達和伊施巴力。",
      "notes": [
        "「伊施巴力」又名「伊施‧波設」，見撒下2．8；又名「亦施韋」，見撒上14．49；代上9．39同。"
      ]
    },
    {
      "verse": 34,
      "text": "約拿單的兒子是米力‧巴力；米力‧巴力生米迦。",
      "notes": [
        "「米力‧巴力」：撒下4．4稱「米非波設」；代上9．40同。"
      ]
    },
    {
      "verse": 35,
      "text": "米迦的兒子是毗敦、米勒、他利亞和亞哈斯；",
      "notes": []
    },
    {
      "verse": 36,
      "text": "亞哈斯生耶何阿達；耶何阿達生亞拉篾、亞斯瑪威和心利；心利生摩撒；",
      "notes": []
    },
    {
      "verse": 37,
      "text": "摩撒生比尼亞；比尼亞的兒子是拉法，拉法的兒子是以利亞薩，以利亞薩的兒子是亞悉。",
      "notes": []
    },
    {
      "verse": 38,
      "text": "亞悉有六個兒子，他們的名字是亞斯利干、波基路、以實瑪利、示亞利雅、俄巴底雅和哈難；這些全都是亞悉的兒子。",
      "notes": [
        "「亞斯利干、波基路」：七十士譯本是「他的長子亞斯利干」。"
      ]
    },
    {
      "verse": 39,
      "text": "亞悉兄弟以設的兒子：長子是烏蘭，次子是耶烏施，三子是以利法列。",
      "notes": []
    },
    {
      "verse": 40,
      "text": "烏蘭的兒子都是大能的勇士，是弓箭手，他們有許多的子孫，共一百五十名，都是便雅憫人。",
      "notes": []
    }
  ]
}
