{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "1CH",
  "book_name": "歷代志上",
  "chapter": 1,
  "heading": "從亞當到亞伯拉罕",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/1CH/1/",
  "verses": [
    {
      "verse": 1,
      "text": "亞當，塞特，以挪士，",
      "notes": []
    },
    {
      "verse": 2,
      "text": "該南，瑪勒列，雅列，",
      "notes": []
    },
    {
      "verse": 3,
      "text": "以諾，瑪土撒拉，拉麥，",
      "notes": []
    },
    {
      "verse": 4,
      "text": "挪亞，閃，含，雅弗。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "雅弗的兒子是歌篾、瑪各、瑪代、雅完、土巴、米設和提拉。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "歌篾的兒子是亞實基拿、低法和陀迦瑪。",
      "notes": [
        "「低法」：有古卷是「利法」；參創 10．3。"
      ]
    },
    {
      "verse": 7,
      "text": "雅完的兒子是以利沙、他施、基提和羅單人。",
      "notes": [
        "「羅單人」：參創10．4。"
      ]
    },
    {
      "verse": 8,
      "text": "含的兒子是古實、麥西、弗和迦南。",
      "notes": [
        "「麥西」即「埃及」；下同。"
      ]
    },
    {
      "verse": 9,
      "text": "古實的兒子是西巴、哈腓拉、撒弗他、拉瑪和撒弗提迦。拉瑪的兒子是示巴和底但。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "古實又生寧錄，他是地上第一個勇士。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "麥西生路低人、亞拿米人、利哈比人、拿弗土希人、",
      "notes": []
    },
    {
      "verse": 12,
      "text": "帕斯魯細人、迦斯路希人和迦斐託人；非利士人是從迦斐託人出來的。",
      "notes": [
        "「迦斐託人」：原文是「迦斯路希人」。"
      ]
    },
    {
      "verse": 13,
      "text": "迦南生了長子西頓，又生赫",
      "notes": []
    },
    {
      "verse": 14,
      "text": "和耶布斯人、亞摩利人、革迦撒人、",
      "notes": []
    },
    {
      "verse": 15,
      "text": "希未人、亞基人、西尼人、",
      "notes": []
    },
    {
      "verse": 16,
      "text": "亞瓦底人、洗瑪利人和哈馬人。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "閃的兒子是以攔、亞述、亞法撒、路德、亞蘭、烏斯、戶勒、基帖和米設。",
      "notes": [
        "「米設」：創10．23是「瑪施」。"
      ]
    },
    {
      "verse": 18,
      "text": "亞法撒生沙拉；沙拉生希伯。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "希伯生了兩個兒子：一個名叫法勒，因為那時人分地居住；法勒的兄弟名叫約坍。",
      "notes": [
        "「法勒」意思是「分」。"
      ]
    },
    {
      "verse": 20,
      "text": "約坍生亞摩答、沙列、哈薩瑪非、耶拉、",
      "notes": []
    },
    {
      "verse": 21,
      "text": "哈多蘭、烏薩、德拉、",
      "notes": []
    },
    {
      "verse": 22,
      "text": "以巴錄、亞比瑪利、示巴、",
      "notes": [
        "「以巴錄」：創10．28稱「俄巴路」。"
      ]
    },
    {
      "verse": 23,
      "text": "阿斐、哈腓拉和約巴。這些都是約坍的兒子。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "閃，亞法撒，沙拉，",
      "notes": []
    },
    {
      "verse": 25,
      "text": "希伯，法勒，拉吳，",
      "notes": []
    },
    {
      "verse": 26,
      "text": "西鹿，拿鶴，他拉，",
      "notes": []
    },
    {
      "verse": 27,
      "text": "亞伯蘭，亞伯蘭就是亞伯拉罕。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "亞伯拉罕的兒子是以撒和以實瑪利。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "以實瑪利的後代如下：以實瑪利的長子是尼拜約，又有基達、亞德別、米比衫、",
      "notes": []
    },
    {
      "verse": 30,
      "text": "米施瑪、度瑪、瑪撒、哈大、提瑪、",
      "notes": []
    },
    {
      "verse": 31,
      "text": "伊突、拿非施和基底瑪。這些都是以實瑪利的兒子。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "亞伯拉罕的妾基土拉所生的兒子，就是心蘭、約珊、米但、米甸、伊施巴和書亞。約珊的兒子是示巴和底但。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "米甸的兒子是以法、以弗、哈諾、亞比大和以勒大。這些都是基土拉的子孫。",
      "notes": []
    },
    {
      "verse": 34,
      "text": "亞伯拉罕生以撒；以撒的兒子是以掃和以色列。",
      "notes": []
    },
    {
      "verse": 35,
      "text": "以掃的兒子是以利法、流珥、耶烏施、雅蘭和可拉。",
      "notes": []
    },
    {
      "verse": 36,
      "text": "以利法的兒子是提幔、阿抹、洗玻、迦坦、基納斯、亭納和亞瑪力。",
      "notes": []
    },
    {
      "verse": 37,
      "text": "流珥的兒子是拿哈、謝拉、沙瑪和米撒。",
      "notes": []
    },
    {
      "verse": 38,
      "text": "西珥的兒子是羅坍、朔巴、祭便、亞拿、底順、以察和底珊。",
      "notes": []
    },
    {
      "verse": 39,
      "text": "羅坍的兒子是何利和荷幔；羅坍的妹妹是亭納。",
      "notes": [
        "「荷幔」：創36．22稱「希幔」。"
      ]
    },
    {
      "verse": 40,
      "text": "朔巴的兒子是亞勒文、瑪拿轄、以巴錄、示非和阿南。祭便的兒子是愛亞和亞拿。",
      "notes": [
        "「示非」：創36．23稱「示玻」。"
      ]
    },
    {
      "verse": 41,
      "text": "亞拿的兒子是底順。底順的兒子是哈默蘭、伊是班、益蘭和基蘭。",
      "notes": [
        "「哈默蘭」：創36．26稱「欣但」。"
      ]
    },
    {
      "verse": 42,
      "text": "以察的兒子是辟罕、撒番和亞干。底珊的兒子是烏斯和亞蘭。",
      "notes": [
        "「亞干」是根據一些古卷和七十士譯本；原文是「約亞干」；參創36．27。",
        "「底珊」：原文是「底順」。"
      ]
    },
    {
      "verse": 43,
      "text": "以色列人未有君王治理之前，這些是在以東地作王的。有比珥的兒子比拉，他的城名叫亭哈巴。",
      "notes": []
    },
    {
      "verse": 44,
      "text": "比拉死了，波斯拉人謝拉的兒子約巴接續他作王。",
      "notes": []
    },
    {
      "verse": 45,
      "text": "約巴死了，提幔人之地的戶珊接續他作王。",
      "notes": []
    },
    {
      "verse": 46,
      "text": "戶珊死了，比達的兒子哈達接續他作王，哈達曾在摩押地擊敗米甸人，他的城名叫亞未得。",
      "notes": []
    },
    {
      "verse": 47,
      "text": "哈達死了，瑪士利加人桑拉接續他作王。",
      "notes": []
    },
    {
      "verse": 48,
      "text": "桑拉死了，大河邊的利河伯人掃羅接續他作王。",
      "notes": []
    },
    {
      "verse": 49,
      "text": "掃羅死了，亞革波的兒子巴勒‧哈南接續他作王。",
      "notes": []
    },
    {
      "verse": 50,
      "text": "巴勒‧哈南死了，哈達接續他作王，他的城名叫巴伊。他的妻子名叫米希她別，是米‧薩合的孫女，瑪特列的女兒。",
      "notes": [
        "「巴伊」：創36．39稱「巴烏」。"
      ]
    },
    {
      "verse": 51,
      "text": "哈達死了。以東的族長有：亭納族長、亞勒瓦族長、耶帖族長、",
      "notes": []
    },
    {
      "verse": 52,
      "text": "阿何利巴瑪族長、以拉族長、比嫩族長、",
      "notes": []
    },
    {
      "verse": 53,
      "text": "基納斯族長、提幔族長、米比薩族長、",
      "notes": []
    },
    {
      "verse": 54,
      "text": "瑪基疊族長、以蘭族長。這些都是以東的族長。",
      "notes": []
    }
  ]
}
