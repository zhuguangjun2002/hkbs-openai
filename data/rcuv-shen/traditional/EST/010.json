{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "EST",
  "book_name": "以斯帖記",
  "chapter": 10,
  "heading": "亞哈隨魯和末底改的功績",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/EST/10/",
  "verses": [
    {
      "verse": 1,
      "text": "亞哈隨魯王向國中和海島的人徵稅。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "他以權柄能力所做的一切，以及他使末底改尊大、提升他的事，豈不都寫在瑪代和波斯王的史籍上嗎？",
      "notes": []
    },
    {
      "verse": 3,
      "text": "猶太人末底改作亞哈隨魯王的宰相，在猶太人中為大，得許多弟兄的喜悅，為本族的人爭取福利，為他所有的後代謀求幸福。",
      "notes": []
    }
  ]
}
