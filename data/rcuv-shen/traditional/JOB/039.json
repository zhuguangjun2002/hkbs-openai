{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "JOB",
  "book_name": "約伯記",
  "chapter": 39,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/JOB/39/",
  "verses": [
    {
      "verse": 1,
      "text": "「你知道巖石間的野山羊幾時生產嗎？你能觀察母鹿下小鹿嗎？",
      "notes": []
    },
    {
      "verse": 2,
      "text": "你能數算牠們懷胎的月數嗎？你知道牠們幾時生產嗎？",
      "notes": []
    },
    {
      "verse": 3,
      "text": "牠們屈身，生下幼兒，就解除了陣痛。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "其子漸漸肥壯，在荒野長大；牠們出去，不再歸回。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "「誰放野驢自由？誰解開快驢的繩索？",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我使曠野作牠的住處，使鹽地當牠的居所。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "牠嘲笑城內的喧嚷，不聽趕牲口的喝聲。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "諸山是牠漫遊的草場，牠尋找各樣青綠之物。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "「野牛豈肯服事你？豈肯在你的槽旁過夜？",
      "notes": []
    },
    {
      "verse": 10,
      "text": "你豈能用套繩將野牛繫於犁溝？牠豈肯隨你耙鬆山谷之地？",
      "notes": []
    },
    {
      "verse": 11,
      "text": "你豈可因牠力大就倚靠牠？豈可把你的工交給牠做呢？",
      "notes": []
    },
    {
      "verse": 12,
      "text": "你豈能靠牠把你的穀物運回，又收聚在你的禾場上嗎？",
      "notes": [
        "本節原文另譯「你豈能信賴牠會回來，又收聚你禾場上的穀物呢？」"
      ]
    },
    {
      "verse": 13,
      "text": "「鴕鳥的翅膀歡然拍動，但豈是鸛的翎毛和羽毛嗎？",
      "notes": [
        "「但豈是...羽毛嗎」或譯「牠的翎毛和羽毛豈是顯示慈愛嗎」；「慈愛」與「鸛」的希伯來話發音相近。"
      ]
    },
    {
      "verse": 14,
      "text": "因牠把蛋留在地上，使蛋在塵土中得溫暖，",
      "notes": []
    },
    {
      "verse": 15,
      "text": "卻忘記腳會把蛋踹碎，野獸會踐踏它。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "牠粗暴待雛，似乎不是自己生的；雖徒然勞苦，也不懼怕。",
      "notes": [
        "「勞苦」指「孵蛋」。"
      ]
    },
    {
      "verse": 17,
      "text": "因為神使牠忘記智慧，也未將悟性分給牠。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "牠幾時挺身展開翅膀，就嘲笑馬和騎馬的人。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "「馬的力量是你所賜的嗎？牠頸項上的鬃是你披上的嗎？",
      "notes": []
    },
    {
      "verse": 20,
      "text": "是你叫牠跳躍像蝗蟲嗎？牠噴氣之威嚴使人驚惶。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "牠用蹄在谷中挖地，以能力歡躍；牠出去迎擊仇敵。",
      "notes": [
        "「牠用蹄...挖地」：原文直譯「牠們在谷中挖地」。",
        "「仇敵」：原文是「兵器」。"
      ]
    },
    {
      "verse": 22,
      "text": "牠嘲笑懼怕，並不驚惶，也不因刀劍退卻。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "箭袋在牠身上錚錚有聲，槍和短槍閃閃發亮。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "牠震顫激動，將地吞下 ；一聽角聲就站不住。",
      "notes": [
        "「將地吞下」意思是「全速奔跑」。"
      ]
    },
    {
      "verse": 25,
      "text": "每逢角聲一響，牠說：『啊哈！』牠從遠處聞到戰爭的氣息，聽見軍官如雷的吼聲和吶喊。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "「鷹展開翅膀向南飛翔，豈是藉著你的智慧嗎？",
      "notes": []
    },
    {
      "verse": 27,
      "text": "大鷹上騰在高處搭窩，豈是聽你的指示嗎？",
      "notes": []
    },
    {
      "verse": 28,
      "text": "牠住在山巖，以山峰和堅固之所為家，",
      "notes": []
    },
    {
      "verse": 29,
      "text": "從那裏窺察食物，眼睛自遠方瞭望。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "牠的雛吸血；被殺的人在哪裏，牠也在哪裏。」",
      "notes": []
    }
  ]
}
