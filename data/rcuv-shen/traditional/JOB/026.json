{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "JOB",
  "book_name": "約伯記",
  "chapter": 26,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/JOB/26/",
  "verses": [
    {
      "verse": 1,
      "text": "約伯回答說：",
      "notes": []
    },
    {
      "verse": 2,
      "text": "「無能的人蒙你何等的幫助！膀臂無力的人蒙你何等的拯救！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "無智慧的人蒙你何等的指教！你向他顯出豐富的知識。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "你向誰發出言語？誰的靈從你而出？",
      "notes": []
    },
    {
      "verse": 5,
      "text": "在大水和水族以下，陰魂戰兢。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "在神面前，陰間顯露；冥府也不得遮掩。",
      "notes": [
        "「冥府」：原文音譯「亞巴頓」，意思是「滅亡之地」。"
      ]
    },
    {
      "verse": 7,
      "text": "神將北極鋪在空中，將大地懸在虛空。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他將水包在密雲中，盛水的雲卻不破裂。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他遮蔽寶座的正面，把他的雲彩鋪在其上。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "他在水面上劃一圓圈，直到光明與黑暗的交界。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "天的柱子震動，因他的斥責驚奇。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "他以能力攪動大海，藉知識打傷拉哈伯。",
      "notes": [
        "「攪動」或譯「平靜」。"
      ]
    },
    {
      "verse": 13,
      "text": "他藉自己的靈使天空晴朗；他的手刺殺爬得快的蛇。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "看哪，這不過是神工作的些微；我們聽見他的話，是何等細微的聲音！他大能的雷聲誰能明白呢？」",
      "notes": []
    }
  ]
}
