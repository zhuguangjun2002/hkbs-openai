{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "JOB",
  "book_name": "約伯記",
  "chapter": 28,
  "heading": "歌頌智慧",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/JOB/28/",
  "verses": [
    {
      "verse": 1,
      "text": "「銀子有礦；煉金有場。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "鐵從土裏開採，銅從礦石鎔出。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "人探索黑暗的盡頭，查究礦石直到極處，那是幽暗和死蔭；",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他在無人居住之處開鑿礦穴，在無足跡之地被遺忘，與人遠離，懸空搖擺。",
      "notes": [
        "「在無足跡之地被遺忘」或譯「過路的人也想不到他們」。"
      ]
    },
    {
      "verse": 5,
      "text": "地出產糧食，地底翻騰如火。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "地的石頭是藍寶石之處，那裏還有金沙。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "鷙鳥不知那條路，鷹眼也未曾見過。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "狂傲的野獸未曾踩踏，猛烈的獅子也未曾經過。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "「人動手鑿開堅石，翻倒山的根基，",
      "notes": []
    },
    {
      "verse": 10,
      "text": "在磐石中鑿出水道，親眼看見各樣寶物。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "他封閉河川不得涓滴，使隱藏之物顯露出來。",
      "notes": [
        "「他封閉河川不得涓滴」：原文另譯「他封閉河川的水源」。"
      ]
    },
    {
      "verse": 12,
      "text": "「然而，智慧何處可尋？聰明之地在哪裏？",
      "notes": []
    },
    {
      "verse": 13,
      "text": "智慧的價值無人能知，活人之地也無處可尋。",
      "notes": [
        "「智慧的價值」：七十士譯本是「智慧的道路」。"
      ]
    },
    {
      "verse": 14,
      "text": "深淵說：『不在我裏面。』滄海說：『不在我這裏。』",
      "notes": []
    },
    {
      "verse": 15,
      "text": "智慧不可用黃金換取，也不能用白銀秤她的價值。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "俄斐的金子和貴重的紅瑪瑙，以及藍寶石，不足與她比擬；",
      "notes": []
    },
    {
      "verse": 17,
      "text": "黃金和玻璃不足與她比較；純金的器皿不足兌換她。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "珊瑚、水晶都不值得提；智慧的價值勝過寶石。",
      "notes": [
        "「寶石」或譯「珍珠」。"
      ]
    },
    {
      "verse": 19,
      "text": "古實的紅璧璽不足與她比較；純金也不足與她比擬。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "「智慧從何處來呢？聰明之地在哪裏？",
      "notes": []
    },
    {
      "verse": 21,
      "text": "她隱藏，遠離眾生的眼目，她掩蔽，遠離空中的飛鳥。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "毀滅和死亡說：『我們風聞其名。』",
      "notes": []
    },
    {
      "verse": 23,
      "text": "「神明白智慧的道路，知道智慧的所在。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "因為他鑒察直到地極，遍觀普天之下，",
      "notes": []
    },
    {
      "verse": 25,
      "text": "要為風定輕重，又度量諸水，",
      "notes": []
    },
    {
      "verse": 26,
      "text": "為雨定律例，為雷電定道路。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "那時他看見智慧，就談論她，堅定她，並且查究她。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "他對人說：『看哪，敬畏主就是智慧；遠離惡事就是聰明。』」",
      "notes": []
    }
  ]
}
