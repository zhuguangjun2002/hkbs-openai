{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 111,
  "heading": "讚美耶和華",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/111/",
  "verses": [
    {
      "verse": 1,
      "text": "哈利路亞！我要在正直人的大會和會眾中一心稱謝耶和華。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "耶和華的作為本為大，被所有喜愛的人所探尋。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他所做的是尊榮和威嚴，他的公義存到永遠。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他行了奇事，使人記念；耶和華有恩惠，有憐憫。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "他賜糧食給敬畏他的人，他必永遠記念他的約。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他向百姓顯出大能的作為，將列國賜給他們為業。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他手所做的信實公平，他的訓詞全然可靠，",
      "notes": []
    },
    {
      "verse": 8,
      "text": "是永永遠遠堅定的，是按信實正直設立的。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他向百姓施行救贖，頒佈他的約，直到永遠；他的名聖而可畏。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "敬畏耶和華是智慧的開端，凡遵行他命令的有美好的見識。耶和華是永遠當讚美的！",
      "notes": []
    }
  ]
}
