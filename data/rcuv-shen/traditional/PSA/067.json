{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 67,
  "heading": "感恩的詩",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/67/",
  "verses": [
    {
      "verse": 1,
      "text": "願神憐憫我們，賜福給我們，使他的臉向我們發光，（細拉）",
      "notes": []
    },
    {
      "verse": 2,
      "text": "好讓全地得知你的道路，萬國得知你的救恩。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "神啊，願萬民稱謝你！願萬民都稱謝你！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "願萬族都快樂歡呼；因為你必按公正審判萬民，引導地上的萬族。（細拉）",
      "notes": []
    },
    {
      "verse": 5,
      "text": "神啊，願萬民稱謝你！願萬民都稱謝你！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "地已經出了土產，神，我們的神，要賜福給我們。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "神要賜福給我們，地的四極都要敬畏他！",
      "notes": []
    }
  ]
}
