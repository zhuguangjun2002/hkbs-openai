{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 150,
  "heading": "讚美耶和華",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/150/",
  "verses": [
    {
      "verse": 1,
      "text": "哈利路亞！你們要在神的聖所讚美他！在他顯能力的穹蒼讚美他！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "要因他大能的作為讚美他，因他極其偉大讚美他！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "要用角聲讚美他，鼓瑟彈琴讚美他！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "擊鼓跳舞讚美他！用絲弦的樂器和簫的聲音讚美他！",
      "notes": []
    },
    {
      "verse": 5,
      "text": "用大響的鈸讚美他！用高聲的鈸讚美他！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "凡有生命的都要讚美耶和華！哈利路亞！",
      "notes": []
    }
  ]
}
