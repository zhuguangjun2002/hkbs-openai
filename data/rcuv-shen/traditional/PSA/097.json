{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 97,
  "heading": "神是最高的統治者",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/97/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和華作王！願地快樂！願眾海島歡喜！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "密雲和幽暗在他四圍，公義和公平是他寶座的根基。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "烈火在他前頭行，燒滅他四圍的敵人。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他的閃電光照世界，大地看見就震動。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "諸山見耶和華的面，就是全地之主的面，就如蠟熔化。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "諸天表明他的公義，萬民看見他的榮耀。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "願所有事奉雕刻偶像、靠虛無神明自誇的，都蒙羞愧。萬神哪，你們都當拜他。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和華啊，因你的判斷，錫安聽見就歡喜；猶大的城鎮也都快樂。",
      "notes": [
        "「猶大的城鎮」：原文直譯「猶大眾女子」。"
      ]
    },
    {
      "verse": 9,
      "text": "因為你－耶和華至高，超乎全地；受尊崇，遠超萬神之上。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "你們愛耶和華的，都當恨惡罪惡；他保護聖民的性命，搭救他們脫離惡人的手。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "散播亮光是為義人，喜樂歸於心裏正直的人。",
      "notes": [
        "「散播亮光是為義人」：有古卷、七十士譯本和其他古譯本是「有亮光照耀著義人」。"
      ]
    },
    {
      "verse": 12,
      "text": "義人哪，你們當靠耶和華歡喜，當頌揚他神聖的名字。",
      "notes": [
        "「名字」：原文是「紀念」。"
      ]
    }
  ]
}
