{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 112,
  "heading": "義人之福",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/112/",
  "verses": [
    {
      "verse": 1,
      "text": "哈利路亞！敬畏耶和華，甚喜愛他命令的，這人有福了！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "他的後裔在世必強盛，正直人的後代必蒙福。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他的家中有金銀財寶，他的義行存到永遠。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "正直人在黑暗中有光向他照耀，他有恩惠，有憐憫，有公義。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "施恩與人、借貸與人、秉公處事的人必享美福，",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他永不動搖。義人被記念，直到永遠。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他不懼怕兇惡的信息，他的心堅定，倚靠耶和華。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他的心確定，總不懼怕，直到他看見敵人遭報。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他施捨，賙濟貧窮，他的義行存到永遠，他的角必被高舉，大有榮耀。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "惡人看見就憤怒，必咬牙而消亡，惡人的心願要歸於幻滅。",
      "notes": []
    }
  ]
}
