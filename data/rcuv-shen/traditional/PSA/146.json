{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 146,
  "heading": "讚美耶和華的救助",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/146/",
  "verses": [
    {
      "verse": 1,
      "text": "哈利路亞！我的心哪，你要讚美耶和華！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "我一生要讚美耶和華！我還活著的時候要歌頌我的神！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "你們不要倚靠君王，不要倚靠世人，他一點也不能幫助。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他的氣一斷，就歸回塵土，他所打算的，當日就消滅了。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "以雅各的神為幫助、仰望耶和華－他神的，這人有福了！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "耶和華造天、地、海和其中的萬物，他守信實，直到永遠。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他為受欺壓的伸冤，賜食物給飢餓的人。耶和華釋放被囚的，",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和華開了盲人的眼睛，耶和華扶起被壓下的人，耶和華喜愛義人。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "耶和華保護寄居的，扶持孤兒和寡婦，卻使惡人的道路彎曲。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "耶和華要作王，直到永遠！錫安哪，你的神要作王，直到萬代！哈利路亞！",
      "notes": []
    }
  ]
}
