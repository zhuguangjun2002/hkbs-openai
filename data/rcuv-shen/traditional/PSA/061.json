{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 61,
  "heading": "求主保佑",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/61/",
  "verses": [
    {
      "verse": 1,
      "text": "神啊，求你聽我的呼求，留心聽我的禱告！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "我心裏發昏的時候，要從地極求告你。求你領我到那比我更高的磐石，",
      "notes": []
    },
    {
      "verse": 3,
      "text": "因為你是我的避難所，是我的堅固臺，使我脫離仇敵。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "我要永遠住在你的帳幕裏！我要投靠在你翅膀下的隱密處！（細拉）",
      "notes": []
    },
    {
      "verse": 5,
      "text": "神啊，你聽了我所許的願；你將產業賜給敬畏你名的人。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "求你加添王的壽數，使他的年歲存到世世代代。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "願他在神面前永遠坐在王位上，求你預備慈愛和信實保佑他！",
      "notes": []
    },
    {
      "verse": 8,
      "text": "這樣，我要歌頌你的名，直到永遠，天天還我所許的願。",
      "notes": []
    }
  ]
}
