{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 142,
  "heading": "求主眷顧",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/142/",
  "verses": [
    {
      "verse": 1,
      "text": "我出聲哀告耶和華，出聲懇求耶和華。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "我在他面前傾訴我的苦情，在他面前陳說我的患難。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "我的靈在我裏面發昏的時候，你知道我的道路。在我所行的路上，人為我暗設羅網。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "求你留意向我右邊觀看，無人認識我；我無避難之處，也無人眷顧我。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "耶和華啊，我曾向你哀求。我說：「你是我的避難所，在活人之地，你是我的福分。」",
      "notes": []
    },
    {
      "verse": 6,
      "text": "求你留心聽我的呼求，因我落到極卑微之地；求你救我脫離迫害我的人，因為他們比我強盛。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "求你從被囚之地領我出來，我好頌揚你的名。義人必環繞我，因為你用厚恩待我。",
      "notes": []
    }
  ]
}
