{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 125,
  "heading": "耶和華子民的安全",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/125/",
  "verses": [
    {
      "verse": 1,
      "text": "倚靠耶和華的人好像錫安山，安穩坐鎮，永不動搖。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "眾山怎樣圍繞耶路撒冷，耶和華也照樣圍繞他的百姓，從今時直到永遠。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "惡人的杖必不在義人的土地上停留，免得義人伸手作惡。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和華啊，求你善待行善和心裏正直的人。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "至於那偏行彎曲道路的人，耶和華必將他們和作惡的人一同驅逐出去。願平安歸於以色列！",
      "notes": []
    }
  ]
}
