{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 141,
  "heading": "晚 禱",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/141/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和華啊，我曾求告你，求你快快臨到我這裏！我求告你的時候，求你側耳聽我的聲音！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "願我的禱告如香呈到你面前！願我的手舉起，如獻晚祭！",
      "notes": [
        "「手舉起」：在此有「獻供物」的意思。"
      ]
    },
    {
      "verse": 3,
      "text": "耶和華啊，求你看守我的口，把守我的嘴唇！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "不要使我的心偏向邪惡的事，以致我和作惡的人一同行惡；也不叫我吃他們的美食。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "任憑義人擊打我，這算為仁慈；任憑他責備我，這算為頭上的膏油；我的頭不躲閃。人正行惡的時候，我仍要祈禱。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他們的審判官被扔在巖下，他們就要聽我的話，因為這話甘甜。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "我們的骨頭散落在陰間的口，就像人耕田刨地一樣。",
      "notes": [
        "「我們的」：有古譯本是「他們的」。",
        "「人耕田刨地」：原文另譯「磨石破裂」。"
      ]
    },
    {
      "verse": 8,
      "text": "主－耶和華啊，我的眼目仰望你；我投靠你，求你不要使我的性命陷入危險！",
      "notes": []
    },
    {
      "verse": 9,
      "text": "求你保護我脫離惡人為我設的羅網和作惡之人的圈套！",
      "notes": []
    },
    {
      "verse": 10,
      "text": "願惡人落在自己的網中，我卻得以逃脫。",
      "notes": []
    }
  ]
}
