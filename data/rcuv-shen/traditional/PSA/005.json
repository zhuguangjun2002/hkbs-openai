{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 5,
  "heading": "求主保護",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/5/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和華啊，求你側耳聽我的言語，顧念我的心思！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "我的王，我的神啊，求你留心聽我呼求的聲音！因為我向你祈禱。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "耶和華啊，早晨你必聽我的聲音；早晨我要向你陳明我的心思，並要警醒。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "因為你不是喜愛邪惡的神，惡人不能與你同住。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "狂傲的人不能站在你眼前；凡作惡的，都是你所恨惡的。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "說謊言的，你必滅絕；好流人血、玩弄詭詐的，都為耶和華所憎惡。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "至於我，我必憑你豐盛的慈愛進入你的居所，我要存敬畏你的心向你的聖殿下拜。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和華啊，求你因我仇敵的緣故，憑你的公義引領我，使你的道路在我面前正直。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "因為他們口中沒有誠實，心裏充滿邪惡，他們的喉嚨是敞開的墳墓；他們用舌頭諂媚人。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "神啊，求你定他們的罪！願他們因自己的計謀跌倒；求你因他們過犯眾多趕逐他們，因為他們背叛了你。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "凡投靠你的，願他們喜樂，時常歡呼，因為你庇護他們；又願那愛你名的人都靠你歡欣。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "耶和華啊，因為你必賜福給義人，你必用恩惠如同盾牌四面護衛他。",
      "notes": []
    }
  ]
}
