{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 6,
  "heading": "患難中求助的祈禱",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/6/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和華啊，求你不要在怒中責備我，不要在烈怒中懲罰我！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "耶和華啊，求你憐憫我，因為我軟弱。耶和華啊，求你醫治我，因為我的骨頭戰抖。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "我的心也大大驚惶。耶和華啊，你要等到幾時呢？",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和華啊，求你轉回搭救我，因你的慈愛拯救我。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "因為死了的人不會記念你，在陰間有誰稱謝你？",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我因呻吟而困乏；我每夜流淚，使床鋪漂起，把褥子濕透。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "我的眼睛因憂愁而昏花，因敵人的緣故，我的眼目模糊不清。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "你們所有作惡的人，離開我吧！因為耶和華聽了我哀哭的聲音。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "耶和華聽了我的懇求，耶和華必接納我的禱告。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "我所有的仇敵都必羞愧，大大驚惶；轉眼之間，他們要羞愧撤退。",
      "notes": []
    }
  ]
}
