{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 19,
  "heading": "造化的榮耀",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/19/",
  "verses": [
    {
      "verse": 1,
      "text": "諸天述說神的榮耀，穹蒼傳揚他手的作為。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "這日到那日發出言語，這夜到那夜傳出知識。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "無言無語，也無聲音可聽。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "它們的聲浪傳遍天下，它們的言語傳到地極。神在其中為太陽安設帳幕，",
      "notes": [
        "「聲浪」：原文是「繩索」。"
      ]
    },
    {
      "verse": 5,
      "text": "太陽如同新郎步出洞房，又如勇士歡然奔路。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "它從天這邊出來，繞到天那邊，沒有一物可隱藏得不到它的熱氣。",
      "notes": []
    },
    {
      "verse": 7,
      "section_headings": [
        "耶和華的律法"
      ],
      "text": "耶和華的律法全備，使人甦醒；耶和華的法度確定，使愚蒙人有智慧。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和華的訓詞正直，使人心快活；耶和華的命令清潔，使人眼目明亮。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "耶和華的典章真實，全然公義，敬畏耶和華是純潔的，存到永遠，",
      "notes": []
    },
    {
      "verse": 10,
      "text": "比金子可羨慕，比極多的純金可羨慕；比蜜甘甜，比蜂房下滴的蜜甘甜。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "因此你的僕人受警戒，遵守這些有極大的賞賜。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "誰能察覺自己的錯失呢？求你赦免我隱藏的過犯。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "求你攔阻僕人不犯任意妄為的罪，不容這罪轄制我，我就完全，免犯大罪。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "耶和華－我的磐石，我的救贖主啊，願我口中的言語，心裏的意念在你面前蒙悅納。",
      "notes": []
    }
  ]
}
