{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 11,
  "heading": "在主裏得安穩",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/11/",
  "verses": [
    {
      "verse": 1,
      "text": "我投靠耶和華；你們怎麼對我說：「你當像鳥逃到你們的山去；",
      "notes": []
    },
    {
      "verse": 2,
      "text": "看哪，惡人彎弓，把箭搭在弦上，要在暗中射那心裏正直的人。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "根基若毀壞，義人還能做甚麼呢？」",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和華在他的聖殿裏，耶和華在天上的寶座上；他的眼睛察看，他的眼目察驗世人。",
      "notes": [
        "「眼目」：原文是「眼皮」。"
      ]
    },
    {
      "verse": 5,
      "text": "耶和華考驗義人；惟有惡人和喜愛暴力的人，他心裏恨惡。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他要向惡人密佈羅網，烈火、硫磺、熱風作他們杯中的份。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "因為耶和華是公義的，他喜愛義行，正直人必得見他的面。",
      "notes": []
    }
  ]
}
