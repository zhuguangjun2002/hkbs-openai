{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 143,
  "heading": "求主拯救",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/143/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和華啊，求你聽我的禱告，側耳聽我的懇求，憑你的信實和公義應允我。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "求你不要審問僕人，因為在你面前，凡活著的人沒有一個是義的。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "因為仇敵迫害我，將我打倒在地，使我住在幽暗之處，像死了許久的人一樣。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "我的靈在我裏面發昏，我的心在我裏面顫慄。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "我追想古時之日，思想你的一切作為，默念你手的工作。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我向你舉手，我的心渴想你，如乾旱之地盼雨一樣。（細拉）",
      "notes": []
    },
    {
      "verse": 7,
      "text": "耶和華啊，求你速速應允我！我的心神耗盡！求你不要轉臉不顧我，免得我像那些下入地府的人一樣。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "求你使我清晨得聽你慈愛的聲音，因我倚靠你；求你使我知道當走的路，因我的心仰望你。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "耶和華啊，求你救我脫離我的仇敵！我往你那裏藏身。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "求你指教我遵行你的旨意，因你是我的神；願你至善的靈引我到平坦之地。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "耶和華啊，求你為你名的緣故將我救活，憑你的公義，將我從患難中領出來，",
      "notes": []
    },
    {
      "verse": 12,
      "text": "憑你的慈愛剪除我的仇敵，滅絕所有苦待我的人，因我是你的僕人。",
      "notes": []
    }
  ]
}
