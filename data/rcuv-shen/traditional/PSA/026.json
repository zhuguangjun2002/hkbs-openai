{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 26,
  "heading": "義人的祈禱",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/26/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和華啊，求你為我伸冤，因我向來行事純正；我倚靠耶和華，必不動搖。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "耶和華啊，求你察看我，考驗我，熬煉我的肺腑心腸。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "因為你的慈愛常在我眼前，我也按你的真理而行。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "我未曾與虛妄的人同坐，也不與偽善的人來往。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "我痛恨惡人的集會，必不與惡人同坐。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "耶和華啊，我要洗手表明無辜，才環繞你的祭壇；",
      "notes": []
    },
    {
      "verse": 7,
      "text": "我好發出稱謝的聲音，述說你一切奇妙的作為。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和華啊，我喜愛你所住的殿和你顯榮耀的居所。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "不要把我的性命和罪人一同除掉，不要把我的生命和好流人血的一同除掉。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "他們的手中有奸惡，他們的右手滿有賄賂。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "至於我，卻要行事純正；求你救贖我，憐憫我！",
      "notes": []
    },
    {
      "verse": 12,
      "text": "我的腳站在平坦的地方，在聚會中我要稱頌耶和華！",
      "notes": []
    }
  ]
}
