{
  "translation": "rcuv-shen",
  "version": "RCUV1",
  "version_name": "和合本2010 (和修) (神版)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 72,
  "heading": "為王祈禱",
  "source_url": "https://rcuv.hkbs.org.hk/RCUV1/PSA/72/",
  "verses": [
    {
      "verse": 1,
      "text": "神啊，求你將你的公平賜給王，將你的公義賜給王的兒子。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "使他按公義審判你的子民，按公平審判你的困苦人。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "大山小山都要因公義使百姓得享平安。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他必為百姓中困苦的人伸冤，拯救貧窮之輩，壓碎那欺壓人的人。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "太陽還存，月亮猶在，人要敬畏你，直到萬代！",
      "notes": [
        "「人要敬畏你」：七十士譯本是「願他永活」。"
      ]
    },
    {
      "verse": 6,
      "text": "他必降臨，像雨降在已割的草地上，如甘霖滋潤田地。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "在他的日子，公義要興旺，大有平安，除非月亮不在。",
      "notes": [
        "「公義」：有古卷是「義人」。"
      ]
    },
    {
      "verse": 8,
      "text": "他要執掌權柄，從這海直到那海，從大河直到地極。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "住在曠野的必在他面前下拜，他的仇敵必要舔土。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "他施和海島的王要進貢，示巴和西巴的王要獻禮物。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "眾王都要叩拜他，萬國都要事奉他。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "貧窮人呼求，他要搭救，無人幫助的困苦人，他也搭救。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "他要憐憫貧寒和貧窮的人，拯救貧窮人的性命。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "他要救贖他們脫離欺壓和殘暴，他們的血在他眼中看為寶貴。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "願他永遠活著，示巴的金子要獻給他；願人常常為他禱告，終日祝福他。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "在地的山頂上，願五穀茂盛，所結的穀實響動，如黎巴嫩的樹林；願城裏的人興旺，如地上的草。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "願他的名存到永遠，他的名如太陽之長久；願人因他蒙福，萬國稱他為有福。",
      "notes": [
        "「長久」：原文另譯「堅定」或「延續」。"
      ]
    },
    {
      "verse": 18,
      "text": "惟獨耶和華－以色列的神能行奇事，他是應當稱頌的！",
      "notes": []
    },
    {
      "verse": 19,
      "text": "他榮耀的名也當稱頌，直到永遠。願他的榮耀充滿全地！阿們！阿們！",
      "notes": []
    },
    {
      "verse": 20,
      "text": "耶西的兒子－大衛的祈禱完畢。",
      "notes": []
    }
  ]
}
