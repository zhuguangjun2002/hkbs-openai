{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "1CH",
  "book_name": "历代志上",
  "chapter": 1,
  "heading": "从亚当到亚伯拉罕",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/1CH/1/",
  "verses": [
    {
      "verse": 1,
      "text": "亚当生塞特；塞特生以挪士；",
      "notes": []
    },
    {
      "verse": 2,
      "text": "以挪士生该南；该南生玛勒列；玛勒列生雅列；",
      "notes": []
    },
    {
      "verse": 3,
      "text": "雅列生以诺；以诺生玛土撒拉；玛土撒拉生拉麦；",
      "notes": []
    },
    {
      "verse": 4,
      "text": "拉麦生挪亚；挪亚生闪、含、雅弗。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "雅弗的儿子是歌篾、玛各、玛代、雅完、土巴、米设、提拉。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "歌篾的儿子是亚实基拿、低法、陀迦玛。",
      "notes": [
        "在创世记十章三节是利法"
      ]
    },
    {
      "verse": 7,
      "text": "雅完的儿子是以利沙、他施、基提、多单。",
      "notes": [
        "有作罗单的"
      ]
    },
    {
      "verse": 8,
      "text": "含的儿子是古实、麦西、弗、迦南。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "古实的儿子是西巴、哈腓拉、撒弗他、拉玛、撒弗提迦。拉玛的儿子是示巴、底但。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "古实生宁录；他为世上英雄之首。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "麦西生路低人、亚拿米人、利哈比人、拿弗土希人、",
      "notes": []
    },
    {
      "verse": 12,
      "text": "帕斯鲁细人、迦斯路希人、迦斐托人；从迦斐托出来的有非利士人。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "迦南生长子西顿，又生赫",
      "notes": []
    },
    {
      "verse": 14,
      "text": "和耶布斯人、亚摩利人、革迦撒人、",
      "notes": []
    },
    {
      "verse": 15,
      "text": "希未人、亚基人、西尼人、",
      "notes": []
    },
    {
      "verse": 16,
      "text": "亚瓦底人、洗玛利人，并哈马人。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "闪的儿子是以拦、亚述、亚法 撒、路德、亚兰、乌斯、户勒、基帖、米设。",
      "notes": [
        "在创世记十章二十三节是玛施"
      ]
    },
    {
      "verse": 18,
      "text": "亚法撒生沙拉；沙拉生希伯。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "希伯生了两个儿子：一个名叫法勒，因为那时人就分地居住；法勒的兄弟名叫约坍。",
      "notes": [
        "就是分的意思"
      ]
    },
    {
      "verse": 20,
      "text": "约坍生亚摩答、沙列、哈萨玛非、耶拉、",
      "notes": []
    },
    {
      "verse": 21,
      "text": "哈多兰、乌萨、德拉、",
      "notes": []
    },
    {
      "verse": 22,
      "text": "以巴录、亚比玛利、示巴、",
      "notes": []
    },
    {
      "verse": 23,
      "text": "阿斐、哈腓拉、约巴。这都是约坍的儿子。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "闪生亚法撒；亚法撒生沙拉；",
      "notes": []
    },
    {
      "verse": 25,
      "text": "沙拉生希伯；希伯生法勒；法勒生拉吴；",
      "notes": []
    },
    {
      "verse": 26,
      "text": "拉吴生西鹿；西鹿生拿鹤；拿鹤生他拉；",
      "notes": []
    },
    {
      "verse": 27,
      "text": "他拉生亚伯兰，亚伯兰就是亚伯拉罕。",
      "notes": []
    },
    {
      "verse": 28,
      "section_headings": [
        "以实玛利的后裔"
      ],
      "text": "亚伯拉罕的儿子是以撒、以实玛利。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "以实玛利的儿子记在下面：以实玛利的长子是尼拜约，其次是基达、押德别、米比衫、",
      "notes": []
    },
    {
      "verse": 30,
      "text": "米施玛、度玛、玛撒、哈达、提玛、",
      "notes": []
    },
    {
      "verse": 31,
      "text": "伊突、拿非施、基底玛。这都是以实玛利的儿子。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "亚伯拉罕的妾基土拉所生的儿子，就是心兰、约珊、米但、米甸、伊施巴、书亚。约珊的儿子是示巴、底但。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "米甸的儿子是以法、以弗、哈诺、亚比大、以勒大。这都是基土拉的子孙。",
      "notes": []
    },
    {
      "verse": 34,
      "section_headings": [
        "以扫的后裔"
      ],
      "text": "亚伯拉罕生以撒；以撒的儿子是以扫和以色列。",
      "notes": []
    },
    {
      "verse": 35,
      "text": "以扫的儿子是以利法、流珥、耶乌施、雅兰、可拉。",
      "notes": []
    },
    {
      "verse": 36,
      "text": "以利法的儿子是提幔、阿抹、洗玻、迦坦、基纳斯、亭纳、亚玛力。",
      "notes": []
    },
    {
      "verse": 37,
      "text": "流珥的儿子是拿哈、谢拉、沙玛、米撒。",
      "notes": []
    },
    {
      "verse": 38,
      "section_headings": [
        "以东地的原住民"
      ],
      "text": "西珥的儿子是罗坍、朔巴、祭便、亚拿、底顺、以察、底珊。",
      "notes": []
    },
    {
      "verse": 39,
      "text": "罗坍的儿子是何利、荷幔；罗坍的妹子是亭纳。",
      "notes": []
    },
    {
      "verse": 40,
      "text": "朔巴的儿子是亚勒文、玛拿辖、以巴录、示非、阿南。祭便的儿子是亚雅、亚拿。",
      "notes": []
    },
    {
      "verse": 41,
      "text": "亚拿的儿子是底顺。底顺的儿子是哈默兰、伊是班、益兰、基兰。",
      "notes": []
    },
    {
      "verse": 42,
      "text": "以察的儿子是辟罕、撒番、亚干。底珊的儿子是乌斯、亚兰。",
      "notes": []
    },
    {
      "verse": 43,
      "section_headings": [
        "以东诸王"
      ],
      "text": "以色列人未有君王治理之先，在以东地作王的记在下面：有比珥的儿子比拉，他的京城名叫亭哈巴。",
      "notes": []
    },
    {
      "verse": 44,
      "text": "比拉死了，波斯拉人谢拉的儿子约巴接续他作王。",
      "notes": []
    },
    {
      "verse": 45,
      "text": "约巴死了，提幔地的人户珊接续他作王。",
      "notes": []
    },
    {
      "verse": 46,
      "text": "户珊死了，比达的儿子哈达接续他作王。这哈达就是在摩押地杀败米甸人的，他的京城名叫亚未得。",
      "notes": []
    },
    {
      "verse": 47,
      "text": "哈达死了，玛士利加人桑拉接续他作王。",
      "notes": []
    },
    {
      "verse": 48,
      "text": "桑拉死了，大河边的利河伯人扫罗接续他作王。",
      "notes": []
    },
    {
      "verse": 49,
      "text": "扫罗死了，亚革波的儿子巴勒·哈南接续他作王。",
      "notes": []
    },
    {
      "verse": 50,
      "text": "巴勒·哈南死了，哈达接续他作王。他的京城名叫巴伊，他的妻子名叫米希她别，是米·萨合的孙女，玛特列的女儿。",
      "notes": []
    },
    {
      "verse": 51,
      "text": "哈达死了，以东人的族长有亭纳族长、亚勒瓦族长、耶帖族长、",
      "notes": []
    },
    {
      "verse": 52,
      "text": "亚何利巴玛族长、以拉族长、比嫩族长、",
      "notes": []
    },
    {
      "verse": 53,
      "text": "基纳斯族长、提幔族长、米比萨族长、",
      "notes": []
    },
    {
      "verse": 54,
      "text": "玛基叠族长、以兰族长。这都是以东人的族长。",
      "notes": []
    }
  ]
}
