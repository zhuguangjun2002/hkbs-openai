{
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 149,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/149/",
  "verses": [
    {
      "verse": 1,
      "text": "你们要赞美耶和华！向耶和华唱新歌，在圣民的会中赞美他！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "愿以色列因造他的主欢喜！愿锡安的民因他们的王快乐！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "愿他们跳舞赞美他的名，击鼓弹琴歌颂他！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "因为耶和华喜爱他的百姓；他要用救恩当作谦卑人的妆饰。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "愿圣民因所得的荣耀高兴！愿他们在床上欢呼！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "愿他们口中称赞神为高，手里有两刃的刀，",
      "notes": []
    },
    {
      "verse": 7,
      "text": "为要报复列邦，刑罚万民。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "要用链子捆他们的君王，用铁镣锁他们的大臣；",
      "notes": []
    },
    {
      "verse": 9,
      "text": "要在他们身上施行所记录的审判。他的圣民都有这荣耀。你们要赞美耶和华！",
      "notes": []
    }
  ]
}
