{
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 29,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/29/",
  "verses": [
    {
      "verse": 1,
      "text": "神的众子啊，你们要将荣耀、能力归给耶和华，归给耶和华！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "要将耶和华的名所当得的荣耀归给他，以圣洁的妆饰敬拜耶和华。",
      "notes": [
        "的：或译为"
      ]
    },
    {
      "verse": 3,
      "text": "耶和华的声音发在水上；荣耀的神打雷，耶和华打雷在大水之上。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华的声音大有能力；耶和华的声音满有威严。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "耶和华的声音震破香柏树；耶和华震碎黎巴嫩的香柏树。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他也使之跳跃如牛犊，使黎巴嫩和西连跳跃如野牛犊。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "耶和华的声音使火焰分岔。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和华的声音震动旷野；耶和华震动加低斯的旷野。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "耶和华的声音惊动母鹿落胎，树木也脱落净光。凡在他殿中的，都称说他的荣耀。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "洪水泛滥之时，耶和华坐着为王；耶和华坐着为王，直到永远。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "耶和华必赐力量给他的百姓；耶和华必赐平安的福给他的百姓。",
      "notes": []
    }
  ]
}
