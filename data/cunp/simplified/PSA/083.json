{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 83,
  "heading": "求主败敌",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/83/",
  "verses": [
    {
      "verse": 1,
      "text": "神啊，求你不要静默！神啊，求你不要闭口，也不要不作声！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "因为你的仇敌喧嚷，恨你的抬起头来。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他们同谋奸诈要害你的百姓，彼此商议要害你所隐藏的人。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他们说：来吧，我们将他们剪灭，使他们不再成国！使以色列的名不再被人记念！",
      "notes": []
    },
    {
      "verse": 5,
      "text": "他们同心商议，彼此结盟，要抵挡你，",
      "notes": []
    },
    {
      "verse": 6,
      "text": "就是住帐棚的以东人和以实玛利人，摩押和夏甲人，",
      "notes": []
    },
    {
      "verse": 7,
      "text": "迦巴勒、亚扪，和亚玛力、非利士并泰尔的居民。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "亚述也与他们连合；他们作罗得子孙的帮手。 （细拉）",
      "notes": []
    },
    {
      "verse": 9,
      "text": "求你待他们，如待米甸，如在基顺河待西西拉和耶宾一样。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "他们在隐·多珥灭亡，成了地上的粪土。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "求你叫他们的首领像俄立和西伊伯，叫他们的王子都像西巴和撒慕拿。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "他们说：我们要得神的住处，作为自己的产业。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "我的神啊，求你叫他们像旋风的尘土，像风前的碎秸。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "火怎样焚烧树林，火焰怎样烧着山岭，",
      "notes": []
    },
    {
      "verse": 15,
      "text": "求你也照样用狂风追赶他们，用暴雨恐吓他们。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "愿你使他们满面羞耻，好叫他们寻求你—耶和华的名！",
      "notes": []
    },
    {
      "verse": 17,
      "text": "愿他们永远羞愧惊惶！愿他们惭愧灭亡！",
      "notes": []
    },
    {
      "verse": 18,
      "text": "使他们知道：惟独你—名为耶和华的—是全地以上的至高者！",
      "notes": []
    }
  ]
}
