{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 13,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/13/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华啊，你忘记我要到几时呢？要到永远吗？你掩面不顾我要到几时呢？",
      "notes": []
    },
    {
      "verse": 2,
      "text": "我心里筹算，终日愁苦，要到几时呢？我的仇敌升高压制我，要到几时呢？",
      "notes": []
    },
    {
      "verse": 3,
      "text": "耶和华—我的神啊，求你看顾我，应允我！使我眼目光明，免得我沉睡至死；",
      "notes": []
    },
    {
      "verse": 4,
      "text": "免得我的仇敌说：我胜了他；免得我的敌人在我摇动的时候喜乐。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "但我倚靠你的慈爱；我的心因你的救恩快乐。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我要向耶和华歌唱，因他用厚恩待我。",
      "notes": []
    }
  ]
}
