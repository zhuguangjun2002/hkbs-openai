{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 79,
  "heading": "求主解救国家",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/79/",
  "verses": [
    {
      "verse": 1,
      "text": "神啊，外邦人进入你的产业，污秽你的圣殿，使耶路撒冷变成荒堆，",
      "notes": []
    },
    {
      "verse": 2,
      "text": "把你仆人的尸首交与天空的飞鸟为食，把你圣民的肉交与地上的野兽，",
      "notes": []
    },
    {
      "verse": 3,
      "text": "在耶路撒冷周围流他们的血如水，无人葬埋。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "我们成为邻国的羞辱，成为我们四围人的嗤笑讥刺。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "耶和华啊，这到几时呢？你要动怒到永远吗？你的愤恨要如火焚烧吗？",
      "notes": []
    },
    {
      "verse": 6,
      "text": "愿你将你的忿怒倒在那不认识你的外邦和那不求告你名的国度。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "因为他们吞了雅各，把他的住处变为荒场。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "求你不要记念我们先祖的罪孽，向我们追讨；愿你的慈悲快迎着我们，因为我们落到极卑微的地步。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "拯救我们的神啊，求你因你名的荣耀帮助我们！为你名的缘故搭救我们，赦免我们的罪。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "为何容外邦人说「他们的神在哪里」呢？愿你使外邦人知道你在我们眼前伸你仆人流血的冤。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "愿被囚之人的叹息达到你面前；愿你按你的大能力存留那些将要死的人。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "主啊，愿你将我们邻邦所羞辱你的羞辱加七倍归到他们身上。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "这样，你的民，你草场的羊，要称谢你，直到永远；要述说赞美你的话，直到万代。",
      "notes": []
    }
  ]
}
