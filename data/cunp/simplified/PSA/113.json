{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 113,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/113/",
  "verses": [
    {
      "verse": 1,
      "text": "你们要赞美耶和华！耶和华的仆人哪，你们要赞美，赞美耶和华的名！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "耶和华的名是应当称颂的，从今时直到永远！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "从日出之地到日落之处，耶和华的名是应当赞美的！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华超乎万民之上；他的荣耀高过诸天。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "谁像耶和华—我们的神呢？他坐在至高之处，",
      "notes": []
    },
    {
      "verse": 6,
      "text": "自己谦卑，观看天上地下的事。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他从灰尘里抬举贫寒人，从粪堆中提拔穷乏人，",
      "notes": []
    },
    {
      "verse": 8,
      "text": "使他们与王子同坐，就是与本国的王子同坐。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他使不能生育的妇人安居家中，为多子的乐母。你们要赞美耶和华！",
      "notes": []
    }
  ]
}
