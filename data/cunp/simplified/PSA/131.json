{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 131,
  "heading": "谦卑靠主",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/131/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华啊，我的心不狂傲，我的眼不高大；重大和测不透的事，我也不敢行。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "我的心平稳安静，好像断过奶的孩子在他母亲的怀中；我的心在我里面真像断过奶的孩子。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "以色列啊，你当仰望耶和华，从今时直到永远！",
      "notes": []
    }
  ]
}
