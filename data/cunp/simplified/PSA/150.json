{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 150,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/150/",
  "verses": [
    {
      "verse": 1,
      "text": "你们要赞美耶和华！在神的圣所赞美他！在他显能力的穹苍赞美他！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "要因他大能的作为赞美他，按着他极美的大德赞美他！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "要用角声赞美他，鼓瑟弹琴赞美他！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "击鼓跳舞赞美他！用丝弦的乐器和箫的声音赞美他！",
      "notes": []
    },
    {
      "verse": 5,
      "text": "用大响的钹赞美他！用高声的钹赞美他！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "凡有气息的都要赞美耶和华！你们要赞美耶和华！",
      "notes": []
    }
  ]
}
