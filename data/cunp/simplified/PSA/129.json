{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 129,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/129/",
  "verses": [
    {
      "verse": 1,
      "text": "以色列当说：从我幼年以来，敌人屡次苦害我，",
      "notes": []
    },
    {
      "verse": 2,
      "text": "从我幼年以来，敌人屡次苦害我，却没有胜了我。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "如同扶犁的在我背上扶犁而耕，耕的犁沟甚长。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华是公义的；他砍断了恶人的绳索。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "愿恨恶锡安的都蒙羞退后！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "愿他们像房顶上的草，未长成而枯干，",
      "notes": []
    },
    {
      "verse": 7,
      "text": "收割的不够一把，捆禾的也不满怀。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "过路的也不说：愿耶和华所赐的福归与你们！我们奉耶和华的名给你们祝福！",
      "notes": []
    }
  ]
}
