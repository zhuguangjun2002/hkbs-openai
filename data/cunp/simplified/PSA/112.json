{
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 112,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/112/",
  "verses": [
    {
      "verse": 1,
      "text": "你们要赞美耶和华！敬畏耶和华，甚喜爱他命令的，这人便为有福！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "他的后裔在世必强盛；正直人的后代必要蒙福。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他家中有货物，有钱财；他的公义存到永远。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "正直人在黑暗中，有光向他发现；他有恩惠，有怜悯，有公义。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "施恩与人、借贷与人的，这人事情顺利；他被审判的时候要诉明自己的冤。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他永不动摇；义人被记念，直到永远。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他必不怕凶恶的信息；他心坚定，倚靠耶和华。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他心确定，总不惧怕，直到他看见敌人遭报。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他施舍钱财，周济贫穷；他的仁义存到永远。他的角必被高举，大有荣耀。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "恶人看见便恼恨，必咬牙而消化；恶人的心愿要归灭绝。",
      "notes": []
    }
  ]
}
