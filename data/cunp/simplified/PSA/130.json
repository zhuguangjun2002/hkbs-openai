{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 130,
  "heading": "求助的祈祷",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/130/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华啊，我从深处向你求告！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "主啊，求你听我的声音！愿你侧耳听我恳求的声音！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "主—耶和华啊，你若究察罪孽，谁能站得住呢？",
      "notes": []
    },
    {
      "verse": 4,
      "text": "但在你有赦免之恩，要叫人敬畏你。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "我等候耶和华，我的心等候；我也仰望他的话。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我的心等候主，胜于守夜的，等候天亮，胜于守夜的，等候天亮。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "以色列啊，你当仰望耶和华！因他有慈爱，有丰盛的救恩。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他必救赎以色列脱离一切的罪孽。",
      "notes": []
    }
  ]
}
