{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 100,
  "heading": "颂赞之诗",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/100/",
  "verses": [
    {
      "verse": 1,
      "text": "普天下当向耶和华欢呼！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "你们当乐意事奉耶和华，当来向他歌唱！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "你们当晓得耶和华是神！我们是他造的，也是属他的；我们是他的民，也是他草场的羊。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "当称谢进入他的门；当赞美进入他的院。当感谢他，称颂他的名！",
      "notes": []
    },
    {
      "verse": 5,
      "text": "因为耶和华本为善。他的慈爱存到永远；他的信实直到万代。",
      "notes": []
    }
  ]
}
