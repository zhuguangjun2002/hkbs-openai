{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 67,
  "heading": "感恩的诗",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/67/",
  "verses": [
    {
      "verse": 1,
      "text": "愿神怜悯我们，赐福与我们，用脸光照我们， （细拉）",
      "notes": []
    },
    {
      "verse": 2,
      "text": "好叫世界得知你的道路，万国得知你的救恩。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "神啊，愿列邦称赞你！愿万民都称赞你！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "愿万国都快乐欢呼；因为你必按公正审判万民，引导世上的万国。 （细拉）",
      "notes": []
    },
    {
      "verse": 5,
      "text": "神啊，愿列邦称赞你！愿万民都称赞你！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "地已经出了土产；神—就是我们的神要赐福与我们。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "神要赐福与我们；地的四极都要敬畏他！",
      "notes": []
    }
  ]
}
