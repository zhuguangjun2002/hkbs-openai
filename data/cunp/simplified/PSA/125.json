{
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 125,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/125/",
  "verses": [
    {
      "verse": 1,
      "text": "倚靠耶和华的人好像锡安山，永不动摇。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "众山怎样围绕耶路撒冷，耶和华也照样围绕他的百姓，从今时直到永远。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "恶人的杖不常落在义人的分上，免得义人伸手作恶。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华啊，求你善待那些为善和心里正直的人。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "至于那偏行弯曲道路的人，耶和华必使他和作恶的人一同出去受刑。愿平安归于以色列！",
      "notes": []
    }
  ]
}
