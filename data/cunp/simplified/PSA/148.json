{
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 148,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/148/",
  "verses": [
    {
      "verse": 1,
      "text": "你们要赞美耶和华！从天上赞美耶和华，在高处赞美他！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "他的众使者都要赞美他！他的诸军都要赞美他！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "日头月亮，你们要赞美他！放光的星宿，你们都要赞美他！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "天上的天和天上的水，你们都要赞美他！",
      "notes": []
    },
    {
      "verse": 5,
      "text": "愿这些都赞美耶和华的名！因他一吩咐便都造成。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他将这些立定，直到永永远远；他定了命，不能废去。",
      "notes": [
        "或译：越过"
      ]
    },
    {
      "verse": 7,
      "text": "所有在地上的，大鱼和一切深洋，",
      "notes": []
    },
    {
      "verse": 8,
      "text": "火与冰雹，雪和雾气，成就他命的狂风，",
      "notes": []
    },
    {
      "verse": 9,
      "text": "大山和小山，结果的树木和一切香柏树，",
      "notes": []
    },
    {
      "verse": 10,
      "text": "野兽和一切牲畜，昆虫和飞鸟，",
      "notes": []
    },
    {
      "verse": 11,
      "text": "世上的君王和万民，首领和世上一切审判官，",
      "notes": []
    },
    {
      "verse": 12,
      "text": "少年人和处女，老年人和孩童，都当赞美耶和华！",
      "notes": []
    },
    {
      "verse": 13,
      "text": "愿这些都赞美耶和华的名！因为独有他的名被尊崇；他的荣耀在天地之上。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "他将他百姓的角高举，因此他一切圣民以色列人，就是与他相近的百姓，都赞美他！你们要赞美耶和华！",
      "notes": [
        "或译：他使"
      ]
    }
  ]
}
