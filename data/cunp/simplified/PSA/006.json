{
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 6,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/6/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华啊，求你不要在怒中责备我，也不要在烈怒中惩罚我！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "耶和华啊，求你可怜我，因为我软弱。耶和华啊，求你医治我，因为我的骨头发战。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "我心也大大地惊惶。耶和华啊，你要到几时才救我呢？",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华啊，求你转回搭救我！因你的慈爱拯救我。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "因为，在死地无人记念你，在阴间有谁称谢你？",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我因唉哼而困乏；我每夜流泪，把床榻漂起，把褥子湿透。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "我因忧愁眼睛干瘪，又因我一切的敌人眼睛昏花。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "你们一切作孽的人，离开我吧！因为耶和华听了我哀哭的声音。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "耶和华听了我的恳求；耶和华必收纳我的祷告。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "我的一切仇敌都必羞愧，大大惊惶；他们必要退后，忽然羞愧。",
      "notes": []
    }
  ]
}
