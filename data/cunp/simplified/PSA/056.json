{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 56,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/56/",
  "verses": [
    {
      "verse": 1,
      "text": "神啊，求你怜悯我，因为人要把我吞了，终日攻击欺压我。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "我的仇敌终日要把我吞了，因逞骄傲攻击我的人甚多。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "我惧怕的时候要倚靠你。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "我倚靠神，我要赞美他的话；我倚靠神，必不惧怕。血气之辈能把我怎么样呢？",
      "notes": []
    },
    {
      "verse": 5,
      "text": "他们终日颠倒我的话；他们一切的心思都是要害我。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他们聚集，埋伏窥探我的脚踪，等候要害我的命。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他们岂能因罪孽逃脱吗？神啊，求你在怒中使众民堕落！",
      "notes": []
    },
    {
      "verse": 8,
      "text": "我几次流离，你都记数；求你把我眼泪装在你的皮袋里。这不都记在你册子上吗？",
      "notes": []
    },
    {
      "verse": 9,
      "text": "我呼求的日子，我的仇敌都要转身退后。神帮助我，这是我所知道的。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "我倚靠神，我要赞美他的话；我倚靠耶和华，我要赞美他的话。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "我倚靠神，必不惧怕。人能把我怎么样呢？",
      "notes": []
    },
    {
      "verse": 12,
      "text": "神啊，我向你所许的愿在我身上；我要将感谢祭献给你。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "因为你救我的命脱离死亡。你岂不是救护我的脚不跌倒、使我在生命光中行在神面前吗？",
      "notes": []
    }
  ]
}
