{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 85,
  "heading": "为国求福",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/85/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华啊，你已经向你的地施恩，救回被掳的雅各。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "你赦免了你百姓的罪孽，遮盖了他们一切的过犯。 （细拉）",
      "notes": []
    },
    {
      "verse": 3,
      "text": "你收转了所发的忿怒和你猛烈的怒气。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "拯救我们的神啊，求你使我们回转，叫你的恼恨向我们止息。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "你要向我们发怒到永远吗？你要将你的怒气延留到万代吗？",
      "notes": []
    },
    {
      "verse": 6,
      "text": "你不再将我们救活，使你的百姓靠你欢喜吗？",
      "notes": []
    },
    {
      "verse": 7,
      "text": "耶和华啊，求你使我们得见你的慈爱，又将你的救恩赐给我们。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "我要听神—耶和华所说的话；因为他必应许将平安赐给他的百姓—他的圣民；他们却不可再转去妄行。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他的救恩诚然与敬畏他的人相近，叫荣耀住在我们的地上。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "慈爱和诚实彼此相遇；公义和平安彼此相亲。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "诚实从地而生；公义从天而现。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "耶和华必将好处赐给我们；我们的地也要多出土产。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "公义要行在他面前，叫他的脚踪成为可走的路。",
      "notes": []
    }
  ]
}
