{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 11,
  "heading": "在主里得安稳",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/11/",
  "verses": [
    {
      "verse": 1,
      "text": "我是投靠耶和华；你们怎么对我说：你当像鸟飞往你的山去。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "看哪，恶人弯弓，把箭搭在弦上，要在暗中射那心里正直的人。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "根基若毁坏，义人还能做什么呢？",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和华在他的圣殿里；耶和华的宝座在天上；他的慧眼察看世人。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "耶和华试验义人；惟有恶人和喜爱强暴的人，他心里恨恶。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他要向恶人密布网罗；有烈火、硫磺、热风，作他们杯中的分。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "因为耶和华是公义的，他喜爱公义；正直人必得见他的面。",
      "notes": []
    }
  ]
}
