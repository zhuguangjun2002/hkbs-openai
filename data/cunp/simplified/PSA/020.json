{
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 20,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/20/",
  "verses": [
    {
      "verse": 1,
      "text": "愿耶和华在你遭难的日子应允你；愿名为雅各神的高举你。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "愿他从圣所救助你，从锡安坚固你，",
      "notes": []
    },
    {
      "verse": 3,
      "text": "记念你的一切供献，悦纳你的燔祭， （细拉）",
      "notes": []
    },
    {
      "verse": 4,
      "text": "将你心所愿的赐给你，成就你的一切筹算。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "我们要因你的救恩夸胜，要奉我们神的名竖立旌旗。愿耶和华成就你一切所求的！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "现在我知道耶和华救护他的受膏者，必从他的圣天上应允他，用右手的能力救护他。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "有人靠车，有人靠马，但我们要提到耶和华—我们神的名。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他们都屈身仆倒，我们却起来，立得正直。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "求耶和华施行拯救；我们呼求的时候，愿王应允我们！",
      "notes": []
    }
  ]
}
