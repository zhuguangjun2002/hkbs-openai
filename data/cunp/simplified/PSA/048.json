{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 48,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/48/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华本为大！在我们神的城中，在他的圣山上，该受大赞美。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "锡安山—大君王的城，在北面居高华美，为全地所喜悦。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "神在其宫中，自显为避难所。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "看哪，众王会合，一同经过。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "他们见了这城就惊奇丧胆，急忙逃跑。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他们在那里被战兢疼痛抓住，好像产难的妇人一样。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "神啊，你用东风打破他施的船只。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "我们在万军之耶和华的城中—就是我们神的城中—所看见的，正如我们所听见的。神必坚立这城，直到永远。 （细拉）",
      "notes": []
    },
    {
      "verse": 9,
      "text": "神啊，我们在你的殿中想念你的慈爱。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "神啊，你受的赞美正与你的名相称，直到地极！你的右手满了公义。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "因你的判断，锡安山应当欢喜，犹大的城邑应当快乐。",
      "notes": [
        "原文是女子"
      ]
    },
    {
      "verse": 12,
      "text": "你们当周游锡安，四围旋绕，数点城楼，",
      "notes": []
    },
    {
      "verse": 13,
      "text": "细看她的外郭，察看她的宫殿，为要传说到后代。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "因为这神永永远远为我们的神；他必作我们引路的，直到死时。",
      "notes": []
    }
  ]
}
