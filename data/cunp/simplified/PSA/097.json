{
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 97,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/97/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和华作王！愿地快乐！愿众海岛欢喜！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "密云和幽暗在他的四围；公义和公平是他宝座的根基。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "有烈火在他前头行，烧灭他四围的敌人。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "他的闪电光照世界，大地看见便震动。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "诸山见耶和华的面，就是全地之主的面，便消化如蜡。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "诸天表明他的公义；万民看见他的荣耀。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "愿一切事奉雕刻的偶像、靠虚无之神自夸的，都蒙羞愧。万神哪，你们都当拜他。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "耶和华啊，锡安听见你的判断就欢喜；犹大的城邑也都快乐。",
      "notes": [
        "原文是女子"
      ]
    },
    {
      "verse": 9,
      "text": "因为你—耶和华至高，超乎全地；你被尊崇，远超万神之上。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "你们爱耶和华的，都当恨恶罪恶；他保护圣民的性命，搭救他们脱离恶人的手。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "散布亮光是为义人；预备喜乐是为正直人。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "你们义人当靠耶和华欢喜，称谢他可记念的圣名。",
      "notes": []
    }
  ]
}
