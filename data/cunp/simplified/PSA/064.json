{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PSA",
  "book_name": "诗篇",
  "chapter": 64,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PSA/64/",
  "verses": [
    {
      "verse": 1,
      "text": "神啊，我哀叹的时候，求你听我的声音！求你保护我的性命，不受仇敌的惊恐！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "求你把我隐藏，使我脱离作恶之人的暗谋和作孽之人的扰乱。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他们磨舌如刀，发出苦毒的言语，好像比准了的箭，",
      "notes": []
    },
    {
      "verse": 4,
      "text": "要在暗地射完全人；他们忽然射他，并不惧怕。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "他们彼此勉励设下恶计；他们商量暗设网罗，说：谁能看见？",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他们图谋奸恶，说：我们是极力图谋的。他们各人的意念心思是深的。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "但神要射他们；他们忽然被箭射伤。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他们必然绊跌，被自己的舌头所害；凡看见他们的必都摇头。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "众人都要害怕，要传扬神的工作，并且明白他的作为。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "义人必因耶和华欢喜，并要投靠他；凡心里正直的人都要夸口。",
      "notes": []
    }
  ]
}
