{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 18,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PRO/18/",
  "verses": [
    {
      "verse": 1,
      "text": "与众寡合的，独自寻求心愿，并恼恨一切真智慧。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "愚昧人不喜爱明哲，只喜爱显露心意。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "恶人来，藐视随来；羞耻到，辱骂同到。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "人口中的言语如同深水；智慧的泉源好像涌流的河水。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "瞻徇恶人的情面，偏断义人的案件，都为不善。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "愚昧人张嘴启争端，开口招鞭打。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "愚昧人的口自取败坏；他的嘴是他生命的网罗。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "传舌人的言语如同美食，深入人的心腹。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "做工懈怠的，与浪费人为弟兄。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "耶和华的名是坚固台；义人奔入便得安稳。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "富足人的财物是他的坚城，在他心想，犹如高墙。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "败坏之先，人心骄傲；尊荣以前，必有谦卑。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "未曾听完先回答的，便是他的愚昧和羞辱。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "人有疾病，心能忍耐；心灵忧伤，谁能承当呢？",
      "notes": []
    },
    {
      "verse": 15,
      "text": "聪明人的心得知识；智慧人的耳求知识。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "人的礼物为他开路，引他到高位的人面前。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "先诉情由的，似乎有理；但邻舍来到，就察出实情。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "掣签能止息争竞，也能解散强胜的人。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "弟兄结怨，劝他和好，比取坚固城还难；这样的争竞如同坚寨的门闩。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "人口中所结的果子，必充满肚腹；他嘴所出的，必使他饱足。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "生死在舌头的权下，喜爱它的，必吃它所结的果子。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "得着贤妻的，是得着好处，也是蒙了耶和华的恩惠。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "贫穷人说哀求的话；富足人用威吓的话回答。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "滥交朋友的，自取败坏；但有一朋友比弟兄更亲密。",
      "notes": []
    }
  ]
}
