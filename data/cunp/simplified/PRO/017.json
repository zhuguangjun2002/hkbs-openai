{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 17,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PRO/17/",
  "verses": [
    {
      "verse": 1,
      "text": "设筵满屋，大家相争，不如有块干饼，大家相安。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "仆人办事聪明，必管辖贻羞之子，又在众子中同分产业。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "鼎为炼银，炉为炼金；惟有耶和华熬炼人心。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "行恶的，留心听奸诈之言；说谎的，侧耳听邪恶之语。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "戏笑穷人的，是辱没造他的主；幸灾乐祸的，必不免受罚。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "子孙为老人的冠冕；父亲是儿女的荣耀。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "愚顽人说美言本不相宜，何况君王说谎话呢？",
      "notes": []
    },
    {
      "verse": 8,
      "text": "贿赂在馈送的人眼中看为宝玉，随处运动都得顺利。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "遮掩人过的，寻求人爱；屡次挑错的，离间密友。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "一句责备话深入聪明人的心，强如责打愚昧人一百下。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "恶人只寻背叛，所以必有严厉的使者奉差攻击他。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "宁可遇见丢崽子的母熊，不可遇见正行愚妄的愚昧人。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "以恶报善的，祸患必不离他的家。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "纷争的起头如水放开，所以，在争闹之先必当止息争竞。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "定恶人为义的，定义人为恶的，这都为耶和华所憎恶。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "愚昧人既无聪明，为何手拿价银买智慧呢？",
      "notes": []
    },
    {
      "verse": 17,
      "text": "朋友乃时常亲爱，弟兄为患难而生。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "在邻舍面前击掌作保乃是无知的人。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "喜爱争竞的，是喜爱过犯；高立家门的，乃自取败坏。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "心存邪僻的，寻不着好处；舌弄是非的，陷在祸患中。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "生愚昧子的，必自愁苦；愚顽人的父毫无喜乐。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "喜乐的心乃是良药；忧伤的灵使骨枯干。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "恶人暗中受贿赂，为要颠倒判断。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "明哲人眼前有智慧；愚昧人眼望地极。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "愚昧子使父亲愁烦，使母亲忧苦。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "刑罚义人为不善；责打君子为不义。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "寡少言语的，有知识；性情温良的，有聪明。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "愚昧人若静默不言也可算为智慧；闭口不说也可算为聪明。",
      "notes": []
    }
  ]
}
