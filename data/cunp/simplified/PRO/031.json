{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 31,
  "heading": "给一君王的忠告",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/PRO/31/",
  "verses": [
    {
      "verse": 1,
      "text": "利慕伊勒王的言语，是他母亲教训他的真言。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "我的儿啊，我腹中生的儿啊，我许愿得的儿啊！我当怎样教训你呢？",
      "notes": []
    },
    {
      "verse": 3,
      "text": "不要将你的精力给妇女；也不要有败坏君王的行为。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "利慕伊勒啊，君王喝酒，君王喝酒不相宜；王子说浓酒在那里也不相宜；",
      "notes": []
    },
    {
      "verse": 5,
      "text": "恐怕喝了就忘记律例，颠倒一切困苦人的是非。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "可以把浓酒给将亡的人喝，把清酒给苦心的人喝，",
      "notes": []
    },
    {
      "verse": 7,
      "text": "让他喝了，就忘记他的贫穷，不再记念他的苦楚。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "你当为哑巴开口，为一切孤独的伸冤。",
      "notes": [
        "或译：不能自辩的"
      ]
    },
    {
      "verse": 9,
      "text": "你当开口按公义判断，为困苦和穷乏的辨屈。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "才德的妇人谁能得着呢？她的价值远胜过珍珠。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "她丈夫心里倚靠她，必不缺少利益；",
      "notes": []
    },
    {
      "verse": 12,
      "text": "她一生使丈夫有益无损。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "她寻找羊绒和麻，甘心用手做工。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "她好像商船从远方运粮来，",
      "notes": []
    },
    {
      "verse": 15,
      "text": "未到黎明她就起来，把食物分给家中的人，将当做的工分派婢女。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "她想得田地就买来；用手所得之利栽种葡萄园。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "她以能力束腰，使膀臂有力。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "她觉得所经营的有利；她的灯终夜不灭。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "她手拿捻线竿，手把纺线车。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "她张手周济困苦人，伸手帮补穷乏人。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "她不因下雪为家里的人担心，因为全家都穿着朱红衣服。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "她为自己制作绣花毯子；她的衣服是细麻和紫色布做的。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "她丈夫在城门口与本地的长老同坐，为众人所认识。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "她做细麻布衣裳出卖，又将腰带卖与商家。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "能力和威仪是她的衣服；她想到日后的景况就喜笑。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "她开口就发智慧；她舌上有仁慈的法则。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "她观察家务，并不吃闲饭。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "她的儿女起来称她有福；她的丈夫也称赞她，",
      "notes": []
    },
    {
      "verse": 29,
      "text": "说：才德的女子很多，惟独你超过一切。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "艳丽是虚假的，美容是虚浮的；惟敬畏耶和华的妇女必得称赞。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "愿她享受操作所得的；愿她的工作在城门口荣耀她。",
      "notes": []
    }
  ]
}
