  "book_code": "JOB",
  "book_name": "约伯记",
  "chapter": 25,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/JOB/25/",
  "verses": [
    {
      "verse": 1,
      "text": "书亚人比勒达回答说：",
      "notes": []
    },
    {
      "verse": 2,
      "text": "神有治理之权，有威严可畏；他在高处施行和平。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他的诸军岂能数算？他的光亮一发，谁不蒙照呢？",
      "notes": []
    },
    {
      "verse": 4,
      "text": "这样在神面前，人怎能称义？妇人所生的怎能洁净？",
      "notes": []
    },
    {
      "verse": 5,
      "text": "在神眼前，月亮也无光亮，星宿也不清洁。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "何况如虫的人，如蛆的世人呢！",
      "notes": []
    }
  ]
}
