{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "JOB",
  "book_name": "约伯记",
  "chapter": 39,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/JOB/39/",
  "verses": [
    {
      "verse": 1,
      "text": "山岩间的野山羊几时生产，你知道吗？母鹿下犊之期，你能察定吗？",
      "notes": []
    },
    {
      "verse": 2,
      "text": "它们怀胎的月数，你能数算吗？它们几时生产，你能晓得吗？",
      "notes": []
    },
    {
      "verse": 3,
      "text": "它们屈身，将子生下，就除掉疼痛。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "这子渐渐肥壮，在荒野长大，去而不回。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "谁放野驴出去自由？谁解开快驴的绳索？",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我使旷野作它的住处，使咸地当它的居所。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "它嗤笑城内的喧嚷，不听赶牲口的喝声。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "遍山是它的草场；它寻找各样青绿之物。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "野牛岂肯服事你？岂肯住在你的槽旁？",
      "notes": []
    },
    {
      "verse": 10,
      "text": "你岂能用套绳将野牛笼在犁沟之间？它岂肯随你耙山谷之地？",
      "notes": []
    },
    {
      "verse": 11,
      "text": "岂可因它的力大就倚靠它？岂可把你的工交给它做吗？",
      "notes": []
    },
    {
      "verse": 12,
      "text": "岂可信靠它把你的粮食运到家，又收聚你禾场上的谷吗？",
      "notes": []
    },
    {
      "verse": 13,
      "text": "鸵鸟的翅膀欢然搧展，岂是显慈爱的翎毛和羽毛吗？",
      "notes": []
    },
    {
      "verse": 14,
      "text": "因它把蛋留在地上，在尘土中使得温暖；",
      "notes": []
    },
    {
      "verse": 15,
      "text": "却想不到被脚踹碎，或被野兽践踏。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "它忍心待雏，似乎不是自己的；虽然徒受劳苦，也不为雏惧怕；",
      "notes": []
    },
    {
      "verse": 17,
      "text": "因为神使它没有智慧，也未将悟性赐给它。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "它几时挺身展开翅膀，就嗤笑马和骑马的人。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "马的大力是你所赐的吗？它颈项上挓挲的鬃是你给它披上的吗？",
      "notes": []
    },
    {
      "verse": 20,
      "text": "是你叫它跳跃像蝗虫吗？它喷气之威使人惊惶。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "它在谷中刨地，自喜其力；它出去迎接佩带兵器的人。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "它嗤笑可怕的事并不惊惶，也不因刀剑退回。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "箭袋和发亮的枪，并短枪在它身上铮铮有声。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "它发猛烈的怒气将地吞下；一听角声就不耐站立。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "角每发声，它说呵哈；它从远处闻着战气，又听见军长大发雷声和兵丁呐喊。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "鹰雀飞翔，展开翅膀一直向南，岂是借你的智慧吗？",
      "notes": []
    },
    {
      "verse": 27,
      "text": "大鹰上腾在高处搭窝，岂是听你的吩咐吗？",
      "notes": []
    },
    {
      "verse": 28,
      "text": "它住在山岩，以山峰和坚固之所为家，",
      "notes": []
    },
    {
      "verse": 29,
      "text": "从那里窥看食物，眼睛远远观望。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "它的雏也咂血；被杀的人在哪里，它也在那里。",
      "notes": []
    }
  ]
}
