{
  "translation": "cunp",
  "version": "CUNP1s",
  "version_name": "新标点和合本",
  "script": "simplified",
  "book_code": "GEN",
  "book_name": "创世记",
  "chapter": 25,
  "heading": "亚伯拉罕的其他后代",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1s/GEN/25/",
  "verses": [
    {
      "verse": 1,
      "text": "亚伯拉罕又娶了一妻，名叫基土拉。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "基土拉给他生了心兰、约珊、米但、米甸、伊施巴，和书亚。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "约珊生了示巴和底但。底但的子孙是亚书利族、利都是族，和利乌米族。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "米甸的儿子是以法、以弗、哈诺、亚比大，和以勒大。这都是基土拉的子孙。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "亚伯拉罕将一切所有的都给了以撒。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "亚伯拉罕把财物分给他庶出的众子，趁着自己还在世的时候打发他们离开他的儿子以撒，往东方去。",
      "notes": []
    },
    {
      "verse": 7,
      "section_headings": [
        "亚伯拉罕的死和埋葬"
      ],
      "text": "亚伯拉罕一生的年日是一百七十五岁。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "亚伯拉罕寿高年迈，气绝而死，归到他列祖那里。",
      "notes": [
        "原文是本民"
      ]
    },
    {
      "verse": 9,
      "text": "他两个儿子以撒、以实玛利把他埋葬在麦比拉洞里。这洞在幔利前、赫人琐辖的儿子以弗仑的田中，",
      "notes": []
    },
    {
      "verse": 10,
      "text": "就是亚伯拉罕向赫人买的那块田。亚伯拉罕和他妻子撒拉都葬在那里。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "亚伯拉罕死了以后，神赐福给他的儿子以撒。以撒靠近庇耳·拉海·莱居住。",
      "notes": []
    },
    {
      "verse": 12,
      "section_headings": [
        "以实玛利的后代"
      ],
      "text": "撒拉的使女埃及人夏甲给亚伯拉罕所生的儿子是以实玛利。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "以实玛利儿子们的名字，按着他们的家谱记在下面。以实玛利的长子是尼拜约，又有基达、亚德别、米比衫、",
      "notes": []
    },
    {
      "verse": 14,
      "text": "米施玛、度玛、玛撒、",
      "notes": []
    },
    {
      "verse": 15,
      "text": "哈大、提玛、伊突、拿非施、基底玛。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "这是以实玛利众子的名字，照着他们的村庄、营寨，作了十二族的族长。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "以实玛利享寿一百三十七岁，气绝而死，归到他列祖那里。",
      "notes": [
        "原文是本民"
      ]
    },
    {
      "verse": 18,
      "text": "他子孙的住处在他众弟兄东边，从哈腓拉直到埃及前的书珥，正在亚述的道上。",
      "notes": []
    },
    {
      "verse": 19,
      "section_headings": [
        "以扫和雅各出生"
      ],
      "text": "亚伯拉罕的儿子以撒的后代记在下面。亚伯拉罕生以撒。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "以撒娶利百加为妻的时候正四十岁。利百加是巴旦·亚兰地的亚兰人彼土利的女儿，是亚兰人拉班的妹子。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "以撒因他妻子不生育，就为她祈求耶和华；耶和华应允他的祈求，他的妻子利百加就怀了孕。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "孩子们在她腹中彼此相争，她就说：「若是这样，我为什么活着呢？」她就去求问耶和华。",
      "notes": [
        "或译：我为什么如此呢"
      ]
    },
    {
      "verse": 23,
      "text": "耶和华对她说：两国在你腹内；两族要从你身上出来。这族必强于那族；将来大的要服事小的。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "生产的日子到了，腹中果然是双子。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "先产的身体发红，浑身有毛，如同皮衣，他们就给他起名叫以扫。",
      "notes": [
        "就是有毛的意思"
      ]
    },
    {
      "verse": 26,
      "text": "随后又生了以扫的兄弟，手抓住以扫的脚跟，因此给他起名叫雅各。利百加生下两个儿子的时候，以撒年正六十岁。",
      "notes": [
        "就是抓住的意思"
      ]
    },
    {
      "verse": 27,
      "section_headings": [
        "以扫出卖长子的名分"
      ],
      "text": "两个孩子渐渐长大，以扫善于打猎，常在田野；雅各为人安静，常住在帐棚里。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "以撒爱以扫，因为常吃他的野味；利百加却爱雅各。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "有一天，雅各熬汤，以扫从田野回来累昏了。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "以扫对雅各说：「我累昏了，求你把这红汤给我喝。」因此以扫又叫以东。",
      "notes": [
        "就是红的意思"
      ]
    },
    {
      "verse": 31,
      "text": "雅各说：「你今日把长子的名分卖给我吧。」",
      "notes": []
    },
    {
      "verse": 32,
      "text": "以扫说：「我将要死，这长子的名分于我有什么益处呢？」",
      "notes": []
    },
    {
      "verse": 33,
      "text": "雅各说：「你今日对我起誓吧。」以扫就对他起了誓，把长子的名分卖给雅各。",
      "notes": []
    },
    {
      "verse": 34,
      "text": "于是雅各将饼和红豆汤给了以扫，以扫吃了喝了，便起来走了。这就是以扫轻看了他长子的名分。",
      "notes": []
    }
  ]
}
