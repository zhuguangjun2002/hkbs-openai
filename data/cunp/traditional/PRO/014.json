{
  "translation": "cunp",
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 14,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PRO/14/",
  "verses": [
    {
      "verse": 1,
      "text": "智慧婦人建立家室；愚妄婦人親手拆毀。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "行動正直的，敬畏耶和華；行事乖僻的，卻藐視他。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "愚妄人口中驕傲，如杖責打己身；智慧人的嘴必保守自己。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "家裏無牛，槽頭乾淨；土產加多乃憑牛力。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "誠實見證人不說謊話；假見證人吐出謊言。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "褻慢人尋智慧，卻尋不著；聰明人易得知識。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "到愚昧人面前，不見他嘴中有知識。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "通達人的智慧在乎明白己道；愚昧人的愚妄乃是詭詐。",
      "notes": [
        "或譯：自欺"
      ]
    },
    {
      "verse": 9,
      "text": "愚妄人犯罪，以為戲耍；正直人互相喜悅。",
      "notes": [
        "或譯：贖愆祭愚弄愚妄人"
      ]
    },
    {
      "verse": 10,
      "text": "心中的苦楚，自己知道；心裏的喜樂，外人無干。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "奸惡人的房屋必傾倒；正直人的帳棚必興盛。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "有一條路，人以為正，至終成為死亡之路。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "人在喜笑中，心也憂愁；快樂至極就生愁苦。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "心中背道的，必滿得自己的結果；善人必從自己的行為得以知足。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "愚蒙人是話都信；通達人步步謹慎。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "智慧人懼怕，就遠離惡事；愚妄人卻狂傲自恃。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "輕易發怒的，行事愚妄；設立詭計的，被人恨惡。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "愚蒙人得愚昧為產業；通達人得知識為冠冕。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "壞人俯伏在善人面前；惡人俯伏在義人門口。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "貧窮人連鄰舍也恨他；富足人朋友最多。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "藐視鄰舍的，這人有罪；憐憫貧窮的，這人有福。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "謀惡的，豈非走入迷途嗎？謀善的，必得慈愛和誠實。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "諸般勤勞都有益處；嘴上多言乃致窮乏。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "智慧人的財為自己的冠冕；愚妄人的愚昧終是愚昧。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "作真見證的，救人性命；吐出謊言的，施行詭詐。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "敬畏耶和華的，大有倚靠；他的兒女也有避難所。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "敬畏耶和華就是生命的泉源，可以使人離開死亡的網羅。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "帝王榮耀在乎民多；君王衰敗在乎民少。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "不輕易發怒的，大有聰明；性情暴躁的，大顯愚妄。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "心中安靜是肉體的生命；嫉妒是骨中的朽爛。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "欺壓貧寒的，是辱沒造他的主；憐憫窮乏的，乃是尊敬主。",
      "notes": []
    },
    {
      "verse": 32,
      "text": "惡人在所行的惡上必被推倒；義人臨死，有所投靠。",
      "notes": []
    },
    {
      "verse": 33,
      "text": "智慧存在聰明人心中；愚昧人心裏所存的，顯而易見。",
      "notes": []
    },
    {
      "verse": 34,
      "text": "公義使邦國高舉；罪惡是人民的羞辱。",
      "notes": []
    },
    {
      "verse": 35,
      "text": "智慧的臣子蒙王恩惠；貽羞的僕人遭其震怒。",
      "notes": []
    }
  ]
}
