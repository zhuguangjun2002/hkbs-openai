{
  "translation": "cunp",
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 11,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PRO/11/",
  "verses": [
    {
      "verse": 1,
      "text": "詭詐的天平為耶和華所憎惡；公平的法碼為他所喜悅。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "驕傲來，羞恥也來；謙遜人卻有智慧。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "正直人的純正必引導自己；奸詐人的乖僻必毀滅自己。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "發怒的日子資財無益；惟有公義能救人脫離死亡。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "完全人的義必指引他的路；但惡人必因自己的惡跌倒。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "正直人的義必拯救自己；奸詐人必陷在自己的罪孽中。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "惡人一死，他的指望必滅絕；罪人的盼望也必滅沒。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "義人得脫離患難，有惡人來代替他。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "不虔敬的人用口敗壞鄰舍；義人卻因知識得救。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "義人享福，合城喜樂；惡人滅亡，人都歡呼。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "城因正直人祝福便高舉，卻因邪惡人的口就傾覆。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "藐視鄰舍的，毫無智慧；明哲人卻靜默不言。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "往來傳舌的，洩漏密事；心中誠實的，遮隱事情。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "無智謀，民就敗落；謀士多，人便安居。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "為外人作保的，必受虧損；恨惡擊掌的，卻得安穩。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "恩德的婦女得尊榮；強暴的男子得資財。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "仁慈的人善待自己；殘忍的人擾害己身。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "惡人經營，得虛浮的工價；撒義種的，得實在的果效。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "恆心為義的，必得生命；追求邪惡的，必致死亡。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "心中乖僻的，為耶和華所憎惡；行事完全的，為他所喜悅。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "惡人雖然連手，必不免受罰；義人的後裔必得拯救。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "婦女美貌而無見識，如同金環帶在豬鼻上。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "義人的心願盡得好處；惡人的指望致干忿怒。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "有施散的，卻更增添；有吝惜過度的，反致窮乏。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "好施捨的，必得豐裕；滋潤人的，必得滋潤。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "屯糧不賣的，民必咒詛他；情願出賣的，人必為他祝福。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "懇切求善的，就求得恩惠；惟獨求惡的，惡必臨到他身。",
      "notes": []
    },
    {
      "verse": 28,
      "text": "倚仗自己財物的，必跌倒；義人必發旺，如青葉。",
      "notes": []
    },
    {
      "verse": 29,
      "text": "擾害己家的，必承受清風；愚昧人必作慧心人的僕人。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "義人所結的果子就是生命樹；有智慧的，必能得人。",
      "notes": []
    },
    {
      "verse": 31,
      "text": "看哪，義人在世尚且受報，何況惡人和罪人呢？",
      "notes": []
    }
  ]
}
