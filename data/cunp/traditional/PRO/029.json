{
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PRO",
  "book_name": "箴言",
  "chapter": 29,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PRO/29/",
  "verses": [
    {
      "verse": 1,
      "text": "人屢次受責罰，仍然硬著頸項；他必頃刻敗壞，無法可治。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "義人增多，民就喜樂；惡人掌權，民就歎息。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "愛慕智慧的，使父親喜樂；與妓女結交的，卻浪費錢財。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "王藉公平，使國堅定；索要賄賂，使國傾敗。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "諂媚鄰舍的，就是設網羅絆他的腳。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "惡人犯罪，自陷網羅；惟獨義人歡呼喜樂。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "義人知道查明窮人的案；惡人沒有聰明，就不得而知。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "褻慢人煽惑通城；智慧人止息眾怒。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "智慧人與愚妄人相爭，或怒或笑，總不能使他止息。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "好流人血的，恨惡完全人，索取正直人的性命。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "愚妄人怒氣全發；智慧人忍氣含怒。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "君王若聽謊言，他一切臣僕都是奸惡。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "貧窮人、強暴人在世相遇；他們的眼目都蒙耶和華光照。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "君王憑誠實判斷窮人；他的國位必永遠堅立。",
      "notes": []
    },
    {
      "verse": 15,
      "text": "杖打和責備能加增智慧；放縱的兒子使母親羞愧。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "惡人加多，過犯也加多，義人必看見他們跌倒。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "管教你的兒子，他就使你得安息，也必使你心裏喜樂。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "沒有異象，民就放肆；惟遵守律法的，便為有福。",
      "notes": [
        "或譯：默示"
      ]
    },
    {
      "verse": 19,
      "text": "只用言語，僕人不肯受管教；他雖然明白，也不留意。",
      "notes": []
    },
    {
      "verse": 20,
      "text": "你見言語急躁的人嗎？愚昧人比他更有指望。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "人將僕人從小嬌養，這僕人終久必成了他的兒子。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "好氣的人挑啟爭端；暴怒的人多多犯罪。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "人的高傲必使他卑下；心裏謙遜的，必得尊榮。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "人與盜賊分贓，是恨惡自己的性命；他聽見叫人發誓的聲音，卻不言語。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "懼怕人的，陷入網羅；惟有倚靠耶和華的，必得安穩。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "求王恩的人多；定人事乃在耶和華。",
      "notes": []
    },
    {
      "verse": 27,
      "text": "為非作歹的，被義人憎嫌；行事正直的，被惡人憎惡。",
      "notes": []
    }
  ]
}
