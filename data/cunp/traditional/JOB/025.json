{
  "translation": "cunp",
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "JOB",
  "book_name": "約伯記",
  "chapter": 25,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/JOB/25/",
  "verses": [
    {
      "verse": 1,
      "text": "書亞人比勒達回答說：",
      "notes": []
    },
    {
      "verse": 2,
      "text": "神有治理之權，有威嚴可畏；他在高處施行和平。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他的諸軍豈能數算？他的光亮一發，誰不蒙照呢？",
      "notes": []
    },
    {
      "verse": 4,
      "text": "這樣在神面前，人怎能稱義？婦人所生的怎能潔淨？",
      "notes": []
    },
    {
      "verse": 5,
      "text": "在神眼前，月亮也無光亮，星宿也不清潔。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "何況如蟲的人，如蛆的世人呢！",
      "notes": []
    }
  ]
}
