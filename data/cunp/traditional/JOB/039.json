{
  "translation": "cunp",
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "JOB",
  "book_name": "約伯記",
  "chapter": 39,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/JOB/39/",
  "verses": [
    {
      "verse": 1,
      "text": "山巖間的野山羊幾時生產，你知道嗎？母鹿下犢之期，你能察定嗎？",
      "notes": []
    },
    {
      "verse": 2,
      "text": "牠們懷胎的月數，你能數算嗎？牠們幾時生產，你能曉得嗎？",
      "notes": []
    },
    {
      "verse": 3,
      "text": "牠們屈身，將子生下，就除掉疼痛。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "這子漸漸肥壯，在荒野長大，去而不回。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "誰放野驢出去自由？誰解開快驢的繩索？",
      "notes": []
    },
    {
      "verse": 6,
      "text": "我使曠野作牠的住處，使鹹地當牠的居所。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "牠嗤笑城內的喧嚷，不聽趕牲口的喝聲。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "遍山是牠的草場；牠尋找各樣青綠之物。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "野牛豈肯服事你？豈肯住在你的槽旁？",
      "notes": []
    },
    {
      "verse": 10,
      "text": "你豈能用套繩將野牛籠在犂溝之間？牠豈肯隨你耙山谷之地？",
      "notes": []
    },
    {
      "verse": 11,
      "text": "豈可因牠的力大就倚靠牠？豈可把你的工交給牠做嗎？",
      "notes": []
    },
    {
      "verse": 12,
      "text": "豈可信靠牠把你的糧食運到家，又收聚你禾場上的穀嗎？",
      "notes": []
    },
    {
      "verse": 13,
      "text": "鴕鳥的翅膀歡然搧展，豈是顯慈愛的翎毛和羽毛嗎？",
      "notes": []
    },
    {
      "verse": 14,
      "text": "因牠把蛋留在地上，在塵土中使得溫暖；",
      "notes": []
    },
    {
      "verse": 15,
      "text": "卻想不到被腳踹碎，或被野獸踐踏。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "牠忍心待雛，似乎不是自己的；雖然徒受勞苦，也不為雛懼怕；",
      "notes": []
    },
    {
      "verse": 17,
      "text": "因為神使牠沒有智慧，也未將悟性賜給牠。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "牠幾時挺身展開翅膀，就嗤笑馬和騎馬的人。",
      "notes": []
    },
    {
      "verse": 19,
      "text": "馬的大力是你所賜的嗎？牠頸項上挓挲的騌是你給牠披上的嗎？",
      "notes": []
    },
    {
      "verse": 20,
      "text": "是你叫牠跳躍像蝗蟲嗎？牠噴氣之威使人驚惶。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "牠在谷中刨地，自喜其力；牠出去迎接佩帶兵器的人。",
      "notes": []
    },
    {
      "verse": 22,
      "text": "牠嗤笑可怕的事並不驚惶，也不因刀劍退回。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "箭袋和發亮的槍，並短槍在牠身上錚錚有聲。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "牠發猛烈的怒氣將地吞下；一聽角聲就不耐站立。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "角每發聲，牠說呵哈；牠從遠處聞著戰氣，又聽見軍長大發雷聲和兵丁吶喊。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "鷹雀飛翔，展開翅膀一直向南，豈是藉你的智慧嗎？",
      "notes": []
    },
    {
      "verse": 27,
      "text": "大鷹上騰在高處搭窩，豈是聽你的吩咐嗎？",
      "notes": []
    },
    {
      "verse": 28,
      "text": "牠住在山巖，以山峰和堅固之所為家，",
      "notes": []
    },
    {
      "verse": 29,
      "text": "從那裏窺看食物，眼睛遠遠觀望。",
      "notes": []
    },
    {
      "verse": 30,
      "text": "牠的雛也咂血；被殺的人在哪裏，牠也在那裏。",
      "notes": []
    }
  ]
}
