{
  "translation": "cunp",
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "JOB",
  "book_name": "約伯記",
  "chapter": 26,
  "heading": "",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/JOB/26/",
  "verses": [
    {
      "verse": 1,
      "text": "約伯回答說：",
      "notes": []
    },
    {
      "verse": 2,
      "text": "無能的人蒙你何等的幫助！膀臂無力的人蒙你何等的拯救！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "無智慧的人蒙你何等的指教！你向他多顯大知識！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "你向誰發出言語來？誰的靈從你而出？",
      "notes": []
    },
    {
      "verse": 5,
      "text": "在大水和水族以下的陰魂戰兢。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "在神面前，陰間顯露；滅亡也不得遮掩。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "神將北極鋪在空中，將大地懸在虛空；",
      "notes": []
    },
    {
      "verse": 8,
      "text": "將水包在密雲中，雲卻不破裂；",
      "notes": []
    },
    {
      "verse": 9,
      "text": "遮蔽他的寶座，將雲鋪在其上；",
      "notes": []
    },
    {
      "verse": 10,
      "text": "在水面的周圍劃出界限，直到光明黑暗的交界。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "天的柱子因他的斥責震動驚奇。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "他以能力攪動大海；他藉知識打傷拉哈伯，",
      "notes": [
        "或譯：平靜"
      ]
    },
    {
      "verse": 13,
      "text": "藉他的靈使天有妝飾；他的手刺殺快蛇。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "看哪，這不過是神工作的些微；我們所聽於他的是何等細微的聲音！他大能的雷聲誰能明透呢？",
      "notes": []
    }
  ]
}
