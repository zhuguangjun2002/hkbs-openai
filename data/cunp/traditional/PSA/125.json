{
  "translation": "cunp",
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 125,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PSA/125/",
  "verses": [
    {
      "verse": 1,
      "text": "倚靠耶和華的人好像錫安山，永不動搖。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "眾山怎樣圍繞耶路撒冷，耶和華也照樣圍繞他的百姓，從今時直到永遠。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "惡人的杖不常落在義人的分上，免得義人伸手作惡。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和華啊，求你善待那些為善和心裏正直的人。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "至於那偏行彎曲道路的人，耶和華必使他和作惡的人一同出去受刑。願平安歸於以色列！",
      "notes": []
    }
  ]
}
