{
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 67,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PSA/67/",
  "verses": [
    {
      "verse": 1,
      "text": "願神憐憫我們，賜福與我們，用臉光照我們，（細拉）",
      "notes": []
    },
    {
      "verse": 2,
      "text": "好叫世界得知你的道路，萬國得知你的救恩。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "神啊，願列邦稱讚你！願萬民都稱讚你！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "願萬國都快樂歡呼；因為你必按公正審判萬民，引導世上的萬國。（細拉）",
      "notes": []
    },
    {
      "verse": 5,
      "text": "神啊，願列邦稱讚你！願萬民都稱讚你！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "地已經出了土產；神－就是我們的神要賜福與我們。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "神要賜福與我們；地的四極都要敬畏他！",
      "notes": []
    }
  ]
}
