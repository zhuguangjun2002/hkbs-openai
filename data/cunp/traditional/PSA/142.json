{
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 142,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PSA/142/",
  "verses": [
    {
      "verse": 1,
      "text": "我發聲哀告耶和華，發聲懇求耶和華。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "我在他面前吐露我的苦情，陳說我的患難。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "我的靈在我裏面發昏的時候，你知道我的道路。在我行的路上，敵人為我暗設網羅。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "求你向我右邊觀看，因為沒有人認識我；我無處避難，也沒有人眷顧我。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "耶和華啊，我曾向你哀求。我說：你是我的避難所；在活人之地，你是我的福分。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "求你側耳聽我的呼求，因我落到極卑之地；求你救我脫離逼迫我的人，因為他們比我強盛。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "求你領我出離被囚之地，我好稱讚你的名。義人必環繞我，因為你是用厚恩待我。",
      "notes": []
    }
  ]
}
