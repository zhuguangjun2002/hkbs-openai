{
  "translation": "cunp",
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 112,
  "heading": "義人之福",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PSA/112/",
  "verses": [
    {
      "verse": 1,
      "text": "你們要讚美耶和華！敬畏耶和華，甚喜愛他命令的，這人便為有福！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "他的後裔在世必強盛；正直人的後代必要蒙福。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他家中有貨物，有錢財；他的公義存到永遠。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "正直人在黑暗中，有光向他發現；他有恩惠，有憐憫，有公義。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "施恩與人、借貸與人的，這人事情順利；他被審判的時候要訴明自己的冤。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他永不動搖；義人被記念，直到永遠。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "他必不怕凶惡的信息；他心堅定，倚靠耶和華。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他心確定，總不懼怕，直到他看見敵人遭報。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他施捨錢財，賙濟貧窮；他的仁義存到永遠。他的角必被高舉，大有榮耀。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "惡人看見便惱恨，必咬牙而消化；惡人的心願要歸滅絕。",
      "notes": []
    }
  ]
}
