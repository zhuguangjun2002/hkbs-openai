{
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 149,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PSA/149/",
  "verses": [
    {
      "verse": 1,
      "text": "你們要讚美耶和華！向耶和華唱新歌，在聖民的會中讚美他！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "願以色列因造他的主歡喜！願錫安的民因他們的王快樂！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "願他們跳舞讚美他的名，擊鼓彈琴歌頌他！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "因為耶和華喜愛他的百姓；他要用救恩當作謙卑人的妝飾。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "願聖民因所得的榮耀高興！願他們在床上歡呼！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "願他們口中稱讚神為高，手裏有兩刃的刀，",
      "notes": []
    },
    {
      "verse": 7,
      "text": "為要報復列邦，刑罰萬民。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "要用鍊子捆他們的君王，用鐵鐐鎖他們的大臣；",
      "notes": []
    },
    {
      "verse": 9,
      "text": "要在他們身上施行所記錄的審判。他的聖民都有這榮耀。你們要讚美耶和華！",
      "notes": []
    }
  ]
}
