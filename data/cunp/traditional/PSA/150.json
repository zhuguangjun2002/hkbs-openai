{
  "translation": "cunp",
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 150,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PSA/150/",
  "verses": [
    {
      "verse": 1,
      "text": "你們要讚美耶和華！在神的聖所讚美他！在他顯能力的穹蒼讚美他！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "要因他大能的作為讚美他，按著他極美的大德讚美他！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "要用角聲讚美他，鼓瑟彈琴讚美他！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "擊鼓跳舞讚美他！用絲弦的樂器和簫的聲音讚美他！",
      "notes": []
    },
    {
      "verse": 5,
      "text": "用大響的鈸讚美他！用高聲的鈸讚美他！",
      "notes": []
    },
    {
      "verse": 6,
      "text": "凡有氣息的都要讚美耶和華！你們要讚美耶和華！",
      "notes": []
    }
  ]
}
