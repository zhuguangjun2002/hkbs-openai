{
  "translation": "cunp",
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 136,
  "heading": "感恩的聖詩",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PSA/136/",
  "verses": [
    {
      "verse": 1,
      "text": "你們要稱謝耶和華，因他本為善；他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "你們要稱謝萬神之神，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "你們要稱謝萬主之主，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "稱謝那獨行大奇事的，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "稱謝那用智慧造天的，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "稱謝那鋪地在水以上的，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "稱謝那造成大光的，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他造日頭管白晝，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 9,
      "text": "他造月亮星宿管黑夜，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 10,
      "text": "稱謝那擊殺埃及人之長子的，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 11,
      "text": "他領以色列人從他們中間出來，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 12,
      "text": "他施展大能的手和伸出來的膀臂，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 13,
      "text": "稱謝那分裂紅海的，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 14,
      "text": "他領以色列從其中經過，因他的慈愛永遠長存；",
      "notes": []
    },
    {
      "verse": 15,
      "text": "卻把法老和他的軍兵推翻在紅海裏，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 16,
      "text": "稱謝那引導自己的民行走曠野的，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 17,
      "text": "稱謝那擊殺大君王的，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 18,
      "text": "他殺戮有名的君王，因他的慈愛永遠長存；",
      "notes": []
    },
    {
      "verse": 19,
      "text": "就是殺戮亞摩利王西宏，因他的慈愛永遠長存；",
      "notes": []
    },
    {
      "verse": 20,
      "text": "又殺巴珊王噩，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 21,
      "text": "他將他們的地賜他的百姓為業，因他的慈愛永遠長存；",
      "notes": []
    },
    {
      "verse": 22,
      "text": "就是賜他的僕人以色列為業，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 23,
      "text": "他顧念我們在卑微的地步，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 24,
      "text": "他救拔我們脫離敵人，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 25,
      "text": "他賜糧食給凡有血氣的，因他的慈愛永遠長存。",
      "notes": []
    },
    {
      "verse": 26,
      "text": "你們要稱謝天上的神，因他的慈愛永遠長存。",
      "notes": []
    }
  ]
}
