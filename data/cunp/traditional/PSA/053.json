{
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 53,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PSA/53/",
  "verses": [
    {
      "verse": 1,
      "text": "愚頑人心裏說：沒有神。他們都是邪惡，行了可憎惡的罪孽；沒有一個人行善。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "神從天上垂看世人，要看有明白的沒有？有尋求他的沒有？",
      "notes": []
    },
    {
      "verse": 3,
      "text": "他們各人都退後，一同變為污穢；並沒有行善的，連一個也沒有。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "作孽的沒有知識嗎？他們吞吃我的百姓如同吃飯一樣，並不求告神。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "他們在無可懼怕之處就大大害怕，因為神把那安營攻擊你之人的骨頭散開了。你使他們蒙羞，因為神棄絕了他們。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "但願以色列的救恩從錫安而出。神救回他被擄的子民那時，雅各要快樂，以色列要歡喜。",
      "notes": []
    }
  ]
}
