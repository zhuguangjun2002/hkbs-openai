{
  "translation": "cunp",
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 100,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PSA/100/",
  "verses": [
    {
      "verse": 1,
      "text": "普天下當向耶和華歡呼！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "你們當樂意事奉耶和華，當來向他歌唱！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "你們當曉得耶和華是神！我們是他造的，也是屬他的；我們是他的民，也是他草場的羊。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "當稱謝進入他的門；當讚美進入他的院。當感謝他，稱頌他的名！",
      "notes": []
    },
    {
      "verse": 5,
      "text": "因為耶和華本為善。他的慈愛存到永遠；他的信實直到萬代。",
      "notes": []
    }
  ]
}
