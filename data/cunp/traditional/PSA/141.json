{
  "translation": "cunp",
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 141,
  "heading": "晚 禱",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PSA/141/",
  "verses": [
    {
      "verse": 1,
      "text": "耶和華啊，我曾求告你，求你快快臨到我這裏！我求告你的時候，願你留心聽我的聲音！",
      "notes": []
    },
    {
      "verse": 2,
      "text": "願我的禱告如香陳列在你面前！願我舉手祈求，如獻晚祭！",
      "notes": []
    },
    {
      "verse": 3,
      "text": "耶和華啊，求你禁止我的口，把守我的嘴！",
      "notes": []
    },
    {
      "verse": 4,
      "text": "求你不叫我的心偏向邪惡，以致我和作孽的人同行惡事；也不叫我吃他們的美食。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "任憑義人擊打我，這算為仁慈；任憑他責備我，這算為頭上的膏油；我的頭不要躲閃。正在他們行惡的時候，我仍要祈禱。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他們的審判官被扔在巖下；眾人要聽我的話，因為這話甘甜。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "我們的骨頭散在墓旁，好像人耕田、刨地的土塊。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "主－耶和華啊，我的眼目仰望你；我投靠你，求你不要將我撇得孤苦！",
      "notes": []
    },
    {
      "verse": 9,
      "text": "求你保護我脫離惡人為我設的網羅和作孽之人的圈套！",
      "notes": []
    },
    {
      "verse": 10,
      "text": "願惡人落在自己的網裏，我卻得以逃脫。",
      "notes": []
    }
  ]
}
