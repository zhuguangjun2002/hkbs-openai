{
  "translation": "cunp",
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 114,
  "heading": "聆聽",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PSA/114/",
  "verses": [
    {
      "verse": 1,
      "text": "以色列出了埃及，雅各家離開說異言之民；",
      "notes": []
    },
    {
      "verse": 2,
      "text": "那時，猶大為主的聖所，以色列為他所治理的國度。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "滄海看見就奔逃；約旦河也倒流。",
      "notes": []
    },
    {
      "verse": 4,
      "text": "大山踴躍，如公羊；小山跳舞，如羊羔。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "滄海啊，你為何奔逃？約旦哪，你為何倒流？",
      "notes": []
    },
    {
      "verse": 6,
      "text": "大山哪，你為何踴躍，如公羊？小山哪，你為何跳舞，如羊羔？",
      "notes": []
    },
    {
      "verse": 7,
      "text": "大地啊，你因見主的面，就是雅各神的面，便要震動。",
      "notes": []
    },
    {
      "verse": 8,
      "text": "他叫磐石變為水池，叫堅石變為泉源。",
      "notes": []
    }
  ]
}
