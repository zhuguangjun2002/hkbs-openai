{
  "translation": "cunp",
  "version": "CUNP1",
  "version_name": "新標點和合本(神)",
  "script": "traditional",
  "book_code": "PSA",
  "book_name": "詩篇",
  "chapter": 11,
  "heading": "在主裏得安穩",
  "source_url": "https://rcuv.hkbs.org.hk/CUNP1/PSA/11/",
  "verses": [
    {
      "verse": 1,
      "text": "我是投靠耶和華；你們怎麼對我說：你當像鳥飛往你的山去。",
      "notes": []
    },
    {
      "verse": 2,
      "text": "看哪，惡人彎弓，把箭搭在弦上，要在暗中射那心裏正直的人。",
      "notes": []
    },
    {
      "verse": 3,
      "text": "根基若毀壞，義人還能做甚麼呢？",
      "notes": []
    },
    {
      "verse": 4,
      "text": "耶和華在他的聖殿裏；耶和華的寶座在天上；他的慧眼察看世人。",
      "notes": []
    },
    {
      "verse": 5,
      "text": "耶和華試驗義人；惟有惡人和喜愛強暴的人，他心裏恨惡。",
      "notes": []
    },
    {
      "verse": 6,
      "text": "他要向惡人密布網羅；有烈火、硫磺、熱風，作他們杯中的分。",
      "notes": []
    },
    {
      "verse": 7,
      "text": "因為耶和華是公義的，他喜愛公義；正直人必得見他的面。",
      "notes": []
    }
  ]
}
